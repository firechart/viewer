# The environment of FireChart Viewer in Docker: copy to .env next to docker-compose.yml. Nothing secret belongs here; everything has a default.

# The image to run: a published version (ghcr.io/firechart/viewer:X.Y.Z); without it docker compose up --build builds these sources
# VIEWER_IMAGE=ghcr.io/firechart/viewer:X.Y.Z

# The address and the port on the host: 127.0.0.1 when a reverse proxy on the same host gives https (SMART needs it), 0.0.0.0 for everybody
# VIEWER_BIND=127.0.0.1
# VIEWER_PORT=8080

# The log of the container kept by Docker
# VIEWER_LOG_MAX_SIZE=20m
# VIEWER_LOG_MAX_FILE=5
