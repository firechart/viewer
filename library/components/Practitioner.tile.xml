<!-- A practitioner in a list: the name, the first qualification; the gender and inactive at the end -->
<Component name="Practitioner.tile">
  <Param name="record" required="true"/>

  <Tile title="{{iif(%record.name.exists(), %record.name.first(), %record.id)}}">
    <Leading icon="person"/>
    <Subtitle>
      <Parts separator=" - ">
        <Value value="{{%record.qualification.first().code}}"/>
        <Value value="{{%record.identifier.value.first()}}"/>
      </Parts>
    </Subtitle>
    <Trailing>
      <Badge text="{{%record.gender}}"/>
      <If test="{{%record.active = false}}">
        <Badge text="{{%strings.InactiveBadge}}" tone="danger"/>
      </If>
    </Trailing>
  </Tile>
</Component>
