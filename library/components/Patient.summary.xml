<!-- The summary of a patient: the sections of the International Patient Summary (IPS) and the encounters of the patient, newest first. Each section
     is a Feed: its searches about the patient, a page at a time, each record drawn by the tile of its type -->
<Component name="Patient.summary">
  <Show value="{{%context}}" mode="banner"/>

  <Feed code="medications" title="{{%strings.MedicationSummary}}">
    <Query type="MedicationStatement" sort="-effective"/>
    <Query type="MedicationRequest" sort="-authoredon"/>
  </Feed>

  <Feed code="allergies" title="{{%strings.AllergiesAndIntolerances}}">
    <Query type="AllergyIntolerance" sort="-date"/>
  </Feed>

  <Feed code="problems" title="{{%strings.ProblemList}}"
        codes="http://hl7.org/fhir/sid/icd-10 http://hl7.org/fhir/sid/icd-10-cm http://id.who.int/icd/release/11/mms http://hl7.org/fhir/sid/icd-9-cm">
    <Query type="Condition" params="clinical-status=active,recurrence,relapse" sort="-recorded-date"/>
  </Feed>

  <Feed code="immunizations" title="{{%strings.Immunizations}}" hideIfEmpty="true">
    <Query type="Immunization" sort="-date"/>
  </Feed>

  <Feed code="procedures" title="{{%strings.HistoryOfProcedures}}" hideIfEmpty="true">
    <Query type="Procedure" sort="-date"/>
  </Feed>

  <Feed code="devices" title="{{%strings.MedicalDevices}}" hideIfEmpty="true">
    <Query type="DeviceUseStatement"/>
  </Feed>

  <Feed code="results" title="{{%strings.DiagnosticResults}}" hideIfEmpty="true" display="lab-results" decimals="2">
    <Query type="Observation" params="category=laboratory,imaging" sort="-date"/>
    <Query type="DiagnosticReport" sort="-date"/>
  </Feed>

  <Feed code="vital-signs" title="{{%strings.VitalSigns}}" hideIfEmpty="true" display="observation-trends" decimals="2">
    <Query type="Observation" params="category=vital-signs" sort="-date"/>
  </Feed>

  <Feed code="past-illness" title="{{%strings.HistoryOfPastIllness}}" collapsed="true" hideIfEmpty="true">
    <Query type="Condition" params="clinical-status=inactive,remission,resolved" sort="-recorded-date"/>
  </Feed>

  <Feed code="pregnancy" title="{{%strings.HistoryOfPregnancy}}" collapsed="true" hideIfEmpty="true">
    <Query type="Observation" sort="-date"
           params="code=http://loinc.org|82810-3,http://loinc.org|11778-8,http://loinc.org|11779-6,http://loinc.org|11780-4,http://loinc.org|11636-8,http://loinc.org|11637-6,http://loinc.org|11638-4,http://loinc.org|11639-2,http://loinc.org|11640-0,http://loinc.org|11612-9,http://loinc.org|11613-7,http://loinc.org|11614-5,http://loinc.org|33065-4"/>
  </Feed>

  <Feed code="social-history" title="{{%strings.SocialHistory}}" collapsed="true" hideIfEmpty="true">
    <Query type="Observation" params="category=social-history" sort="-date"/>
  </Feed>

  <Feed code="plan-of-care" title="{{%strings.PlanOfCare}}" collapsed="true" hideIfEmpty="true">
    <Query type="CarePlan" sort="-date"/>
  </Feed>

  <Feed code="advance-directives" title="{{%strings.AdvanceDirectives}}" collapsed="true" hideIfEmpty="true">
    <Query type="Consent" params="scope=adr" sort="-date"/>
  </Feed>

  <Feed code="encounters" title="{{%strings.Encounters}}" collapsed="true" hideIfEmpty="true">
    <Query type="Encounter" sort="-date"/>
  </Feed>
</Component>
