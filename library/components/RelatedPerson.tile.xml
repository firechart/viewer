<!-- A related person in a list: the name, the relationship; the gender and inactive at the end -->
<Component name="RelatedPerson.tile">
  <Param name="record" required="true"/>

  <Tile title="{{iif(%record.name.exists(), %record.name.first(), %record.id)}}" subtitle="{{%record.relationship.first()}}" patient="{{%record.patient}}">
    <Leading icon="person"/>
    <Trailing>
      <Badge text="{{%record.gender}}"/>
      <If test="{{%record.active = false}}">
        <Badge text="{{%strings.InactiveBadge}}" tone="danger"/>
      </If>
    </Trailing>
  </Tile>
</Component>
