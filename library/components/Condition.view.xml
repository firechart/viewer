<!-- The page of a condition: what, its onset and statuses, then the details, the evidence and the notes -->
<Component name="Condition.view">
  <Param name="record" required="true"/>

  <Section title="{{%record.code}}">
    <Field label="{{%strings.Onset}}" value="{{%record.onset}}"/>
    <Field label="{{%strings.Recorded}}" value="{{%record.recordedDate}}"/>
    <Field label="{{%strings.Status}}">
      <Status value="{{%record.clinicalStatus}}"/>
      <Status value="{{%record.verificationStatus}}"/>
      <Status value="{{%record.severity}}"/>
    </Field>
  </Section>

  <If test="{{%record.category.exists() or %record.bodySite.exists() or %record.abatement.exists() or %record.recorder.exists() or %record.asserter.exists() or %record.stage.exists()}}">
    <Section title="{{%strings.Details}}">
      <Field label="{{%strings.Category}}">
        <Value value="{{%record.category}}" separator=", "/>
      </Field>
      <Field label="{{%strings.BodySite}}">
        <Value value="{{%record.bodySite}}" separator=", "/>
      </Field>
      <Field label="{{%strings.Abatement}}" value="{{%record.abatement}}"/>
      <Field label="{{%strings.RecordedBy}}">
        <Link value="{{%record.recorder}}"/>
      </Field>
      <Field label="{{%strings.AssertedBy}}">
        <Link value="{{%record.asserter}}"/>
      </Field>
      <Repeat each="{{%record.stage}}" as="stage">
        <Field label="{{%strings.Stage}}" value="{{%stage.summary}}"/>
      </Repeat>
    </Section>
  </If>

  <If test="{{%record.evidence.exists()}}">
    <Section title="{{%strings.Evidence}}" count="{{%record.evidence.count()}}">
      <Repeat each="{{%record.evidence}}" as="evidence">
        <Row>
          <Main>
            <Parts separator=", ">
              <Value value="{{%evidence.code}}"/>
              <Value value="{{%evidence.concept}}"/>
              <Link value="{{%evidence.reference}}"/>
            </Parts>
          </Main>
          <Link value="{{%evidence.detail}}"/>
        </Row>
      </Repeat>
    </Section>
  </If>

  <If test="{{%record.note.exists()}}">
    <Section title="{{%strings.Notes}}" count="{{%record.note.count()}}">
      <Repeat each="{{%record.note}}" as="note">
        <Row main="{{%note.text}}"/>
      </Repeat>
    </Section>
  </If>
</Component>
