<!-- A diagnostic report in a list: what, its category and when it happened (else issued); its status at the end -->
<Component name="DiagnosticReport.tile">
  <Param name="record" required="true"/>

  <Tile title="{{iif(%record.code.exists(), %record.code, %record.id)}}" patient="{{%record.subject}}" encounter="{{%record.encounter}}">
    <Subtitle>
      <Parts separator=" - ">
        <Value value="{{%record.category.first()}}"/>
        <Value value="{{iif(%record.effective.exists(), %record.effective, %record.issued)}}"/>
      </Parts>
    </Subtitle>
    <Trailing>
      <Status value="{{%record.status}}"/>
    </Trailing>
  </Tile>
</Component>
