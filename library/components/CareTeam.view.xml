<!-- The page of a care team: its name, period and status, then the members and the details -->
<Component name="CareTeam.view">
  <Param name="record" required="true"/>

  <Section title="{{iif(%record.name.exists(), %record.name, %record.id)}}">
    <Field label="{{%strings.Period}}" value="{{%record.period}}"/>
    <Field label="{{%strings.Status}}">
      <Status value="{{%record.status}}"/>
    </Field>
  </Section>

  <If test="{{%record.participant.exists()}}">
    <Section title="{{%strings.Members}}">
      <Repeat each="{{%record.participant}}" as="participant">
        <Row>
          <Main><Link value="{{%participant.member}}"/></Main>
          <Value value="{{%participant.role}}"/>
        </Row>
      </Repeat>
    </Section>
  </If>

  <If test="{{%record.category.exists() or %record.managingOrganization.exists()}}">
    <Section title="{{%strings.Details}}">
      <Field label="{{%strings.Category}}">
        <Value value="{{%record.category}}" separator=", "/>
      </Field>
      <Field label="{{%strings.ManagingOrganization}}">
        <Link value="{{%record.managingOrganization}}"/>
      </Field>
    </Section>
  </If>
</Component>
