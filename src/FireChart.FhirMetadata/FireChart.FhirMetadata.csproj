<Project Sdk="Microsoft.NET.Sdk">

    <!-- Writes the metadata of the core FHIR releases into FireChart.Viewer.Core (Fhir/Metadata/*.g.cs) from the JSON files of the core packages (the cache
         of the Firely SDK, downloaded from packages.fhir.org when missing). dotnet run - -project src/FireChart.FhirMetadata -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>FireChart.Tools.FhirMetadata</RootNamespace>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FireChart.Viewer.Tests"/>
    </ItemGroup>

</Project>
