@* The clinical summary of a patient: the banner, then the sections of the form of the server, a stack in one scroller: each section is its shell
   (SectionShell: the sticky header, the loading, the failure, the next page) around the records its component draws (tiles so far) *@
@inherits StatefulWidget<ClinicalSummaryViewState>

@if (State.Sections.Any(section => !section.Hidden))
{
    <PageMenu SectionName=@FhirViewer.PageMenuSection>
        @foreach (var section in State.Sections.Where(section => !section.Hidden))
        {
            <PageMenuItem Text=@section.Title Note=@(section.IsLoaded ? section.CountText : null) OnClick=@(() => GoToAsync(section))>
                <Leading><IconResource ResourceType=@section.IconType Autocolor/></Leading>
            </PageMenuItem>
        }
        <PageMenuSeparator/>
        <PageMenuItem Icon="unfold_more" Text=@FloxStrings.Caption_ExpandAll OnClick=@(() => State.SetCollapsed(false))/>
        <PageMenuItem Icon="unfold_less" Text=@FloxStrings.Caption_CollapseAll OnClick=@(() => State.SetCollapsed(true))/>
    </PageMenu>
}

<BusyOverlay Busy=@State.IsBusy Concealed=@State.Activating>
    @if (State.NotFound)
    {
        <NotFoundWidget/>
    }
    else if (State.Server is not null)
    {
        @if (State.Access == ServerAccess.NotSupported)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false" class="rz-mt-4">
                @Strings.Message_FhirServerAuthenticationNotSupported
            </RadzenAlert>
        }
        else if (State.Access is ServerAccess.NeedsAuthorization or ServerAccess.NeedsCredentials)
        {
            <ServerAccessPanel Server=@State.Server Access=@State.Access Rejected=@State.CredentialsRejected OnRetry=@State.RetryAsync/>
        }
        else if (State.Failed)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false" class="rz-mt-4">
                @Strings.Message_FhirServerUnavailable
                <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Text=@FloxStrings.Caption_Retry Click=@State.RetryAsync/>
            </RadzenAlert>
        }
        else if (State.Banner is not null)
        {
            <style>@State.Style</style>
            @* The HTML of the templates has passed the white list of FxHtml *@
            <div class="fx-root fx-summary">
                <SectionContent SectionName=@FhirViewer.PageCommandsSection>
                    <BookmarkStar Route=@(new ViewerRoute(ViewerPage.ClinicalSummary, "Patient", PatientId)) Title=@BannerTitleAsync Category=@Strings.Caption_ClinicalSummary Icon="history"/>
                </SectionContent>
                <div class="fx-summary-patient">
                    @((MarkupString)State.Banner)
                    <p class="fx-muted fx-summary-zone" title="Times are shown in the time zone of this device">@DisplayZone.Text()</p>
                </div>

                <div class="fx-summary-list">
                    <SummaryStack @ref=_stack Memory=@Scroll>
                        @foreach (var section in State.Sections.Where(section => !section.Hidden))
                        {
                            <SectionShell @key=section Section=@section OnToggle=@(() => State.Toggle(section)) OnMore=@(() => State.LoadMoreAsync(section))>
                                @if (section.Component == FireChart.Viewer.Core.Forms.SummaryComponents.LabResults)
                                {
                                    <LabResultsView Section=@section OnOpen=@State.Open/>
                                }
                                else if (section.Component == FireChart.Viewer.Core.Forms.SummaryComponents.ObservationTrends)
                                {
                                    <ObservationTrendsView Section=@section OnOpen=@State.Open OnSelect=@(key => State.SelectTrendAsync(section, key))/>
                                }
                                else
                                {
                                    @TilesOf(section)
                                }
                            </SectionShell>
                        }
                    </SummaryStack>
                </div>
            </div>
        }
    }
</BusyOverlay>

@code {

    private SummaryStack? _stack;

    // The menu of the page: the block is opened, the stack brings it to the top after it has drawn its records
    private async Task GoToAsync(ClinicalSummarySection section)
    {
        State.OpenSection(section);
        if (_stack is not null)
        {
            await Task.Yield();
            await _stack.ScrollToAsync(section.ElementId);
        }
    }

    // The component tiles: a row per record, the frame Tile lays out the slots the template of its type filled
    private RenderFragment TilesOf(ClinicalSummarySection section)
    {
        return @<text>
                   @foreach (var item in section.Items)
                   {
                       var tile = section.Tiles.GetValueOrDefault(ClinicalSummarySection.KeyOf(item)) ?? ResourceTiles.Plain(item);
                       <div class="fx-summary-section-row" @key=item>
                           <Tile Model=@tile ResourceType=@item.ResourceType OnClick=@(() => State.Open(item))/>
                       </div>
                   }
               </text>;
    }

    /// <summary>The instance of the Viewer.</summary>
    [CascadingParameter]
    public ViewerSession Session { get; set; } = null!;

    /// <summary>The id of the patient.</summary>
    [Parameter, EditorRequired]
    public string PatientId { get; set; } = string.Empty;


    protected override object? ActivationKey => new ClinicalSummaryKey(Session, PatientId);

    private Task<string?> BannerTitleAsync()
    {
        return Task.FromResult(ViewerText.Plain(State.Banner));
    }

}
