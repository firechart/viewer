@* The resources of a type as tiles, with the search of the address; also the list of the patients that leads to the clinical summary *@
@inherits StatefulWidget<ResourceListViewState>

<BusyOverlay Busy=@State.IsBusy Concealed=@State.Activating>
    @if (State.Server is not null)
    {
        @if (State.Access == ServerAccess.NotSupported)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false" class="rz-mt-4">
                @Strings.Message_FhirServerAuthenticationNotSupported
            </RadzenAlert>
        }
        else if (State.Access is ServerAccess.NeedsAuthorization or ServerAccess.NeedsCredentials)
        {
            <ServerAccessPanel Server=@State.Server Access=@State.Access Rejected=@State.CredentialsRejected OnRetry=@State.RetryAsync/>
        }
        else if (State.InvalidSearch)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false" class="rz-mt-4">
                @Strings.Message_InvalidSearch
            </RadzenAlert>
        }
        else if (State.Failed)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false" class="rz-mt-4">
                @Strings.Message_FhirServerUnavailable
                <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Text=@FloxStrings.Caption_Retry Click=@State.RetryAsync/>
            </RadzenAlert>
        }
        else
        {
            <RadzenStack Gap="var(--gap-sm)">
                @if (State.ActiveFilters.Count > 0)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="var(--gap-sm)">
                        @foreach (var filter in State.ActiveFilters)
                        {
                            <RadzenChip Size="ChipSize.Small" Text=@($"{filter.Caption}: {filter.Text}") RemoveChipTitle=@FloxStrings.Caption_Delete Close=@(() => State.RemoveFilter(filter))/>
                        }
                    </RadzenStack>
                }

                <style>@State.Style</style>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="var(--gap-sm)">
                    @* Only the links of the Bundle: FHIR has no page numbers, and Last is missing on many servers *@
                    @if (State.Page?.Total is { } total)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Span" class="rz-m-0">@string.Format(System.Globalization.CultureInfo.CurrentCulture, FloxStrings.Caption_TotalCount, total.ToString("N0", System.Globalization.CultureInfo.CurrentCulture))</RadzenText>
                    }
                    else
                    {
                        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Text=@FloxStrings.Caption_ShowTotal IsBusy=@State.Counting Click=@State.ShowTotalAsync/>
                    }
                    @if (State.CanFilter)
                    {
                        <FilterButton Count=@State.FilterCount OnClick=@FilterCallback/>
                    }
                </RadzenStack>

                <div class="fx-root fx-summary">
                    <div class="fx-summary-list">
                        <SummaryList TRow="ListRow" Rows=@State.Rows Memory=@Scroll>
                            <Row Context="row">@RowOf(row)</Row>
                        </SummaryList>
                    </div>
                </div>
            </RadzenStack>
        }
    }
</BusyOverlay>

@code {

    /// <summary>The instance of the Viewer.</summary>
    [CascadingParameter]
    public ViewerSession Session { get; set; } = null!;

    /// <summary>The type of the list (<c>Patient</c> for the list of the clinical summary).</summary>
    [Parameter, EditorRequired]
    public string ResourceType { get; set; } = string.Empty;

    /// <summary>The search: the query of the address, without the question mark.</summary>
    [Parameter]
    public string Query { get; set; } = string.Empty;

    /// <summary>The list of the patients that leads to the clinical summary of the one that is chosen.</summary>
    [Parameter]
    public bool ClinicalSummary { get; set; }


    // The search of the list is in the address: a change of it (the form, the back button, a link) loads the list again
    protected override object? ActivationKey => new ResourceListKey(Session, ResourceType, Query, ClinicalSummary);

    // The filter button is there when the type has a search form
    private EventCallback FilterCallback => State.CanFilter ? EventCallback.Factory.Create(this, State.OpenFilterAsync) : default;

    private RenderFragment RowOf(ListRow row)
    {
        return row.Kind switch
        {
            ListRowKind.Card => @<div class="fx-summary-row" @onclick=@(() => Open(row.Item!)) title=@row.Tile!.Text>
                                    <div class="fx-summary-icon"><IconResource ResourceType=@row.Item!.ResourceType/></div>
                                    <ul class="fx-list fx-summary-tile">@((MarkupString)row.Tile!.Html)</ul>
                                </div>,
            ListRowKind.Empty => @<div class="fx-summary-note">@FloxStrings.List_NoData</div>,
            _ => @<div class="fx-summary-note">
                     <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Text=@FloxStrings.Caption_More
                                   IsBusy=@State.LoadingMore Click=@State.LoadMoreAsync/>
                 </div>
        };
    }

    private void Open(ResourceSummary row)
    {
        Session.Navigate(ClinicalSummary
                             ? new ViewerRoute(ViewerPage.ClinicalSummary, "Patient", row.Id)
                             : new ViewerRoute(ViewerPage.Resource, row.ResourceType, row.Id));
    }

}
