@using System.Globalization
@using Microsoft.Extensions.DependencyInjection
@using FireChart.Viewer.Core.Fhir
@using FireChart.Viewer.Core.Search
@implements IDisposable
@inject IServiceProvider Services

@* One field of the form: its control with the label floating in its frame (a range is two frames, from and to; a comparator, a modifier, a unit and
   the type of a reference stand beside the frame), the hint under it on one line, cut with an ellipsis, its whole text the title of the field *@
<div class="search-field" title=@Hint>
    @switch (Field.Control)
    {
        case SearchFieldControl.Number:
            <FormField Text=@Caption For=@Id>
                <div class="flex items-center gap-2">
                    @ComparatorPicker
                    <BbInput Id=@Id Type="InputType.Number" Value=@NumberText(Value.Number) ValueChanged=@(v => Value.Number = ParseNumber(v)) Placeholder=@Placeholder Class="h-8"/>
                </div>
            </FormField>
            break;
        case SearchFieldControl.NumberRange:
            <div class="grid grid-cols-2 gap-2">
                <FormField Text=@From For=@Id>
                    <BbInput Id=@Id Type="InputType.Number" Value=@NumberText(Value.Number) ValueChanged=@(v => Value.Number = ParseNumber(v)) Placeholder=@Placeholder Class="h-8"/>
                </FormField>
                <FormField Text=@Strings.Caption_RangeTo For=@($"{Id}-to")>
                    <BbInput Id=@($"{Id}-to") Type="InputType.Number" Value=@NumberText(Value.NumberTo) ValueChanged=@(v => Value.NumberTo = ParseNumber(v)) Class="h-8"/>
                </FormField>
            </div>
            break;
        case SearchFieldControl.Date:
            <FormField Text=@Caption>
                <div class="flex items-center gap-2">
                    @ComparatorPicker
                    <BbDatePicker @bind-Value=Value.Date DateFormat=@SearchFhirFormat.DateFormat Placeholder=@(Placeholder ?? string.Empty) AriaLabel=@Caption Editable="true" Class="w-full"/>
                </div>
            </FormField>
            break;
        case SearchFieldControl.DateRange:
            <div class="grid grid-cols-2 gap-2">
                <FormField Text=@From>
                    <BbDatePicker @bind-Value=Value.Date DateFormat=@SearchFhirFormat.DateFormat Placeholder=@(Placeholder ?? string.Empty) AriaLabel=@From Editable="true" Class="w-full"/>
                </FormField>
                <FormField Text=@Strings.Caption_RangeTo>
                    <BbDatePicker @bind-Value=Value.DateTo DateFormat=@SearchFhirFormat.DateFormat AriaLabel=@Strings.Caption_RangeTo Editable="true" Class="w-full"/>
                </FormField>
            </div>
            break;
        case SearchFieldControl.Boolean:
            <FormField Text=@Caption>
                <BbSelect TValue="string" Options=@Options(_booleans) @bind-Value=Value.Text AriaLabel=@Caption/>
            </FormField>
            break;
        case SearchFieldControl.Select or SearchFieldControl.MultiSelect or SearchFieldControl.Autocomplete when _expanding:
            <FormField Text=@Caption>
                <BbSelect TValue="string" Options=@Options([]) Disabled="true" Placeholder=@Placeholder AriaLabel=@Caption/>
            </FormField>
            break;
        case SearchFieldControl.Select when _expansion is not null && !Field.AllowFreeText:
            <FormField Text=@Caption>
                <BbCombobox TValue="string" Options=@ShownOptions SearchQueryChanged=@LoadOptions Placeholder=@Placeholder SearchPlaceholder=@Caption MatchTriggerWidth="true"
                            Value=@Value.Selected.FirstOrDefault() ValueChanged=@(v => { Value.Selected.Clear(); Value.Selected.AddRange(v is null ? [] : [v]); }) AriaLabel=@Caption
                            Class="w-full"/>
            </FormField>
            break;
        case SearchFieldControl.MultiSelect when _expansion is not null:
            <FormField Text=@Caption>
                <BbMultiSelect TValue="string" Options=@ShownOptions SearchQueryChanged=@LoadOptions Placeholder=@Placeholder SearchPlaceholder=@Caption MatchTriggerWidth="true"
                               Values=@Value.Selected ValuesChanged=@(v => { Value.Selected.Clear(); Value.Selected.AddRange(v?.ToList() ?? []); }) AriaLabel=@Caption
                               Class="w-full"/>
            </FormField>
            break;
        case SearchFieldControl.Select or SearchFieldControl.Autocomplete when _expansion is not null:
            @* A code may be typed: the box holds the code, the list of the browser shows what the codes mean; the value set is searched as it is typed *@
            <FormField Text=@Caption For=@Id>
                <BbInput Id=@Id Value=@Value.Text ValueChanged=@(async v => { Value.Text = v; await LoadOptions(v); }) UpdateTiming="UpdateTiming.Debounced" DebounceInterval="300"
                         Placeholder=@Placeholder list=@($"{Id}-codes") Class="h-8"/>
                <datalist id=@($"{Id}-codes")>
                    @foreach (var option in _shown)
                    {
                        <option value=@option.Code>@option.Caption</option>
                    }
                </datalist>
            </FormField>
            break;
        case SearchFieldControl.Quantity:
            <FormField Text=@Caption For=@Id>
                <div class="flex items-center gap-2">
                    @ComparatorPicker
                    <BbInput Id=@Id Type="InputType.Number" Value=@NumberText(Value.Number) ValueChanged=@(v => Value.Number = ParseNumber(v)) Placeholder=@Placeholder Class="h-8"/>
                    @if (Field.Units.Count > 0)
                    {
                        <BbSelect TValue="string" Options=@Options(_units) @bind-Value=Value.Unit AriaLabel=@Caption Class="w-28 shrink-0"/>
                    }
                </div>
            </FormField>
            break;
        case SearchFieldControl.Reference when Server is not null && !Nested:
            <ReferenceFieldEditor Field=@Field Value=@Value Server=@Server Session=@Session Placeholder=@Placeholder Label=@Caption/>
            break;
        case SearchFieldControl.Identifier:
            <div class="grid grid-cols-2 gap-2">
                <FormField Text=@Strings.Caption_IdentifierSystem For=@($"{Id}-system")>
                    <BbInput Id=@($"{Id}-system") @bind-Value=Value.System Class="h-8"/>
                </FormField>
                <FormField Text=@Caption For=@Id>
                    <BbInput Id=@Id @bind-Value=Value.Text Placeholder=@Placeholder Class="h-8"/>
                </FormField>
            </div>
            break;
        default:
            <FormField Text=@Caption For=@Id>
                <div class="flex items-center gap-2">
                    @if (Field.Modifiers.Count > 0)
                    {
                        <BbSelect TValue="string" Options=@Options(_modifiers) @bind-Value=Value.Modifier AriaLabel=@Caption Class="w-28 shrink-0"/>
                    }
                    <BbInput Id=@Id @bind-Value=Value.Text Placeholder=@Placeholder maxlength=@(Field.MaxLength is > 0 ? Field.MaxLength : null) Class="h-8"/>
                </div>
            </FormField>
            break;
    }
    @if (Hint is { Length: > 0 })
    {
        <div class="mt-0.5 truncate text-xs leading-tight text-muted" title=@Hint>@Hint</div>
    }
    @if (Error != null)
    {
        <div class="mt-0.5 truncate text-xs leading-tight text-danger" title=@Error>@Error</div>
    }
</div>

@code {

    private static readonly Dictionary<string, string> s_comparatorSigns = new Dictionary<string, string>
    {
        ["eq"] = "=", ["ne"] = "≠", ["gt"] = ">", ["lt"] = "<", ["ge"] = "≥", ["le"] = "≤",
        ["sa"] = "sa", ["eb"] = "eb", ["ap"] = "≈"
    };

    // The codes of the value set of the field: the first expansion, what the list shows now, and every code met (a selected one stays shown)
    private ValueSetExpansion? _expansion;
    private IReadOnlyList<SearchOption> _shown = [];
    private readonly Dictionary<string, SearchOption> _known = new Dictionary<string, SearchOption>(StringComparer.Ordinal);
    private bool _expanding;
    private CancellationTokenSource? _typing;
    private static readonly IReadOnlyList<SearchOption> _noOptions = [];
    private List<ListOption<string>> _booleans = [];
    private List<ListOption<string>> _units = [];
    private List<ListOption<string>> _modifiers = [];
    private List<ListOption<string>> _comparators = [];

    [Parameter][EditorRequired]
    public SearchFormField Field { get; set; } = null!;

    [Parameter][EditorRequired]
    public SearchFieldValue Value { get; set; } = null!;

    [Parameter]
    public string Culture { get; set; } = string.Empty;

    [Parameter]
    public string? Error { get; set; }

    // The FHIR server that expands the value set of the field; none: the option source of the host only
    [Parameter]
    public IViewerServer? Server { get; set; }

    // The session of the list: a reference field offers the records opened in it and the list of its type to choose from
    [Parameter]
    public ViewerSession? Session { get; set; }

    // A field of the list a reference is chosen in: a reference there is a plain text box, so a choice never opens another choice
    [Parameter]
    public bool Nested { get; set; }

    // The list with the selected codes on top of what matches: a selected code the list does not show still has its caption
    private IEnumerable<SearchOption> Shown =>
        Value.Selected.Where(key => _shown.All(o => o.Key != key))
             .Select(key => _known.GetValueOrDefault(key) ?? new SearchOption(CodeOf(key), CodeOf(key)))
             .Concat(_shown);

    private string Caption
    {
        get
        {
            var text = Field.Label.Resolve(Culture);
            text = string.IsNullOrWhiteSpace(text) ? Field.QueryName : text;
            return Field.Required ? text + " *" : text;
        }
    }

    // The first frame of a range: "Birth date: from"
    private string From => string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Caption_RangeFrom, Caption);

    private string? Placeholder => Field.Placeholder.Resolve(Culture) is { Length: > 0 } text ? text : null;

    private string? Hint => Field.Hint.Resolve(Culture);

    private RenderFragment ComparatorPicker =>
        __builder =>
        {
            if (_comparators.Count > 0)
            {
                <BbSelect TValue="string" Options=@Options(_comparators) @bind-Value=Value.Comparator AriaLabel=@Caption Class="w-20 shrink-0"/>
            }
        };

    private SearchFormField? _listsOf;

    // The id of the control, for its label
    private string Id => $"search-field-{Field.QueryName}";

    private IEnumerable<SelectOption<string>> ShownOptions => Shown.Select(option => new SelectOption<string>(option.Key, option.Caption));

    private static IEnumerable<SelectOption<string>> Options(IEnumerable<ListOption<string>> options)
    {
        return options.Select(option => new SelectOption<string>(option.Value, option.Text));
    }

    private static string? NumberText(decimal? value)
    {
        return value?.ToString(CultureInfo.InvariantCulture);
    }

    private static decimal? ParseNumber(string? text)
    {
        return decimal.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var value) ? value : null;
    }

    protected override void OnParametersSet()
    {
        // The lists are of the field: they are not made again on every render of the form
        if (ReferenceEquals(_listsOf, Field))
        {
            return;
        }

        _listsOf = Field;

        _booleans =
        [
            new ListOption<string>(FloxStrings.Caption_Any, string.Empty),
            new ListOption<string>(FloxStrings.Caption_Yes, bool.TrueString.ToLowerInvariant()),
            new ListOption<string>(FloxStrings.Caption_No, bool.FalseString.ToLowerInvariant())
        ];

        _units = Field.Units
                      .Select(u => new ListOption<string>(LabelOf(u), u.Code))
                      .ToList();

        _modifiers = [new ListOption<string>("—", string.Empty), .. Field.Modifiers.Select(m => new ListOption<string>(":" + m, m))];

        _comparators = Field.Comparators
                             .Select(c => new ListOption<string>(s_comparatorSigns.GetValueOrDefault(c, c), c))
                             .ToList();
    }

    // The codes come from the FHIR server of the search (ValueSet/$expand), else from the option source of the host; neither: a text box
    protected override async Task OnInitializedAsync()
    {
        var offersValues = Field.Control is SearchFieldControl.Select or SearchFieldControl.MultiSelect or SearchFieldControl.Autocomplete;
        if (!offersValues || string.IsNullOrWhiteSpace(Field.ValueSetUrl))
        {
            return;
        }

        _expanding = true;
        try
        {
            if (Server is not null && Services.GetService<IValueSetExpander>() is { } expander)
            {
                _expansion = await expander.ExpandAsync(Server, Field.ValueSetUrl, Field.ValueSetVersion, null);
            }

            if (_expansion is null && Services.GetService<ISearchFormOptionSource>() is { } source
                && await source.GetOptionsAsync(Field.ValueSetUrl, Field.ValueSetVersion) is { Count: > 0 } options)
            {
                _expansion = new ValueSetExpansion(options, true);
            }
        }
        finally
        {
            _expanding = false;
        }

        Show(_expansion?.Options ?? []);
    }

    // What the user typed: the codes of a whole value set are filtered here, a value set the server cut is searched on the server
    private async Task LoadOptions(string? filter)
    {
        if (_expansion is null)
        {
            return;
        }

        if (_expansion.Complete || string.IsNullOrWhiteSpace(filter) || Server is null || Services.GetService<IValueSetExpander>() is not { } expander)
        {
            Show(_expansion.Matching(filter));
            return;
        }

        _typing?.Cancel();
        _typing?.Dispose();
        var typing = _typing = new CancellationTokenSource();
        try
        {
            var found = await expander.ExpandAsync(Server, Field.ValueSetUrl!, Field.ValueSetVersion, filter, typing.Token);
            if (!typing.IsCancellationRequested)
            {
                Show(found?.Options ?? _expansion.Matching(filter));
            }
        }
        catch (OperationCanceledException) when (typing.IsCancellationRequested)
        {
            // a newer text was typed
        }
    }

    private void Show(IReadOnlyList<SearchOption> options)
    {
        _shown = options;
        foreach (var option in options)
        {
            _known.TryAdd(option.Key, option);
        }
    }

    // The code of a token system|code (the separators escaped by \ stay in it)
    private static string CodeOf(string key)
    {
        var parts = FhirSearchQuery.SplitUnescaped(key, '|');
        return parts[^1];
    }

    public void Dispose()
    {
        _typing?.Cancel();
        _typing?.Dispose();
    }

    private string LabelOf(QuantityUnit unit)
    {
        var label = unit.Label.Resolve(Culture);
        return string.IsNullOrWhiteSpace(label) ? unit.Code : label;
    }

}
