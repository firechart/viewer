@using Radzen.Blazor
@using Microsoft.Extensions.DependencyInjection
@using FireChart.Viewer.Core.Fhir
@using FireChart.Viewer.Core.Search
@implements IDisposable
@inject IServiceProvider Services

<RadzenStack Gap="var(--gap-xs)">
    <RadzenLabel Text=@Caption/>
    @switch (Field.Control)
    {
        case SearchFieldControl.Number:
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)">
                @ComparatorPicker
                <RadzenNumeric TValue="decimal?" @bind-Value=Value.Number Placeholder=@Placeholder ShowUpDown="false" class="rz-w-100"/>
            </RadzenStack>
            break;
        case SearchFieldControl.NumberRange:
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)" AlignItems="Radzen.AlignItems.Center">
                <RadzenNumeric TValue="decimal?" @bind-Value=Value.Number Placeholder=@Placeholder ShowUpDown="false" class="rz-w-100"/>
                <RadzenText>&ndash;</RadzenText>
                <RadzenNumeric TValue="decimal?" @bind-Value=Value.NumberTo ShowUpDown="false" class="rz-w-100"/>
            </RadzenStack>
            break;
        case SearchFieldControl.Date:
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)">
                @ComparatorPicker
                <RadzenDatePicker TValue="DateTime?" @bind-Value=Value.Date DateFormat=@SearchFhirFormat.DateFormat AllowClear="true" Placeholder=@(Placeholder ?? string.Empty) class="rz-w-100"/>
            </RadzenStack>
            break;
        case SearchFieldControl.DateRange:
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)" AlignItems="Radzen.AlignItems.Center">
                <RadzenDatePicker TValue="DateTime?" @bind-Value=Value.Date DateFormat=@SearchFhirFormat.DateFormat AllowClear="true" Placeholder=@(Placeholder ?? string.Empty) class="rz-w-100"/>
                <RadzenText>&ndash;</RadzenText>
                <RadzenDatePicker TValue="DateTime?" @bind-Value=Value.DateTo DateFormat=@SearchFhirFormat.DateFormat AllowClear="true" class="rz-w-100"/>
            </RadzenStack>
            break;
        case SearchFieldControl.Boolean:
            <RadzenDropDown TValue="string" Data=@_booleans TextProperty="Text" ValueProperty="Value" @bind-Value=Value.Text class="rz-w-100"/>
            break;
        case SearchFieldControl.Select or SearchFieldControl.MultiSelect or SearchFieldControl.Autocomplete when _expanding:
            <RadzenDropDown TValue="string" Data=@_noOptions Disabled="true" Placeholder=@Placeholder class="rz-w-100"/>
            break;
        case SearchFieldControl.Select when _expansion is not null && !Field.AllowFreeText:
            <RadzenDropDown TValue="string" Data=@Shown TextProperty="Caption" ValueProperty="Key" AllowClear="true" AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" LoadData=@LoadOptions FilterDelay="300"
                            Placeholder=@Placeholder class="rz-w-100"
                            Value=@Value.Selected.FirstOrDefault() ValueChanged=@(v => { Value.Selected.Clear(); Value.Selected.AddRange(v is null ? [] : [v]); })/>
            break;
        case SearchFieldControl.MultiSelect when _expansion is not null:
            <RadzenDropDown TValue="IEnumerable<string>" Multiple="true" Chips="true" Data=@Shown TextProperty="Caption" ValueProperty="Key"
                            AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" LoadData=@LoadOptions FilterDelay="300"
                            Placeholder=@Placeholder class="rz-w-100"
                            Value=@Value.Selected ValueChanged=@(v => { Value.Selected.Clear(); Value.Selected.AddRange(v?.ToList() ?? []); })/>
            break;
        case SearchFieldControl.Select or SearchFieldControl.Autocomplete when _expansion is not null:
            @* A code may be typed: the box holds the code, the list shows what the codes mean *@
            <RadzenAutoComplete Data=@_shown TextProperty="Code" LoadData=@LoadOptions FilterDelay="300" MinLength="0" OpenOnFocus="true"
                                @bind-Value=Value.Text Placeholder=@Placeholder class="rz-w-100">
                <Template>@(((SearchOption)context).Caption)</Template>
            </RadzenAutoComplete>
            break;
        case SearchFieldControl.Quantity:
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)">
                @ComparatorPicker
                <RadzenNumeric TValue="decimal?" @bind-Value=Value.Number Placeholder=@Placeholder ShowUpDown="false" class="rz-w-100"/>
                @if (Field.Units.Count > 0)
                {
                    <RadzenDropDown TValue="string" Data=@_units TextProperty="Text" ValueProperty="Value" AllowClear="true" @bind-Value=Value.Unit Style="min-width: 7rem"/>
                }
            </RadzenStack>
            break;
        case SearchFieldControl.Identifier:
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)">
                <RadzenTextBox @bind-Value=Value.System Placeholder="system" class="rz-w-100"/>
                <RadzenTextBox @bind-Value=Value.Text Placeholder=@Placeholder class="rz-w-100"/>
            </RadzenStack>
            break;
        default:
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)">
                @if (Field.Modifiers.Count > 0)
                {
                    <RadzenDropDown TValue="string" Data=@_modifiers TextProperty="Text" ValueProperty="Value" @bind-Value=Value.Modifier Style="min-width: 7rem"/>
                }
                <RadzenTextBox @bind-Value=Value.Text Placeholder=@Placeholder MaxLength=@(Field.MaxLength is > 0 ? Field.MaxLength : null) class="rz-w-100"/>
            </RadzenStack>
            break;
    }
    @if (Hint is { Length: > 0 })
    {
        <RadzenText TextStyle="TextStyle.Caption">@Hint</RadzenText>
    }
    @if (Error != null)
    {
        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-danger">@Error</RadzenText>
    }
</RadzenStack>

@code {

    private static readonly Dictionary<string, string> s_comparatorSigns = new Dictionary<string, string>
    {
        ["eq"] = "=", ["ne"] = "≠", ["gt"] = ">", ["lt"] = "<", ["ge"] = "≥", ["le"] = "≤",
        ["sa"] = "sa", ["eb"] = "eb", ["ap"] = "≈"
    };

    // The codes of the value set of the field: the first expansion, what the list shows now, and every code met (a selected one stays shown)
    private ValueSetExpansion? _expansion;
    private IReadOnlyList<SearchOption> _shown = [];
    private readonly Dictionary<string, SearchOption> _known = new Dictionary<string, SearchOption>(StringComparer.Ordinal);
    private bool _expanding;
    private CancellationTokenSource? _typing;
    private static readonly IReadOnlyList<SearchOption> _noOptions = [];
    private List<ListOption<string>> _booleans = [];
    private List<ListOption<string>> _units = [];
    private List<ListOption<string>> _modifiers = [];
    private List<ListOption<string>> _comparators = [];

    [Parameter][EditorRequired]
    public SearchFormField Field { get; set; } = null!;

    [Parameter][EditorRequired]
    public SearchFieldValue Value { get; set; } = null!;

    [Parameter]
    public string Culture { get; set; } = string.Empty;

    [Parameter]
    public string? Error { get; set; }

    // The FHIR server that expands the value set of the field; none: the option source of the host only
    [Parameter]
    public IViewerServer? Server { get; set; }

    // The list with the selected codes on top of what matches: a selected code the list does not show still has its caption
    private IEnumerable<SearchOption> Shown =>
        Value.Selected.Where(key => _shown.All(o => o.Key != key))
             .Select(key => _known.GetValueOrDefault(key) ?? new SearchOption(CodeOf(key), CodeOf(key)))
             .Concat(_shown);

    private string Caption
    {
        get
        {
            var text = Field.Label.Resolve(Culture);
            text = string.IsNullOrWhiteSpace(text) ? Field.QueryName : text;
            return Field.Required ? text + " *" : text;
        }
    }

    private string? Placeholder => Field.Placeholder.Resolve(Culture) is { Length: > 0 } text ? text : null;

    private string? Hint => Field.Hint.Resolve(Culture);

    private RenderFragment ComparatorPicker =>
        __builder =>
        {
            if (_comparators.Count > 0)
            {
                <RadzenDropDown TValue="string" Data=@_comparators TextProperty="Text" ValueProperty="Value" @bind-Value=Value.Comparator Style="min-width: 5rem"/>
            }
        };

    private SearchFormField? _listsOf;

    protected override void OnParametersSet()
    {
        // The lists are of the field: they are not made again on every render of the form
        if (ReferenceEquals(_listsOf, Field))
        {
            return;
        }

        _listsOf = Field;

        _booleans =
        [
            new ListOption<string>(FloxStrings.Caption_Any, string.Empty),
            new ListOption<string>(FloxStrings.Caption_Yes, bool.TrueString.ToLowerInvariant()),
            new ListOption<string>(FloxStrings.Caption_No, bool.FalseString.ToLowerInvariant())
        ];

        _units = Field.Units
                      .Select(u => new ListOption<string>(LabelOf(u), u.Code))
                      .ToList();

        _modifiers = [new ListOption<string>("—", string.Empty), .. Field.Modifiers.Select(m => new ListOption<string>(":" + m, m))];

        _comparators = Field.Comparators
                             .Select(c => new ListOption<string>(s_comparatorSigns.GetValueOrDefault(c, c), c))
                             .ToList();
    }

    // The codes come from the FHIR server of the search (ValueSet/$expand), else from the option source of the host; neither: a text box
    protected override async Task OnInitializedAsync()
    {
        var offersValues = Field.Control is SearchFieldControl.Select or SearchFieldControl.MultiSelect or SearchFieldControl.Autocomplete;
        if (!offersValues || string.IsNullOrWhiteSpace(Field.ValueSetUrl))
        {
            return;
        }

        _expanding = true;
        try
        {
            if (Server is not null && Services.GetService<IValueSetExpander>() is { } expander)
            {
                _expansion = await expander.ExpandAsync(Server, Field.ValueSetUrl, Field.ValueSetVersion, null);
            }

            if (_expansion is null && Services.GetService<ISearchFormOptionSource>() is { } source
                && await source.GetOptionsAsync(Field.ValueSetUrl, Field.ValueSetVersion) is { Count: > 0 } options)
            {
                _expansion = new ValueSetExpansion(options, true);
            }
        }
        finally
        {
            _expanding = false;
        }

        Show(_expansion?.Options ?? []);
    }

    // What the user typed: the codes of a whole value set are filtered here, a value set the server cut is searched on the server
    private async Task LoadOptions(LoadDataArgs args)
    {
        if (_expansion is null)
        {
            return;
        }

        if (_expansion.Complete || string.IsNullOrWhiteSpace(args.Filter) || Server is null || Services.GetService<IValueSetExpander>() is not { } expander)
        {
            Show(_expansion.Matching(args.Filter));
            return;
        }

        _typing?.Cancel();
        _typing?.Dispose();
        var typing = _typing = new CancellationTokenSource();
        try
        {
            var found = await expander.ExpandAsync(Server, Field.ValueSetUrl!, Field.ValueSetVersion, args.Filter, typing.Token);
            if (!typing.IsCancellationRequested)
            {
                Show(found?.Options ?? _expansion.Matching(args.Filter));
            }
        }
        catch (OperationCanceledException) when (typing.IsCancellationRequested)
        {
            // a newer text was typed
        }
    }

    private void Show(IReadOnlyList<SearchOption> options)
    {
        _shown = options;
        foreach (var option in options)
        {
            _known.TryAdd(option.Key, option);
        }
    }

    // The code of a token system|code (the separators escaped by \ stay in it)
    private static string CodeOf(string key)
    {
        var parts = FhirSearchQuery.SplitUnescaped(key, '|');
        return parts[^1];
    }

    public void Dispose()
    {
        _typing?.Cancel();
        _typing?.Dispose();
    }

    private string LabelOf(QuantityUnit unit)
    {
        var label = unit.Label.Resolve(Culture);
        return string.IsNullOrWhiteSpace(label) ? unit.Code : label;
    }

}
