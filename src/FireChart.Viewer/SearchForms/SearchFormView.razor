@using System.Globalization
@inject Flox.Shared.Components.FloxDialogService Dialogs

@* The form is as high as its fields, up to the height of the dialog under its title (the whole screen on a phone): only the fields scroll, the
   commands stay in view; Reset stands at the start, Cancel and OK at the end. The fields lie in an inset area from edge to edge of the dialog
   (bg-sunken, over the padding of the dialog, which it keeps inside; up to the title of its own dialog, under the header of the list of a
   reference), so the ring of a focused field is not cut either. It is a form: Enter in a text field applies it as OK does (the lists of a select,
   a date and a reference choose with their own Enter, in their popups outside the form) *@
<form class="m-0 flex h-full max-h-[calc(100dvh-12rem)] flex-col gap-4 max-sm:max-h-none" novalidate @onsubmit=@Apply @onsubmit:preventDefault>
    <div class=@($"{(Nested ? null : "-mt-4")} {InsetClass}")>
        <div class="flex flex-col gap-3">
            @if (Definition.IsGenerated)
            {
                <Alert Kind="AlertKind.Info">
                    @Strings.Message_SearchFormGenerated
                </Alert>
            }
            @foreach (var section in _sections)
            {
                if (section.Caption == null)
                {
                    @FieldGrid(section.Fields)
                }
                else
                {
                    <details class="rounded-lg border border-line px-3 py-2" open=@(!section.Collapsed)>
                        <summary class="cursor-pointer text-sm font-medium">@section.Caption</summary>
                        <div class="pt-2">@FieldGrid(section.Fields)</div>
                    </details>
                }
            }
        </div>
    </div>
    <div>
        <div class="flex items-center justify-end gap-2">
            @if (HasHidden)
            {
                <Button Variant="ButtonVariant.Outline" Class="form-show-all" OnClick=@ToggleAll>@(_showAll ? Strings.Caption_ShowFormFields : Strings.Caption_ShowAllFields)</Button>
            }
            <Button Variant="ButtonVariant.Outline" Class="form-reset me-auto" OnClick=@Reset>@FloxStrings.Caption_Reset</Button>
            <Button Variant="ButtonVariant.Outline" OnClick=@_cancel>@FloxStrings.Caption_Cancel</Button>
            <Button Type="ButtonType.Submit">@(ApplyText ?? FloxStrings.Caption_Ok)</Button>
        </div>
    </div>
</form>

@code {

    // The inset under the fields; on it the fields of Blueprint (marked by their border-input) take the foam of the cards in light, as the cells of a grouped list of
    // iOS, and keep their tint in dark
    private const string InsetClass = "-mx-6 min-h-0 flex-1 overflow-y-auto bg-sunken px-6 py-4 [&_[class*=border-input]]:bg-card dark:[&_[class*=border-input]]:bg-input/30";

    private sealed record Section
    (
        string? Caption,
        bool Collapsed,
        List<SearchFormField> Fields
    );

    private readonly Dictionary<string, SearchFieldValue> _values = new Dictionary<string, SearchFieldValue>(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _errors = new Dictionary<string, string>(StringComparer.Ordinal);
    private readonly List<Section> _sections = [];
    private string _culture = CultureInfo.CurrentUICulture.Name;
    private SearchFormDefinition? _loadedForm;
    private IReadOnlyDictionary<string, SearchFieldValue>? _loadedValues;

    /// <summary>The form.</summary>
    [Parameter, EditorRequired]
    public SearchFormDefinition Definition { get; set; } = null!;

    /// <summary>The values the form opens with, by query name; none: the defaults of the fields.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, SearchFieldValue>? Values { get; set; }

    /// <summary>The FHIR server the search goes to: it expands the value sets of the coded fields; none: the option source of the host only.</summary>
    [Parameter]
    public IViewerServer? Server { get; set; }

    /// <summary>The session of the list: a reference field offers the records opened in it and the list of its type to choose from.</summary>
    [Parameter]
    public ViewerSession? Session { get; set; }

    /// <summary>The form of the list a reference is chosen in: its reference fields are plain text boxes.</summary>
    [Parameter]
    public bool Nested { get; set; }

    /// <summary>Receives the conditions instead of closing the dialog (the form inside the list a reference is chosen in).</summary>
    [Parameter]
    public EventCallback<SearchFormDialogResult> OnApply { get; set; }

    /// <summary>The text of the button that applies the form; none: OK.</summary>
    [Parameter]
    public string? ApplyText { get; set; }

    protected override void OnParametersSet()
    {
        // The dialog host passes the same objects again on every render: what the user typed must survive that
        if (ReferenceEquals(_loadedForm, Definition) && ReferenceEquals(_loadedValues, Values))
        {
            return;
        }

        _loadedForm = Definition;
        _loadedValues = Values;
        _values.Clear();
        foreach (var field in Definition.Fields)
        {
            _values[field.QueryName] = Values?.TryGetValue(field.QueryName, out var previous) == true ? previous.Clone() : SearchFormEvaluator.NewValue(field);
        }

        BuildLayout();
    }

    private void BuildLayout()
    {
        _sections.Clear();

        // A hidden group hides its fields and a hidden field is not shown, unless all the fields are asked for; a field with a value always shows, so
        // nothing that narrows the list is out of sight (the default value of a hidden field is a filter of every search)
        var hiddenGroups = Definition.Groups.Where(g => g.Hidden).Select(g => g.Code).ToHashSet(StringComparer.Ordinal);
        bool Shown(SearchFormField field) => _showAll || HasValue(field) || (!field.Hidden && !(field.GroupCode is { } code && hiddenGroups.Contains(code)));
        var groups = Definition.Groups
                          .OrderBy(g => g.Order)
                          .ToList();
        var known = Definition.Groups.Select(g => g.Code)
                           .ToHashSet(StringComparer.Ordinal);
        var ordered = Definition.Fields
                           .OrderBy(f => f.Order)
                           .ToList();

        var loose = ordered.Where(f => Shown(f) && (f.GroupCode == null || !known.Contains(f.GroupCode)))
                            .ToList();
        if (loose.Count > 0)
        {
            _sections.Add(new Section(null, false, loose));
        }

        foreach (var group in groups)
        {
            var fields = ordered.Where(f => Shown(f) && f.GroupCode == group.Code)
                                 .ToList();
            if (fields.Count > 0)
            {
                var collapsed = group.CollapsedByDefault && !fields.Any(HasValue);
                _sections.Add(new Section(group.Caption.Resolve(_culture), collapsed, fields));
            }
        }
    }

    private bool HasValue(SearchFormField field) => SearchFormEvaluator.HasValue(field, _values[field.QueryName]);

    // The fields the author hid are shown too
    private bool _showAll;

    private bool HasHidden => Definition.Fields.Any(f => f.Hidden) || Definition.Groups.Any(g => g.Hidden);

    private void ToggleAll()
    {
        _showAll = !_showAll;
        BuildLayout();
    }

    private RenderFragment FieldGrid(List<SearchFormField> fields) =>
        @<div class="grid grid-cols-12 gap-2">
            @foreach (var field in fields)
            {
                <div @key=field.QueryName class="col-span-12">
                    <SearchFieldEditor Field=@field
                                       Value=@_values[field.QueryName]
                                       Culture=@_culture
                                       Server=@Server
                                       Session=@Session
                                       Nested=@Nested
                                       Error=@_errors.GetValueOrDefault(field.QueryName)/>
                </div>
            }
        </div>;

    // The form as a list starts (its defaults), applied at once: the dialog closes and the list loads again
    private async Task Reset()
    {
        _errors.Clear();
        foreach (var field in Definition.Fields)
        {
            _values[field.QueryName] = SearchFormEvaluator.NewValue(field);
        }

        await Apply();
    }

    private async Task Apply()
    {
        _errors.Clear();
        foreach (var field in Definition.Fields)
        {
            if (SearchFormEvaluator.Validate(field, _values[field.QueryName]) is { } problem)
            {
                _errors[field.QueryName] = problem;
            }
        }

        if (_errors.Count > 0)
        {
            return;
        }

        var result = new SearchFormDialogResult(SearchFormEvaluator.Evaluate(Definition, _values), _values.ToDictionary(p => p.Key, p => p.Value.Clone(), StringComparer.Ordinal));
        if (OnApply.HasDelegate)
        {
            await OnApply.InvokeAsync(result);
            return;
        }

        Close(result);
    }

    // The receiver is not a component, so the form is not rendered again after the click: the dialog is going away
    private readonly object _noRender = new object();
    private EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> _cancel;

    protected override void OnInitialized()
    {
        _cancel = EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(_noRender, () => Close(null));
    }

    private void Close(SearchFormDialogResult? result)
    {
        Dialogs.Close(result);
    }

}
