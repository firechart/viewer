@inject IServerCredentialStore Credentials

@* The credentials of a server with Basic or Token authentication: a real form (the password manager of the browser fills it), the secret is kept in memory only *@
<EditForm Model=@_model OnSubmit=@SubmitAsync>
    <RadzenStack Gap="var(--gap-lg)" class="max-w-md rz-mt-4">
        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@Strings.Caption_FhirServerCredentialsAsked</RadzenText>
        @if (Rejected)
        {
            <RadzenAlert AlertStyle="Radzen.AlertStyle.Warning" Variant="Radzen.Variant.Flat" AllowClose="false" Size="Radzen.AlertSize.Small">
                @Strings.Message_CredentialsRejected
            </RadzenAlert>
        }

        @if (Server?.AuthenticationType == AuthenticationType.Basic)
        {
            <RadzenFormField Text=@FloxStrings.Caption_UserName Variant="Radzen.Variant.Text" class="rz-w-100">
                <RadzenTextBox @bind-Value=@_model.UserName Name="username" AutoCompleteType="Radzen.Blazor.AutoCompleteType.Username" Immediate="true"/>
            </RadzenFormField>
            <RadzenFormField Text=@FloxStrings.Caption_Password Variant="Radzen.Variant.Text" class="rz-w-100">
                <RadzenPassword @bind-Value=@_model.Secret Name="password" AutoCompleteType="Radzen.Blazor.AutoCompleteType.CurrentPassword" Immediate="true"/>
            </RadzenFormField>
        }
        else
        {
            <RadzenFormField Text=@Strings.Caption_FhirServerToken Variant="Radzen.Variant.Text" class="rz-w-100">
                <RadzenPassword @bind-Value=@_model.Secret Name="token" AutoCompleteType="Radzen.Blazor.AutoCompleteType.Off" Immediate="true"/>
            </RadzenFormField>
        }

        <RadzenButton ButtonType="Radzen.ButtonType.Submit" ButtonStyle="Radzen.ButtonStyle.Primary" Text=@FloxStrings.Caption_Connect Disabled=@(!CanSubmit)/>
    </RadzenStack>
</EditForm>

@code {

    private sealed class CredentialsModel
    {
        public string? UserName { get; set; }

        public string? Secret { get; set; }
    }

    private readonly CredentialsModel _model = new();

    /// <summary>The server.</summary>
    [Parameter, EditorRequired]
    public IViewerServer? Server { get; set; }

    // The server did not accept what was given before
    [Parameter]
    public bool Rejected { get; set; }

    // The credentials are in the store: the page reads the server again
    [Parameter]
    public EventCallback OnSubmitted { get; set; }

    private bool CanSubmit
    {
        get
        {
            return !string.IsNullOrWhiteSpace(_model.Secret) && (Server?.AuthenticationType != AuthenticationType.Basic || !string.IsNullOrWhiteSpace(_model.UserName));
        }
    }

    private async Task SubmitAsync()
    {
        if (Server is null || !CanSubmit)
        {
            return;
        }

        if (Server.AuthenticationType == AuthenticationType.Basic)
        {
            Credentials.SetBasic(Server, _model.UserName!.Trim(), _model.Secret!);
        }
        else
        {
            Credentials.SetToken(Server, _model.Secret!);
        }

        // Nothing of it stays in the form
        _model.Secret = null;
        await OnSubmitted.InvokeAsync();
    }

}
