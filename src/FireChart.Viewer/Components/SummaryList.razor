@typeparam TRow
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Rows of one height in one scroller: only the rows near the viewport are drawn. The title of the group in force stays above the scroller (CSS sticky cannot
   hold an element that the window has dropped from the DOM). The height is the CSS of the kit (--fx-summary-row-height, by the width of the list): the rows of
   a narrow list are taller, and the script measures the probe to count the places of the rows *@
<div class="fx-summary-rows relative">
    <div @ref=_probe class="fx-summary-probe" aria-hidden="true"></div>

    @if (Sticky is not null && Rows.Count > 0 && (ShowSticky is null || ShowSticky(TopRow)))
    {
        <div class="fx-summary-sticky absolute left-0 top-0 z-10 overflow-hidden" style="right: var(--fx-scrollbar, 0px); height: var(--summary-row-height)">
            @Sticky(TopRow)
        </div>
    }

    <div @ref=_scroller class="overflow-y-auto overscroll-contain">
        <div class="relative" style=@($"height: calc(var(--summary-row-height) * {Rows.Count})")>
            <div style=@($"transform: translateY(calc(var(--summary-row-height) * {From}))")>
                @for (var index = From; index < To; index++)
                {
                    var row = Rows[index];
                    <div class="overflow-hidden" style="height: var(--summary-row-height)" @key=row>
                        @Row(row)
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private const int Overscan = 6;

    private ElementReference _scroller;
    private ElementReference _probe;
    private IJSObjectReference? _module;
    private IJSObjectReference? _scroll;
    private DotNetObjectReference<SummaryList<TRow>>? _self;
    private int _first;
    private int _visible = 24;
    private bool _disposed;

    [Parameter, EditorRequired]
    public IReadOnlyList<TRow> Rows { get; set; } = [];

    // What is left under the list: the space the page keeps below it, in px
    [Parameter]
    public int BottomGap { get; set; } = 12;

    [Parameter, EditorRequired]
    public RenderFragment<TRow> Row { get; set; } = null!;

    [Parameter]
    public RenderFragment<TRow>? Sticky { get; set; }

    // Where the list was scrolled to: restored when the list appears, updated while the user scrolls (the state of the page keeps it)
    [Parameter]
    public ScrollMemory? Memory { get; set; }

    // Whether the floating title shows for the row at the top; every row when not given. A title that is half scrolled away must not be left half visible:
    // the floating one (the same title, in the same place) covers it as soon as the row has moved up by a pixel, so a page does not hide it for a title row
    [Parameter]
    public Func<TRow, bool>? ShowSticky { get; set; }

    private int From => Math.Clamp(_first - Overscan, 0, Math.Max(0, Rows.Count - 1));

    // The row at the top of the scroller (the list may have become shorter since the last scroll)
    private TRow TopRow => Rows[Math.Clamp(_first, 0, Rows.Count - 1)];

    private int To => Math.Min(Rows.Count, Math.Max(From, _first) + _visible + Overscan);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FireChart.Viewer/Components/SummaryList.razor.js");
        // The page may have gone while the module was loading: its elements are gone too
        if (_disposed)
        {
            await _module.DisposeAsync();
            return;
        }

        _self = DotNetObjectReference.Create(this);
        _scroll = await _module.InvokeAsync<IJSObjectReference?>("attach", _scroller, _probe, _self, BottomGap, Memory?.Top ?? 0);
        if (_disposed && _scroll is not null)
        {
            await _scroll.InvokeVoidAsync("dispose");
            await _scroll.DisposeAsync();
            _scroll = null;
        }
    }

    // The row comes to the top of the list (the floating title covers the place of a title row)
    public async Task ScrollToAsync(int index)
    {
        if (_scroll is not null)
        {
            await _scroll.InvokeVoidAsync("scrollTo", Math.Clamp(index, 0, Math.Max(0, Rows.Count - 1)));
        }
    }

    [JSInvokable]
    public void OnScroll(int first, int visible)
    {
        if (first == _first && visible == _visible)
        {
            return;
        }

        // iOS reports a negative scrollTop while the list bounces over its top
        _first = Math.Max(0, first);
        _visible = visible;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnScrollTop(double top)
    {
        if (Memory is not null)
        {
            Memory.Top = top;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_scroll is not null)
            {
                await _scroll.InvokeVoidAsync("dispose");
                await _scroll.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // the circuit is gone with the page
        }

        _self?.Dispose();
    }
}
