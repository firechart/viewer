@* The frame of a row of a list of records: the leading icon of the type, the click, the tooltip; the row itself is laid out of the slots its template
   filled (TileModel), with the options of the list. A row with an address is a link (the keyboard reaches it, a new tab opens it), one that chooses is a
   toggle button *@
@using FireChart.Viewer.Core

@if (Pressed is { } pressed)
{
    <button type="button" class="fx-summary-row" aria-pressed=@(pressed ? "true" : "false") @onclick=@OnClick title=@Shown.Text>
        @Content
    </button>
}
else if (!string.IsNullOrEmpty(Href))
{
    <RecordLink Class="fx-summary-row" Href=@Href OnClick=@OnClick Title=@Shown.Text>
        @Content
    </RecordLink>
}
else
{
    <div class="fx-summary-row" @onclick=@OnClick title=@Shown.Text>
        @Content
    </div>
}

@code {

    /// <summary>The row: the slots its template filled (<see cref="TileModel"/>).</summary>
    [Parameter, EditorRequired]
    public TileModel Model { get; set; } = null!;

    /// <summary>
    /// The options of the list (the age at the record, the status); <see langword="null"/> keeps the ones the row was rendered with.
    /// </summary>
    [Parameter]
    public TileOptions? Options { get; set; }

    /// <summary>The type of the record: its icon leads the row; none leaves the place empty.</summary>
    [Parameter]
    public string? ResourceType { get; set; }

    /// <summary>What a click on the row does (opens the record, or chooses it when <see cref="Pressed"/> is given).</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>
    /// The address of the place a click opens (<see cref="ViewerSession.HrefOf"/>): the row is then a link, so the keyboard reaches it and a new tab or
    /// window opens it (a click with Ctrl, Cmd or Shift, the middle button, the menu of the link). A plain click still runs <see cref="OnClick"/>, which
    /// goes to the same place in the page. <see langword="null"/> or empty: a row without a link.
    /// </summary>
    /// <example>
    /// <code>
    /// &lt;Tile Model=@tile Href=@Session.HrefOf(new ViewerRoute(ViewerPage.Resource, "Observation", "o1")) OnClick=@Open/&gt;
    /// </code>
    /// </example>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>
    /// Whether the row is the chosen one of a choice (the measure of a chart): the row is then a toggle button (<c>aria-pressed</c>) and
    /// <see cref="Href"/> is not used. <see langword="null"/>: the row chooses nothing.
    /// </summary>
    /// <example>
    /// <code>
    /// &lt;Tile Model=@tile Pressed=@(key == selected) OnClick=@(() =&gt; Select(key))/&gt;
    /// </code>
    /// </example>
    [Parameter]
    public bool? Pressed { get; set; }

    private TileModel Shown => Options is null ? Model : Model.WithOptions(Options);

    // The icon of the type and the row; a div, not a list: the list is the container of the rows
    private RenderFragment Content => @<text>
        @if (!string.IsNullOrEmpty(ResourceType))
        {
            <div class="fx-summary-icon"><IconResource ResourceType=@ResourceType/></div>
        }
        <div class="fx-list fx-summary-tile">@((MarkupString)Shown.Html)</div>
    </text>;
}
