@* What the page of a record shows: the record, its summary (a type with the component {Type}.summary) or its JSON. The address says which one
   (resources/Patient/1, summary/Patient/1, resources/Patient/1?view=source), so Back, the bookmarks and the links keep it; a record in a sheet
   switches to its JSON in place (SourceChanged). Each mode has an icon (the summary a sigma); its text goes where the toolbar, a size container,
   is narrow *@
@inject ViewerSummaries Summaries

<BbToggleGroup TValue="string" Value=@Current ValueChanged=@((string? mode) => Switch(mode)) Variant="ToggleVariant.Outline" Size="ToggleSize.Small"
               Required="true" Class="fx-summary-switch print:hidden" data-viewer="summary-switch">
    <BbToggleGroupItem TValue="string" Value=@RecordMode Class="gap-1.5" data-viewer="show-record" title=@Strings.Caption_Record>
        <FloxIcon Icon="description" Size="1rem"/><span class=@NarrowHidden>@Strings.Caption_Record</span>
    </BbToggleGroupItem>
    @if (_hasSummary)
    {
        <BbToggleGroupItem TValue="string" Value=@SummaryMode Class="gap-1.5" data-viewer="show-summary" title=@Strings.Caption_Summary>
            <FloxIcon Icon="functions" Size="1rem"/><span class=@NarrowHidden>@Strings.Caption_Summary</span>
        </BbToggleGroupItem>
    }
    <BbToggleGroupItem TValue="string" Value=@SourceMode Class="gap-1.5" data-viewer="show-source" title=@FloxStrings.Caption_Source>
        <FloxIcon Icon="data_object" Size="1rem"/><span class=@NarrowHidden>@FloxStrings.Caption_Source</span>
    </BbToggleGroupItem>
</BbToggleGroup>

@code {

    private const string RecordMode = "record";
    private const string SummaryMode = "summary";
    private const string SourceMode = "source";
    private const string NarrowHidden = "@max-md:sr-only";

    private bool _hasSummary;
    private string? _checkedType;

    /// <summary>The instance of the Viewer.</summary>
    [CascadingParameter]
    public ViewerSession Session { get; set; } = null!;

    /// <summary>The type of the record.</summary>
    [Parameter, EditorRequired]
    public string ResourceType { get; set; } = string.Empty;

    /// <summary>The id of the record.</summary>
    [Parameter, EditorRequired]
    public string ResourceId { get; set; } = string.Empty;

    /// <summary>The summary shows (on the page of the summary).</summary>
    [Parameter]
    public bool Summary { get; set; }

    /// <summary>The JSON of the record shows.</summary>
    [Parameter]
    public bool Source { get; set; }

    /// <summary>Switches between the record and its JSON in place (a record in a sheet); without it the switch goes to the address of the mode.</summary>
    [Parameter]
    public EventCallback<bool> SourceChanged { get; set; }

    private string Current => Summary ? SummaryMode : Source ? SourceMode : RecordMode;

    /// <inheritdoc/>
    protected override async Task OnParametersSetAsync()
    {
        if (_checkedType == ResourceType)
        {
            return;
        }

        _checkedType = ResourceType;
        _hasSummary = Summary || await Summaries.HasSummaryAsync(ResourceType);
    }

    private async Task Switch(string? mode)
    {
        if (mode is null || mode == Current)
        {
            return;
        }

        if (SourceChanged.HasDelegate && mode != SummaryMode)
        {
            await SourceChanged.InvokeAsync(mode == SourceMode);
            return;
        }

        Session.Navigate(mode switch
        {
            SummaryMode => new ViewerRoute(ViewerPage.Summary, ResourceType, ResourceId),
            SourceMode => ViewerRoutes.SourceOf(ResourceType, ResourceId),
            _ => new ViewerRoute(ViewerPage.Resource, ResourceType, ResourceId)
        });
    }

}
