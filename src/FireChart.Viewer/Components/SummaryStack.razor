@implements IAsyncDisposable
@inject IJSRuntime JS

@* The scroller of a stack of sections (the clinical summary): as tall as what is left of the window, the place is kept (ScrollMemory) and a section is
   brought to the top by its id. The sections are its children: each has its own sticky header and its own rows *@
<div @ref=_scroller class="fx-summary-stack overflow-y-auto overscroll-contain">
    <div class="fx-summary-rows">@ChildContent</div>
</div>

@code {
    private ElementReference _scroller;
    private IJSObjectReference? _module;
    private IJSObjectReference? _scroll;
    private DotNetObjectReference<SummaryStack>? _self;
    private bool _disposed;

    /// <summary>The sections.</summary>
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = null!;

    /// <summary>What is left under the stack: the space the page keeps below it, in px.</summary>
    [Parameter]
    public int BottomGap { get; set; } = 12;

    /// <summary>Where the stack was scrolled to: restored when it appears, updated while the user scrolls (the state of the page keeps it).</summary>
    [Parameter]
    public ScrollMemory? Memory { get; set; }

    /// <summary>
    /// Brings the element with the id (a section) to the top of the stack.
    /// </summary>
    /// <param name="id">The id of the element.</param>
    /// <returns>The task.</returns>
    public async Task ScrollToAsync(string id)
    {
        if (_scroll is not null)
        {
            await _scroll.InvokeVoidAsync("scrollTo", id);
        }
    }

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FireChart.Viewer/Components/SummaryStack.razor.js");
        if (_disposed)
        {
            await _module.DisposeAsync();
            return;
        }

        _self = DotNetObjectReference.Create(this);
        _scroll = await _module.InvokeAsync<IJSObjectReference?>("attach", _scroller, _self, BottomGap, Memory?.Top ?? 0);
        if (_disposed && _scroll is not null)
        {
            await _scroll.InvokeVoidAsync("dispose");
            await _scroll.DisposeAsync();
            _scroll = null;
        }
    }

    /// <summary>Called by the script while the user scrolls.</summary>
    /// <param name="top">The scroll top, in px.</param>
    [JSInvokable]
    public void OnScrollTop(double top)
    {
        if (Memory is not null)
        {
            Memory.Top = top;
        }
    }

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_scroll is not null)
            {
                await _scroll.InvokeVoidAsync("dispose");
                await _scroll.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // the circuit is gone with the page
        }

        _self?.Dispose();
    }
}
