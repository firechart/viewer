@* The chain of a Viewer on its own (a frame, a Blazor host without crumbs of its own): the pages above this one (server > type). FireChart draws its own *@
@if (Items.Count > 0)
{
    @* The crumbs of the pages above (Breadcrumb of Blueprint): the page itself is not a crumb; a path wider than the page is swiped sideways *@
    <BbBreadcrumb Class="-mt-1.5 overflow-x-auto overscroll-x-contain px-3 [scrollbar-width:none] [&>ol]:flex-nowrap"
                                             aria-label=@FloxStrings.Caption_Path data-viewer="breadcrumbs">
        @* The separators are placed here: AutoSeparator of Blueprint 4.2 draws an empty one (its default chevron is lost) *@
        <BbBreadcrumbList>
            @foreach (var (item, index) in Items.Select((item, index) => (item, index)))
            {
                @if (index > 0)
                {
                    <BbBreadcrumbSeparator/>
                }
                <BbBreadcrumbItem Class="shrink-0 whitespace-nowrap">
                    <BbBreadcrumbLink Href=@item.Href Class="py-1.5">@item.Text</BbBreadcrumbLink>
                </BbBreadcrumbItem>
            }
        </BbBreadcrumbList>
    </BbBreadcrumb>
}

@code {

    [CascadingParameter]
    private ViewerSession Session { get; set; } = null!;

    [Parameter, EditorRequired]
    public ViewerRoute? Route { get; set; }

    private List<Crumb> Items
    {
        get
        {
            var server = new Crumb(Session.Server.Name, Session.HrefOf(new ViewerRoute(ViewerPage.ResourceTypes)));
            return Route switch
            {
                { Page: ViewerPage.ResourceList or ViewerPage.Bookmarks } => [server],
                { Page: ViewerPage.Resource or ViewerPage.Summary, ResourceType: { } type } =>
                    [server, new Crumb(type, Session.HrefOf(new ViewerRoute(ViewerPage.ResourceList, type)))],
                _ => []
            };
        }
    }

    private sealed record Crumb(string Text, string Href);

}
