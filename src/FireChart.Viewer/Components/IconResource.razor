@* Icon that reflects the semantic meaning of a FHIR resource type *@

<FloxIcon Icon=@GetIcon(ResourceType) Title=@ResourceType Color=@(Color ?? (Autocolor ? ResourceTypeColors.Of(ResourceType) : null)) Size=@Size Class=@Class/>

@code {

    [Parameter]
    public string ResourceType { get; set; } = string.Empty;

    // Wins over Autocolor
    [Parameter]
    public string? Color { get; set; }

    // The colour of the type from the rainbow table of ResourceTypeColors, when no Color is given
    [Parameter]
    public bool Autocolor { get; set; }

    [Parameter]
    public string? Size { get; set; }

    [Parameter]
    public string? Class { get; set; }

