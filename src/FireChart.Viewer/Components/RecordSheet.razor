@* A record over the page that opened it (the patient summary): a sheet from the bottom on a narrow screen, a panel from the right on a wide one. The
   mask, Escape and the close button close it; the address holds it (?peek=), so Back closes it too. The page behind is inert while it is open, and the
   focus goes back to the row that opened it *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="fixed inset-0 z-[1000] bg-black/40" @onclick=@OnClose data-viewer="record-sheet-mask"></div>
<div @ref=_panel tabindex="-1" role="dialog" aria-modal="true" aria-label=@Route.ResourceType @onkeydown=@OnKeyDown data-viewer="record-sheet"
     class="fixed z-[1001] inset-x-0 bottom-0 h-[85dvh] rounded-t-xl md:inset-y-0 md:start-auto md:end-0 md:h-auto md:w-[min(48rem,92vw)] md:rounded-none flex flex-col bg-surface text-ink shadow-xl outline-none">
    <div class="flex shrink-0 items-center gap-2 border-b border-line px-3 py-1">
        <IconResource ResourceType=@Route.ResourceType Autocolor/>
        <span class="grow truncate font-medium">@Route.ResourceType</span>
        <SectionOutlet SectionName=@CommandsSection/>
        <RadzenButton Icon="open_in_full" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" title=@Strings.Caption_OpenAsPage
                      aria-label=@Strings.Caption_OpenAsPage Click=@OnOpenPage/>
        <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" title=@FloxStrings.Caption_Close
                      aria-label=@FloxStrings.Caption_Close Click=@OnClose/>
    </div>
    <div class="grow overflow-y-auto overscroll-contain px-3 pb-3">
        <ResourceDetailView @key=@Route.Location ResourceType=@(Route.ResourceType!) ResourceId=@(Route.Id!) InSheet/>
    </div>
</div>

@code {

    private ElementReference _panel;
    private string? _focused;
    private IJSObjectReference? _module;
    private IJSObjectReference? _sheet;
    private bool _disposed;

    /// <summary>
    /// The outlet of the commands of the record in the header of the sheet (its bookmark): the page of the record in a sheet gives them with
    /// <c>&lt;SectionContent SectionName=@RecordSheet.CommandsSection&gt;</c>.
    /// </summary>
    public const string CommandsSection = "fx-viewer-sheet-commands";

    /// <summary>The page of the record shown (<see cref="ViewerPage.Resource"/>).</summary>
    [Parameter, EditorRequired]
    public ViewerRoute Route { get; set; } = null!;

    /// <summary>
    /// The page behind the sheet, made inert while the sheet is open (<c>inert</c>: no focus, no click, hidden from a reader), so Tab does not leave the
    /// sheet; none leaves the page as it is.
    /// </summary>
    /// <example>
    /// <code>
    /// &lt;div @ref=_page&gt;...&lt;/div&gt;
    /// &lt;RecordSheet Route=@peek Behind=@_page OnClose=@CloseAsync/&gt;
    /// </code>
    /// </example>
    [Parameter]
    public ElementReference? Behind { get; set; }

    /// <summary>Closes the sheet (the mask, Escape, the close button).</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Opens the record on its own page.</summary>
    [Parameter]
    public EventCallback OnOpenPage { get; set; }

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The script keeps what had the focus before the sheet took it
            _module = await JS.ImportModuleAsync("./_content/FireChart.Viewer/Components/RecordSheet.razor.js");
            if (_disposed)
            {
                await _module.DisposeAsync();
                return;
            }

            _sheet = await _module.InvokeAsync<IJSObjectReference>("attach", _panel);
            _focused = Route.Location;
        }

        if (_sheet is null)
        {
            return;
        }

        // The page behind is known once its element is in the document (the first render of a sheet that came with the address has none yet)
        if (Behind is { Id: not null } behind)
        {
            await _sheet.InvokeVoidAsync("behind", behind);
        }

        // The keyboard goes to the sheet, so Escape closes it
        if (_focused != Route.Location)
        {
            _focused = Route.Location;
            await _sheet.InvokeVoidAsync("focus");
        }
    }

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_sheet is not null)
            {
                await _sheet.InvokeVoidAsync("dispose");
                await _sheet.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // the circuit is gone with the page
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }

}
