@* What a record loaded at once shows while it loads (summary.loadAll): how far it is, what came last, and Cancel, which stops the loading and shows
   what has come. A modal over the page: nothing under it is used meanwhile, and it takes no room, so the record drawn hidden under it does not move *@
<div class="fx-loading-overlay" role="dialog" aria-modal="true" aria-labelledby="fx-loading-title" data-viewer="loading-overlay"
     style="position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 1rem;
            background: color-mix(in oklab, var(--background, #fff) 70%, transparent); backdrop-filter: blur(2px)">
<div class="fx-card fx-card-border" role="status" aria-live="polite" data-viewer="loading-panel"
     style="width: min(32rem, 100%); background: var(--card, #fff); box-shadow: 0 8px 32px rgb(0 0 0 / .18)">
    <div class="fx-card-body" style="gap: .75rem">
        <h3 class="fx-card-title" id="fx-loading-title">@Strings.Caption_LoadingRecord</h3>
        @if (Total > 0)
        {
            <BbProgress Value=@Math.Min(Done, Total) Max=@Total/>
            <p class="m-0 text-sm">@string.Format(Strings.Message_LoadingProgress, Done, Total)</p>
        }
        else
        {
            <BbSkeleton Class="h-2 w-full rounded-full"/>
        }

        @foreach (var message in Messages.TakeLast(4))
        {
            <div class="m-0 text-xs text-muted">@message</div>
        }

        <div>
            <Button Variant="ButtonVariant.Outline" OnClick=@OnCancel data-viewer="cancel-loading">@FloxStrings.Caption_Cancel</Button>
        </div>
    </div>
</div>
</div>

@code {

    // The parts loaded and the parts known so far (more may appear as they load: a total of 0 is an indeterminate bar)
    [Parameter]
    public int Done { get; set; }

    [Parameter]
    public int Total { get; set; }

    // What came last ("Loaded: Observation (240)"), newest last
    [Parameter]
    public IReadOnlyList<string> Messages { get; set; } = [];

    [Parameter]
    public EventCallback OnCancel { get; set; }

}
