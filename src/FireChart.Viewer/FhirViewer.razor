@* The Viewer: the page of its address below RoutePrefix. Client side only (WebAssembly, Hybrid); the routing is experimental *@
@implements IAsyncDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject FireChart.Viewer.Core.IViewerAssets ViewerAssets
@using Microsoft.Extensions.Logging
@inject ILogger<FhirViewer> Logger

@if (!IsClientSide)
{
    <Alert Kind="AlertKind.Danger" data-error="viewer_client_only">
        @Strings.Message_ViewerClientOnly
    </Alert>
}
else if (_session is not null)
{
    @if (Look.Stylesheet.Css.Length > 0)
    {
        <style>@Look.Stylesheet.Css</style>
    }

    var route = ViewerRoutes.Parse(_session.Location.Location);
    <CascadingValue Value="_session" IsFixed="false">
        @* The page; while a record is over it (the sheet), the sheet makes it inert: the keyboard and a reader stay in the sheet *@
        <div @ref=_page class="contents">
            @* The crumbs (unless the host draws its own), then the header of the page (Heading): its title on the left, its commands on the right
               (PageCommandsSection: the bookmark, print) and its menu (PageMenuSection), the Viewer's own in a frame and in any host; a record
               and its summary have the toolbar alone *@
            @if (ShowBreadcrumbs)
            {
                <ViewerBreadcrumbs Route=@route/>
            }

            <div class="fx-viewer-header" data-viewer="toolbar">
                @* A record and its summary have no title (the banner and the bar of the host name it): a toolbar, the same Heading so that its
                   outlets live on from page to page *@
                <Heading MenuSection=@PageMenuSection Toolbar=@(route is { Page: ViewerPage.Resource or ViewerPage.Summary })>
                    <ChildContent>@TitleOf(route)<SectionOutlet SectionName=@PageTitleSection/></ChildContent>
                    <Commands>
                        <span class="contents print:hidden"><SectionOutlet SectionName=@PageCommandsSection/></span>
                    </Commands>
                </Heading>
            </div>

            @switch (route)
            {
                case { Page: ViewerPage.ResourceTypes }:
                    <ResourceTypesView/>
                    break;
                case { Page: ViewerPage.ResourceList } list:
                    <ResourceListView ResourceType=@(list.ResourceType!) Query=@list.Query/>
                    break;
                case { Page: ViewerPage.Resource } resource:
                    <ResourceDetailView ResourceType=@(resource.ResourceType!) ResourceId=@(resource.Id!) Source=@resource.ShowsSource/>
                    break;
                case { Page: ViewerPage.Summary, ResourceType: { } context, Id: { } id }:
                    @* The summary of a type is the component {Type}.summary of the library; a type without one shows the page of its record *@
                    <FireChart.Viewer.Reports.ReportView @key=@($"summary/{context}/{id}") Component=@($"{context}.summary") ContextType=@context ContextId=@id
                                                         LoadAll=@_session.Fhir.LoadAll Summary/>
                    break;
                case { Page: ViewerPage.Bookmarks }:
                    <BookmarksView OnOpenElsewhere=@OnOpenBookmark/>
                    break;
                case { Page: ViewerPage.Preview, ResourceType: { } type } preview:
                    <FireChart.Viewer.Reports.ComponentPreview @key=@preview.Location ResourceType=@type RecordId=@preview.Id Query=@preview.Query/>
                    break;
                case { Page: ViewerPage.Report, ResourceType: { } type, Id: { } id }:
                    <FireChart.Viewer.Reports.ReportView @key=@($"report/{type}/{id}") Component=@($"{type}Report") ContextType=@type ContextId=@id LoadAll=@_session.Fhir.LoadAll/>
                    break;
                default:
                    <Alert Kind="AlertKind.Warning" data-error="invalid_location">
                        @Strings.Message_ViewerUnknownAddress
                    </Alert>
                    break;
            }
        </div>

        @* A record over the page (the patient summary): the address holds it, so Back closes it *@
        @if (route?.Peek is { } peek)
        {
            <RecordSheet Route=@peek Behind=@_page OnClose=@CloseSheetAsync OnOpenPage=@(() => _session.Navigate(peek))/>
        }
    </CascadingValue>
}

@code {

    private ViewerSession? _session;
    private ElementReference _page;
    private string? _sessionKey;
    private AppearanceApplier? _look;

    private AppearanceApplier Look => _look ??= new AppearanceApplier(ViewerAssets, JS, Logger);

    /// <summary>How the Viewer looks; none in a Flox application, where it inherits the styles of the host. Another instance is applied live.</summary>
    [Parameter]
    public ViewerAppearance? Appearance { get; set; }

    /// <summary>The chain server &gt; type &gt; id above the page; <see langword="true"/> by default. A host with crumbs of its own (FireChart) turns it
    /// off.</summary>
    [Parameter]
    public bool ShowBreadcrumbs { get; set; } = true;

    /// <summary>
    /// The outlet of the menu of a page of the Viewer (the button with the vertical ellipsis in the bar of the Viewer): a page gives its menu with
    /// <c>&lt;PageMenu SectionName=@FhirViewer.PageMenuSection&gt;</c>.
    /// </summary>
    /// <example>
    /// <code>
    /// &lt;PageMenu SectionName=@FhirViewer.PageMenuSection&gt;&lt;PageMenuItem Text="Vital signs" OnClick=@GoToVitals/&gt;&lt;/PageMenu&gt;
    /// </code>
    /// </example>
    public const string PageMenuSection = "fx-viewer-page-menu";

    /// <summary>
    /// The outlet of the commands of a page of the Viewer in its header, before the menu (the bookmark of the page): a page gives them with
    /// <c>&lt;SectionContent SectionName=@FhirViewer.PageCommandsSection&gt;</c>.
    /// </summary>
    /// <example>
    /// <code>
    /// &lt;SectionContent SectionName=@FhirViewer.PageCommandsSection&gt;&lt;BookmarkStar Route=@route/&gt;&lt;/SectionContent&gt;
    /// </code>
    /// </example>
    public const string PageCommandsSection = "fx-viewer-page-commands";

    /// <summary>
    /// The outlet after the title of a page of the Viewer in its header (the release of the server on the page of its types): a page gives it with
    /// <c>&lt;SectionContent SectionName=@FhirViewer.PageTitleSection&gt;</c>.
    /// </summary>
    /// <example>
    /// <code>
    /// &lt;SectionContent SectionName=@FhirViewer.PageTitleSection&gt;&lt;BbBadge&gt;FHIR R4&lt;/BbBadge&gt;&lt;/SectionContent&gt;
    /// </code>
    /// </example>
    public const string PageTitleSection = "fx-viewer-page-title";

    // The title of the header of a page: the server on its first page, the type of a list or a record, the summary, the bookmarks
    private string TitleOf(ViewerRoute? route)
    {
        return route switch
        {
            { Page: ViewerPage.ResourceList or ViewerPage.Resource, ResourceType: { } type } => type,
            { Page: ViewerPage.Summary, ResourceType: { } context } => SummaryCaption.Of(context),
            { Page: ViewerPage.Bookmarks } => FloxStrings.Caption_Bookmarks,
            { Page: ViewerPage.Report, ResourceType: { } type } => $"{type} report",
            { Page: ViewerPage.Preview, ResourceType: { } type } => $"{type} preview",
            _ => string.IsNullOrEmpty(_session?.Server.Name) ? Strings.Caption_Resources : _session.Server.Name
        };
    }

    /// <summary>Raised for an option of the configuration that cannot be used and is left out.</summary>
    [Parameter]
    public EventCallback<ViewerConfigError> OnConfigError { get; set; }

    /// <summary>The FHIR server the Viewer reads; required. Another server starts a new session.</summary>
    [Parameter, EditorRequired]
    public IViewerServer Server { get; set; } = null!;

    /// <summary>The path below the base of the application the Viewer owns (<c>server/42/</c>). The routing is experimental.</summary>
    [Parameter]
    public string? RoutePrefix { get; set; }

    /// <summary>How a SMART sign-in leaves the page and where it comes back (<see cref="SmartOptions"/>: the flow, the callback route of the host, the
    /// return page of the popup); none: no sign-in by redirect, a server that needs one cannot be read. Others start a new session.</summary>
    [Parameter]
    public SmartOptions? Smart { get; set; }

    /// <summary>The FHIR settings: the terminology server, how a summary loads its records, the decimal places of a value; the defaults when none.
    /// Others start a new session.</summary>
    [Parameter]
    public FhirOptions? Fhir { get; set; }

    /// <summary>Opens a bookmark of another server from the page of the bookmarks (<c>bookmarks</c>): the host chooses the server of
    /// <see cref="Flox.Core.Models.UserBookmark.SourceAddress"/> and puts the Viewer at <see cref="Flox.Core.Models.UserBookmark.Location"/>. None:
    /// such bookmarks are listed with the name of their server and do not open. The bookmarks are kept by the host (an
    /// <c>IGuidEntityStorage&lt;UserBookmark&gt;</c>, on the device); a host without them shows no bookmarks.</summary>
    [Parameter]
    public EventCallback<Flox.Core.Models.UserBookmark> OnOpenBookmark { get; set; }


    // WebAssembly in a browser, WebView in MAUI; never a server
    private bool IsClientSide => RendererInfo.IsInteractive && RendererInfo.Name is "WebAssembly" or "WebView";

    protected override async Task OnParametersSetAsync()
    {
        ArgumentNullException.ThrowIfNull(Server);
        foreach (var error in await Look.ComposeAsync(Appearance))
        {
            await OnConfigError.InvokeAsync(error);
        }

        var key = $"{Server.Key}|{Server.BaseUrl}|{RoutePrefix}|{Smart}|{Fhir}";
        if (key == _sessionKey)
        {
            return;
        }

        Close();
        _sessionKey = key;
        var location = new UrlLocationStore(NavigationManager, RoutePrefix);
        location.LocationChanged += OnLocationChanged;
        _session = new ViewerSession(Server, location, Smart)
        {
            Fhir = Fhir ?? FhirOptions.Default
        };
    }

    private void OnLocationChanged(object? sender, EventArgs e)
    {
        _session?.OnLocationChanged();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CloseSheetAsync()
    {
        if (_session?.CloseSheet() == true)
        {
            await JS.InvokeVoidAsync("history.back");
        }
    }

    private void Close()
    {
        if (_session is not null)
        {
            _session.Location.LocationChanged -= OnLocationChanged;
            _session.Location.Dispose();
            _session = null;
        }
    }

    // The theme is set on the document only when the appearance asks for one: in a Flox application the host owns it
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsClientSide)
        {
            await Look.ApplyThemeAsync(Appearance);
        }
    }

    /// <summary>Stops following the address and releases the script of the theme.</summary>
    /// <returns>A task that completes when it is done.</returns>
    public async ValueTask DisposeAsync()
    {
        Close();
        if (_look is not null)
        {
            await _look.DisposeAsync();
        }
    }

}
