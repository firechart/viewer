<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>The readers of the vendor library of FireChart Viewer: where a component, a search form, a summary form, the fx-* style kit and the samples are, and how a client and a server read them. The files themselves are not here: they are the package library, published by an application as its folder library/.</Description>
    <PackageTags>fhir;hl7;components;healthcare;viewer</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FireChart.Viewer.Core\FireChart.Viewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.R4" />
  </ItemGroup>

</Project>
