{% fhir_include "Communication:subject" %}
{% fhir_include "Communication:sender" %}
{% fhir_include "Communication:encounter" %}
{%- assign cat = self.category | as_list | first -%}
{%- capture t0 -%}{% apply self.topic mode: "text" %}{%- endcapture -%}
{%- capture t1 -%}{% if cat %}{% apply cat mode: "text" %}{% endif %}{%- endcapture -%}
{%- assign title = t0 | default: t1 | default: self.id -%}
{%- capture s0 -%}{% if self.sent %}{{ self.sent | fhir_date }}{% endif %}{%- endcapture -%}
{%- capture s1 -%}{% apply self.sender mode: "text" %}{%- endcapture -%}
{%- slot "subtitle" -%}{% render "parts", p1: s0, p2: s1 %}{%- endslot -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% slot "title" %}{{ title }}{% endslot %}
{% slot "status" %}{{ status }}{% endslot %}
{% slot_data patient: self.subject, encounter: self.encounter, at: self.sent %}
