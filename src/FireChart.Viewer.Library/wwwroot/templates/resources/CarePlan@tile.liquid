{% fhir_include "CarePlan:subject" %}
{% fhir_include "CarePlan:encounter" %}
{%- assign cat = self.category | as_list | first -%}{%- assign intent = self.intent | append: "" -%}
{%- capture t0 -%}{{ self.title }}{%- endcapture -%}
{%- capture t1 -%}{% if cat %}{% apply cat mode: "text" %}{% endif %}{%- endcapture -%}
{%- assign title = t0 | default: t1 | default: self.id -%}
{%- capture s0 -%}{% if self.period %}{% apply self.period mode: "text" %}{% endif %}{%- endcapture -%}
{%- capture s1 -%}{{ self.description }}{%- endcapture -%}
{%- slot "subtitle" -%}{% render "parts", p1: s0, p2: s1 %}{%- endslot -%}
{%- slot "trailing" -%}{% if intent != "" and intent != "plan" %}{% render "badge", text: intent %}{% endif %}{%- endslot -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% slot "title" %}{{ title }}{% endslot %}
{% slot "status" %}{{ status }}{% endslot %}
{% slot_data patient: self.subject, encounter: self.encounter, at: self.period %}
