
{%- assign act = self.active | append: "" -%}

<div class="fx-title">
  <h2 class="fx-title-text">{{ self.name | default: self.id }}</h2>

  <div class="fx-banner-facts">
    {%- if self.type %}
    <span>{% apply self.type mode: "text" -%}</span>
    {%- endif %}
  </div>

  <div class="fx-banner-flags">
    {%- if act == "false" -%}{%- render "badge", text: "inactive", tone: "danger" -%}{%- endif -%}
  </div>
</div>

{%- if self.telecom or self.address %}
<section class="fx-section">
  <h3 class="fx-section-title">{{ "Contact" | t }}</h3>
  {% render "field", label: "Phone and email", node: self.telecom, mode: "text" %}
  {% render "field", label: "Address", node: self.address, mode: "text" %}
</section>
{%- endif %}

{%- if self.partOf or self.alias or self.identifier %}
<section class="fx-section">
  <h3 class="fx-section-title">{{ "Relations" | t }}</h3>
  {% render "field", label: "Part of", node: self.partOf %}
  {% render "field", label: "Alias", node: self.alias, mode: "text" %}
  {% render "field", label: "Identifier", node: self.identifier, mode: "text" %}
</section>
{%- endif %}
