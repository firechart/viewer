{% fhir_include "MedicationRequest:subject" %}
{% fhir_include "MedicationRequest:encounter" %}
{%- assign dose = self.dosageInstruction | as_list | first -%}{%- assign pr = self.priority | append: "" -%}
{%- capture t0 -%}{% apply self.medication mode: "text" %}{%- endcapture -%}
{%- assign title = t0 | default: self.id -%}
{%- capture s0 -%}{% if dose %}{{ dose.text }}{% endif %}{%- endcapture -%}
{%- capture s1 -%}{% if self.authoredOn %}{{ self.authoredOn | fhir_date }}{% endif %}{%- endcapture -%}
{%- slot "subtitle" -%}{% render "parts", p1: s0, p2: s1 %}{%- endslot -%}
{%- slot "trailing" -%}{% if pr != "" and pr != "routine" %}{% render "status-badge", code: pr %}{% endif %}{%- endslot -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% slot "title" %}{{ title }}{% endslot %}
{% slot "status" %}{{ status }}{% endslot %}
{% slot_data patient: self.subject, encounter: self.encounter, at: self.authoredOn %}
