{% fhir_include "Claim:patient" %}
{% fhir_include "Claim:provider" %}
{% fhir_include "Claim:insurer" %}

{%- assign items = self.item | as_list -%}{%- assign dx = self.diagnosis | as_list -%}
{%- assign patient = self.patient | resolve -%}
{%- render "view-header", patient: patient, subject: self.patient, own: "Claim" %}

<div class="fx-title">
  <h2 class="fx-title-text">{% if self.type %}{% apply self.type mode: "text" %}{% else %}{{ "Claim" | t }}{% endif %}</h2>

  <div class="fx-banner-facts">
    {%- if self.created %}
    <span>{{ "Created" | t }} {% apply self.created mode: "text" -%}</span>
    {%- endif %}
    {%- if self.total %}
    <span class="fx-tile-value">{% apply self.total mode: "text" -%}</span>
    {%- endif %}
  </div>

  <div class="fx-banner-flags">
    {%- render "status-badge", code: self.status -%}
    {%- if self.use != "" -%}{%- render "badge", text: self.use -%}{%- endif -%}
    {%- render "concept-badge", concept: self.priority -%}
  </div>
</div>

{%- if self.provider or self.insurer or self.billablePeriod or self.prescription %}
<section class="fx-section">
  <h3 class="fx-section-title">{{ "Details" | t }}</h3>
  {% render "field", label: "Provider", node: self.provider %}
  {% render "field", label: "Insurer", node: self.insurer %}
  {% render "field", label: "Billable period", node: self.billablePeriod, mode: "text" %}
  {% render "field", label: "Prescription", node: self.prescription %}
</section>
{%- endif %}

{%- if dx.size > 0 %}
<section class="fx-section">
  <h3 class="fx-section-title">{{ "Diagnoses" | t }}</h3>
  {%- for d in dx %}
  <div class="fx-row"><span class="fx-row-main">{% apply d.diagnosis mode: "link,text" -%}</span><span class="fx-row-meta">{{ d.sequence }}</span></div>
  {%- endfor %}
</section>
{%- endif %}

{%- if items.size > 0 %}
<section class="fx-section">
  <h3 class="fx-section-title">{{ "Items" | t }}</h3>
  {%- for i in items %}
  <div class="fx-row"><span class="fx-row-main">{% apply i.productOrService mode: "text" -%}</span><span class="fx-row-meta">{% if i.net %}{% apply i.net mode: "text" -%}{% endif %}</span></div>
  {%- endfor %}
</section>
{%- endif %}
