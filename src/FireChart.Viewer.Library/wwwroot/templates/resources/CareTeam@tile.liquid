{% fhir_include "CareTeam:subject" %}
{% fhir_include "CareTeam:encounter" %}
{%- assign n = self.participant | as_list | size -%}
{%- capture t0 -%}{{ self.name }}{%- endcapture -%}
{%- assign title = t0 | default: self.id -%}
{%- capture s0 -%}{% if self.period %}{% apply self.period mode: "text" %}{% endif %}{%- endcapture -%}
{%- capture s1 -%}{% if n > 0 %}{{ "{{count}} members" | t: count: n }}{% endif %}{%- endcapture -%}
{%- slot "subtitle" -%}{% render "parts", p1: s0, p2: s1 %}{%- endslot -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% slot "title" %}{{ title }}{% endslot %}
{% slot "status" %}{{ status }}{% endslot %}
{% slot_data patient: self.subject, encounter: self.encounter, at: self.period %}
