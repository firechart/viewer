{%- assign dn = self.deviceName | as_list | first -%}
{%- capture t0 -%}{% if dn %}{{ dn.name }}{% endif %}{%- endcapture -%}
{%- capture t1 -%}{% apply self.type mode: "text" %}{%- endcapture -%}
{%- assign title = t0 | default: t1 | default: self.id -%}
{%- capture s0 -%}{{ self.manufacturer }}{%- endcapture -%}
{%- capture s1 -%}{{ self.modelNumber }}{%- endcapture -%}
{%- slot "subtitle" -%}{% render "parts", p1: s0, p2: s1 %}{%- endslot -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% slot "title" %}{{ title }}{% endslot %}
{% slot "status" %}{{ status }}{% endslot %}
{% slot_data patient: self.patient %}
