{% fhir_include "Encounter:subject" %}
{%- comment -%} In a list of its own: the patient and the number of the encounter as the title, the kind and the period below.
Below the banner of its patient (fhir_context): the kind as the title, the number and the period below {%- endcomment -%}
{%- assign type = self.type | first -%}
{%- assign period = self.period | default: self.actualPeriod -%}
{%- capture kind -%}
  {%- if type -%}{% apply type mode: "text" %}
  {%- else -%}
    {%- assign cl = self.class -%}
    {%- if cl.code -%}{{ cl | coding_display | default: cl.code }}
    {%- else -%}{%- assign c0 = cl | first -%}{%- assign cc = c0.coding | first -%}{{ cc | coding_display | default: cc.code }}
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}
{%- capture number -%}{{ self.identifier | map: "value" | join: ", " }}{%- endcapture -%}
{%- capture when -%}{% if period %}{% apply period mode: "text" %}{% endif %}{%- endcapture -%}
{%- assign shown = self.subject | in_context -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{%- assign gone = self.subject | missing -%}
{%- capture who -%}{% if self.subject and shown != true %}{% if gone %}{% render "badge", text: "Patient could not be found", tone: "warning" %}{% else %}{% apply self.subject mode: "text" %}{% endif %}{% endif %}{%- endcapture -%}
{%- if who == blank and shown != true -%}{%- capture who -%}{{ self.subject.reference | default: self.subject.identifier.value }}{%- endcapture -%}{%- endif -%}
{%- if who != blank -%}
  {%- slot "title" -%}{% render "parts", p1: who, p2: number, sep: " | " %}{%- endslot -%}
  {%- slot "subtitle" -%}{% render "parts", p1: kind, p2: when %}{%- endslot -%}
{%- else -%}
  {%- assign title = kind | default: number | default: self.id -%}
  {%- slot "title" -%}{{ title }}{%- endslot -%}
  {%- slot "subtitle" -%}{% render "parts", p1: number, p2: when %}{%- endslot -%}
  {%- slot_data patient: self.subject, at: period -%}
{%- endif -%}
{%- slot "status" -%}{{ status }}{%- endslot -%}
