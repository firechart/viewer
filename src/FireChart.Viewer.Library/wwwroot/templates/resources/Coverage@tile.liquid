{% fhir_include "Coverage:beneficiary" %}
{% fhir_include "Coverage:payor" %}
{%- assign payer = self.payor | as_list | first -%}
{%- capture t0 -%}{% apply self.type mode: "text" %}{%- endcapture -%}
{%- capture t1 -%}{% if payer %}{% apply payer mode: "text" %}{% endif %}{%- endcapture -%}
{%- assign title = t0 | default: t1 | default: self.id -%}
{%- capture s0 -%}{% if payer %}{% apply payer mode: "text" %}{% endif %}{%- endcapture -%}
{%- capture s1 -%}{% if self.subscriberId %}{{ self.subscriberId }}{% endif %}{%- endcapture -%}
{%- capture s2 -%}{% if self.period %}{% apply self.period mode: "text" %}{% endif %}{%- endcapture -%}
{%- slot "subtitle" -%}{% render "parts", p1: s0, p2: s1, p3: s2 %}{%- endslot -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% slot "title" %}{{ title }}{% endslot %}
{% slot "status" %}{{ status }}{% endslot %}
{% slot_data patient: self.beneficiary %}
