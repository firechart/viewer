{%- capture t0 -%}{{ self.name }}{%- endcapture -%}
{%- capture t1 -%}{{ self.title }}{%- endcapture -%}
{%- assign title = t0 | default: t1 | default: self.id -%}
{%- assign n = self.count | append: "" -%}
{%- capture s0 -%}{{ self.url }}{%- endcapture -%}
{%- capture s1 -%}{{ self.version }}{%- endcapture -%}
{%- slot "subtitle" -%}{% render "parts", sep: " · ", p1: s0, p2: s1 %}{%- endslot -%}
{%- capture c0 -%}{% if n != "" %}{{ "{{count}} concepts" | t: count: n }}{% endif %}{%- endcapture -%}
{%- capture c1 -%}{% render "badge", text: self.content %}{%- endcapture -%}
{%- slot "trailing" -%}{% if c0 != blank %}<span class="fx-tile-value">{{ c0 }}</span>{% endif %}{{ c1 }}{%- endslot -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% slot "title" %}{{ title }}{% endslot %}
{% slot "status" %}{{ status }}{% endslot %}
