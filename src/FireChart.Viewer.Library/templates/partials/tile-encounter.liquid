{%- comment -%} The encounter of a row (ref: a Reference, or a list of them): its first identifier, its period and its kind, joined by ", ";
nothing when the page shows the encounter above (fhir_context); what the reference says when the encounter is not in the pool {%- endcomment -%}
{%- assign r = ref | as_list | first -%}
{%- assign shown = r | in_context -%}
{%- unless shown -%}
  {%- assign e = r | resolve -%}
  {%- assign gone = r | missing -%}
  {%- if gone -%}
    {%- render "badge", text: "Encounter could not be loaded", tone: "warning" -%}
  {%- elsif e -%}
    {%- assign number = e.identifier | as_list | first -%}
    {%- assign period = e.period | default: e.actualPeriod -%}
    {%- capture s0 -%}{% if number %}{{ number.value }}{% endif %}{%- endcapture -%}
    {%- capture s1 -%}{% if period %}{% apply period mode: "text" %}{% endif %}{%- endcapture -%}
    {%- capture s2 -%}{% apply e mode: "text" %}{%- endcapture -%}
    {%- render "parts", p1: s0, p2: s1, p3: s2, sep: ", " -%}
  {%- elsif r -%}
    {%- capture said -%}{% apply r mode: "text" %}{%- endcapture -%}
    {{- said | default: r.reference -}}
  {%- endif -%}
{%- endunless -%}
