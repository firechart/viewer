{%- assign name = self.name | first -%}
{%- assign mrn = self.identifier | first -%}
{%- assign dead = self.deceased | append: "" -%}
{%- assign active = self.active | append: "" -%}

{%- capture title -%}
  {%- if name -%}
    {%- apply name mode: "text" -%}
  {%- else -%}
    {{- self.id -}}
  {%- endif -%}
{%- endcapture -%}

<header class="fx-banner">
  <h2 class="fx-banner-title">
    {%- if banner_link -%}
      <a href="fhir:Patient/{{ self.id }}">{{ title }}</a>
    {%- else -%}
      {{- title -}}
    {%- endif -%}
  </h2>

  <div class="fx-banner-facts">
    {%- if self.gender %}
    <span>{{ self.gender }}</span>
    {%- endif %}
    {%- if self.birthDate %}
    <span>
      {{- self.birthDate | fhir_date -}}
      {%- if dead != "" and dead != "false" -%}
        {%- assign years = self.birthDate | age_at: dead -%}
      {%- else -%}
        {%- assign years = self.birthDate | age -%}
      {%- endif -%}
      {%- if years %} ({{ years }}){% endif -%}
    </span>
    {%- endif %}
    {%- if mrn %}
    <span>{{ "ID" | t }} {% apply mrn mode: "text" -%}</span>
    {%- endif %}
  </div>

  <div class="fx-banner-flags">
    {%- if dead != "" and dead != "false" -%}
      {%- render "badge", text: "Deceased", tone: "danger" -%}
      {%- if dead != "true" -%}
        <span class="fx-muted">{{ dead | fhir_date }}</span>
      {%- endif -%}
    {%- endif -%}
    {%- if active == "false" -%}
      {%- render "badge", text: "Inactive", tone: "warning" -%}
    {%- endif -%}
  </div>
</header>
