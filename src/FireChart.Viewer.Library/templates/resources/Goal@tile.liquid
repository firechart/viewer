{% fhir_include "Goal:subject" %}
{%- assign tgt = self.target | as_list | first -%}
{%- capture t0 -%}{% apply self.description mode: "text" %}{%- endcapture -%}
{%- assign title = t0 | default: self.id -%}
{%- capture s0 -%}{% if self.start %}{% apply self.start mode: "text" %}{% endif %}{%- endcapture -%}
{%- capture s1 -%}{% if tgt and tgt.due %}{{ "due" | t }} {% apply tgt.due mode: "text" %}{% endif %}{%- endcapture -%}
{%- capture subtitle -%}{% render "parts", p1: s0, p2: s1 %}{%- endcapture -%}
{%- capture trailing -%}{% render "concept-badge", concept: self.achievementStatus %}{%- endcapture -%}
{%- capture status -%}{% render "status-badge", code: self.lifecycleStatus %}{%- endcapture -%}
{% render "tile-row", title: title, subtitle: subtitle, trailing: trailing, status: status, patient: self.subject, encounter: nil, at: self.start %}
