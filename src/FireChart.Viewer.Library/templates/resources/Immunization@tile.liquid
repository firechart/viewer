{% fhir_include "Immunization:patient" %}
{%- capture t0 -%}{% apply self.vaccineCode mode: "text" %}{%- endcapture -%}
{%- assign title = t0 | default: self.id -%}
{%- capture s0 -%}{% if self.occurrence %}{% apply self.occurrence mode: "text" %}{% endif %}{%- endcapture -%}
{%- capture s1 -%}{% if self.lotNumber %}{{ "lot" | t }} {{ self.lotNumber }}{% endif %}{%- endcapture -%}
{%- capture subtitle -%}{% render "parts", p1: s0, p2: s1 %}{%- endcapture -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% render "tile-row", title: title, subtitle: subtitle, status: status, patient: self.patient, encounter: self.encounter, at: self.occurrence %}
