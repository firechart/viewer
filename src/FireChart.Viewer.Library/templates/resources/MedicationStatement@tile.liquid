{% fhir_include "MedicationStatement:subject" %}
{% fhir_include "MedicationStatement:context" %}
{%- assign dose = self.dosage | as_list | first -%}
{%- capture t0 -%}{% apply self.medication mode: "text" %}{%- endcapture -%}
{%- assign title = t0 | default: self.id -%}
{%- capture s0 -%}{% if dose %}{{ dose.text }}{% endif %}{%- endcapture -%}
{%- capture s1 -%}{% if self.effective %}{% apply self.effective mode: "text" %}{% endif %}{%- endcapture -%}
{%- capture subtitle -%}{% render "parts", p1: s0, p2: s1 %}{%- endcapture -%}
{%- assign visit = self.context | default: self.encounter -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% render "tile-row", title: title, subtitle: subtitle, status: status, patient: self.subject, encounter: visit, at: self.effective %}
