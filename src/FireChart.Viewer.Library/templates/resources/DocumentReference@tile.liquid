{% fhir_include "DocumentReference:subject" %}
{% fhir_include "DocumentReference:author" %}
{% fhir_include "DocumentReference:encounter" %}
{%- assign au = self.author | as_list | first -%}{%- assign ds = self.docStatus | append: "" -%}
{%- capture t0 -%}{{ self.description }}{%- endcapture -%}
{%- capture t1 -%}{% apply self.type mode: "text" %}{%- endcapture -%}
{%- assign title = t0 | default: t1 | default: self.id -%}
{%- capture s0 -%}{% if self.date %}{{ self.date | fhir_date }}{% endif %}{%- endcapture -%}
{%- capture s1 -%}{% if au %}{% apply au mode: "text" %}{% endif %}{%- endcapture -%}
{%- capture subtitle -%}{% render "parts", p1: s0, p2: s1 %}{%- endcapture -%}
{%- assign visit = self.context.encounter | default: self.context -%}
{%- capture trailing -%}{% if ds != "" %}{% render "status-badge", code: ds %}{% endif %}{%- endcapture -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% render "tile-row", title: title, subtitle: subtitle, trailing: trailing, status: status, patient: self.subject, encounter: visit, at: self.date %}
