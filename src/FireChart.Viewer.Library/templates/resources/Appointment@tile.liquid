{%- assign svc = self.serviceType | as_list | first -%}{%- assign n = self.participant | as_list | size -%}
{%- capture t0 -%}{{ self.description }}{%- endcapture -%}
{%- capture t1 -%}{% if svc %}{% apply svc mode: "text" %}{% endif %}{%- endcapture -%}
{%- capture t2 -%}{% apply self.appointmentType mode: "text" %}{%- endcapture -%}
{%- assign title = t0 | default: t1 | default: t2 | default: self.id -%}
{%- capture s0 -%}{% if self.start %}{{ self.start | fhir_date }}{% endif %}{%- endcapture -%}
{%- capture s1 -%}{% if n > 0 %}{{ "{{count}} participants" | t: count: n }}{% endif %}{%- endcapture -%}
{%- capture subtitle -%}{% render "parts", p1: s0, p2: s1 %}{%- endcapture -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% render "tile-row", title: title, subtitle: subtitle, status: status, patient: nil, encounter: nil, at: nil %}
