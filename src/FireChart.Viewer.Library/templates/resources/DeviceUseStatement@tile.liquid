{% fhir_include "DeviceUseStatement:subject" %}
{% fhir_include "DeviceUseStatement:device" %}
{%- capture title -%}{% apply self mode: "text" %}{%- endcapture -%}
{%- assign title = title | default: self.id -%}
{%- capture s0 -%}{% if self.timing %}{% apply self.timing mode: "text" %}{% elsif self.recordedOn %}{{ self.recordedOn | fhir_date }}{% endif %}{%- endcapture -%}
{%- capture s1 -%}{% if self.bodySite %}{% apply self.bodySite mode: "text" %}{% endif %}{%- endcapture -%}
{%- capture subtitle -%}{% render "parts", p1: s0, p2: s1 %}{%- endcapture -%}
{%- assign at = self.timing | default: self.recordedOn -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% render "tile-row", title: title, subtitle: subtitle, status: status, patient: self.subject, encounter: nil, at: at %}
