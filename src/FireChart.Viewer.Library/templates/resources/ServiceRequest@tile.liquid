{% fhir_include "ServiceRequest:subject" %}
{% fhir_include "ServiceRequest:requester" %}
{% fhir_include "ServiceRequest:encounter" %}
{%- assign pr = self.priority | append: "" -%}
{%- capture t0 -%}{% apply self.code mode: "text" %}{%- endcapture -%}
{%- assign title = t0 | default: self.id -%}
{%- capture s0 -%}{% if self.authoredOn %}{{ self.authoredOn | fhir_date }}{% endif %}{%- endcapture -%}
{%- capture s1 -%}{% apply self.requester mode: "text" %}{%- endcapture -%}
{%- capture subtitle -%}{% render "parts", p1: s0, p2: s1 %}{%- endcapture -%}
{%- capture trailing -%}{% if pr != "" and pr != "routine" %}{% render "status-badge", code: pr %}{% endif %}{%- endcapture -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% render "tile-row", title: title, subtitle: subtitle, trailing: trailing, status: status, patient: self.subject, encounter: self.encounter, at: self.authoredOn %}
