{%- capture t0 -%}{{ self.title }}{%- endcapture -%}
{%- capture t1 -%}{% apply self.type mode: "text" %}{%- endcapture -%}
{%- assign title = t0 | default: t1 | default: self.id -%}
{%- capture s0 -%}{% if self.issued %}{{ self.issued | fhir_date }}{% endif %}{%- endcapture -%}
{%- capture s1 -%}{% if self.applies %}{% apply self.applies mode: "text" %}{% endif %}{%- endcapture -%}
{%- capture subtitle -%}{% render "parts", p1: s0, p2: s1 %}{%- endcapture -%}
{%- capture status -%}{% render "status-badge", code: self.status %}{%- endcapture -%}
{% render "tile-row", title: title, subtitle: subtitle, status: status, patient: nil, encounter: nil, at: nil %}
