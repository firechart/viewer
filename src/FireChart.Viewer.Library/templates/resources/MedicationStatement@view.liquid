{% fhir_include "MedicationStatement:subject" %}
{% fhir_include "MedicationStatement:source" %}
{% fhir_include "MedicationStatement:medication" %}

{%- assign doses = self.dosage | as_list -%}{%- assign notes = self.note | as_list -%}
{%- assign patient = self.subject | resolve -%}
{%- render "view-header", patient: patient, subject: self.subject, own: "MedicationStatement" %}

<div class="fx-title">
  <h2 class="fx-title-text">{% apply self.medication mode: "link,text" -%}</h2>

  <div class="fx-banner-facts">
    {%- if self.effective %}
    <span>{% apply self.effective mode: "text" -%}</span>
    {%- endif %}
    {%- if self.dateAsserted %}
    <span>{{ "Asserted" | t }} {% apply self.dateAsserted mode: "text" -%}</span>
    {%- endif %}
  </div>

  <div class="fx-banner-flags">
    {%- render "status-badge", code: self.status -%}
  </div>
</div>

{%- if self.informationSource or self.category or self.reasonCode or self.reasonReference or self.basedOn %}
<section class="fx-section">
  <h3 class="fx-section-title">{{ "Details" | t }}</h3>
  {% render "field", label: "Source", node: self.informationSource %}
  {% render "field", label: "Category", node: self.category, mode: "text" %}
  {% render "field", label: "Reason", node: self.reasonCode, mode: "text" %}
  {% render "field", label: "Reason", node: self.reasonReference %}
  {% render "field", label: "Based on", node: self.basedOn %}
</section>
{%- endif %}

{%- if doses.size > 0 %}
<section class="fx-section">
  <h3 class="fx-section-title">{{ "Dosage" | t }}</h3>
  {%- for d in doses %}
  <div class="fx-row"><span class="fx-row-main">{{ d.text }}</span></div>
  {%- endfor %}
</section>
{%- endif %}

{%- if notes.size > 0 %}
<section class="fx-section">
  <h3 class="fx-section-title">{{ "Notes" | t }}</h3>
  {%- for n in notes %}
  <div class="fx-row"><span class="fx-row-main">{% apply n mode: "text" -%}</span></div>
  {%- endfor %}
</section>
{%- endif %}
