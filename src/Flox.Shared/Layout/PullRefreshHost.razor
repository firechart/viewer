@using Flox.Shared.Errors
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PullRefreshTargets Targets
@inject IUiExceptionHandler UiErrors

@* A pull down at the top of the page on a touch screen refreshes what the page shows (PullRefreshTargets), never the browser page *@
<div @ref=@_indicator data-pull aria-hidden="true" class="flex h-0 items-center justify-center overflow-hidden text-muted">
    <FloxIcon Icon="refresh" Size="1.5rem"/>
</div>

@code {

    private ElementReference _indicator;
    private IJSObjectReference? _module;
    private IJSObjectReference? _gesture;
    private DotNetObjectReference<PullRefreshHost>? _self;
    private bool _disposed;

    protected override void OnInitialized()
    {
        Targets.Changed += OnTargetsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.ImportModuleAsync("./_content/Flox.Shared/Layout/PullRefreshHost.razor.js");
        if (_disposed)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        var gesture = await _module.InvokeAsync<IJSObjectReference>("attach", _indicator, _self, Targets.Any);
        if (_disposed)
        {
            await gesture.InvokeVoidAsync("dispose");
            await gesture.DisposeAsync();
            return;
        }

        _gesture = gesture;
    }

    [JSInvokable]
    public async Task OnPull()
    {
        await UiErrors.TryAsync(Targets.RefreshAsync, nameof(OnPull));
    }

    private void OnTargetsChanged(object? sender, EventArgs e)
    {
        UiErrors.Fire(EnableAsync, nameof(OnTargetsChanged));
    }

    private async Task EnableAsync()
    {
        try
        {
            if (_gesture is not null && !_disposed)
            {
                await _gesture.InvokeVoidAsync("enable", Targets.Any);
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Targets.Changed -= OnTargetsChanged;
        try
        {
            if (_gesture is not null)
            {
                await _gesture.InvokeVoidAsync("dispose");
                await _gesture.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }

}
