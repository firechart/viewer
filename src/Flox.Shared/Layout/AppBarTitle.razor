@inject IFloxBrandingProvider Branding

<SectionContent SectionName="appbar-title">
    @* The heading of the page (FocusOnNavigate moves the focus to it); the headings of a page start at h2 *@
    @* A weight of its own (600), apart from the lighter semibold of the light theme (theme.css) *@
    <h1 class="m-0 truncate text-base font-[600]">
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            @Branding.App.Title
        }
    </h1>
</SectionContent>

<PageTitle>@Branding.App.Title → @ChildContent</PageTitle>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

}
