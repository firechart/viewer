@* A row of the menu of a page: what stands first (an icon by name, or Leading), the text, a short note at the end (a count); the menu closes after the click *@
<button type="button" role="menuitem" class="page-menu-item" title=@Text @onclick=@OnClickAsync>
    @if (Leading is not null)
    {
        @Leading
    }
    else if (Icon is not null)
    {
        <FloxIcon Icon=@Icon/>
    }
    <span class="page-menu-item-text">@Text</span>
    @if (!string.IsNullOrEmpty(Note))
    {
        <span class="page-menu-item-note">@Note</span>
    }
</button>

@code {

    [CascadingParameter]
    public PageMenu? Menu { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public RenderFragment? Leading { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public string? Note { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private async Task OnClickAsync()
    {
        if (Menu is not null)
        {
            await Menu.CloseAsync();
        }

        await OnClick.InvokeAsync();
    }

}
