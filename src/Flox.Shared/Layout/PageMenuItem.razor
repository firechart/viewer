@using BlazorBlueprint.Components

@* A command of a PageMenu: an icon (by name, or Leading), the text and a short note at the end (a count) *@
<BbDropdownMenuItem OnClick=@(() => OnClick.InvokeAsync()) Disabled=@Disabled @attributes=@Attributes>
    <Icon>
        @if (Leading is not null)
        {
            @Leading
        }
        else if (!string.IsNullOrEmpty(Icon))
        {
            <FloxIcon Icon=@Icon Size="1rem" Class="text-muted"/>
        }
    </Icon>
    <ChildContent>
        <span class="min-w-0 flex-1 truncate">@Text</span>
        @if (!string.IsNullOrEmpty(Note))
        {
            <BbDropdownMenuShortcut Class="ps-3">@Note</BbDropdownMenuShortcut>
        }
    </ChildContent>
</BbDropdownMenuItem>

@code {

    [Parameter]
    [EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public RenderFragment? Leading { get; set; }

    [Parameter]
    public string? Note { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? Attributes { get; set; }

}
