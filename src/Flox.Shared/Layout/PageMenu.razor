@using BlazorBlueprint.Components

@* A menu of commands (PageMenuItem, PageMenuSeparator) behind a button with an icon (the vertical ellipsis): in place, or in the outlet SectionName
   (the menu of a page in the header of a component that has its own, the Viewer). The menu closes when a command is picked *@
@if (SectionName is null)
{
    @Menu
}
else
{
    <SectionContent SectionName=@SectionName>@Menu</SectionContent>
}

@code {

    private bool _open;

    // The outlet of the menu; none: the menu stands where it is written
    [Parameter]
    public string? SectionName { get; set; }

    [Parameter]
    public string Icon { get; set; } = "more_vert";

    // The tooltip and the name of the button; "More" when not given
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private RenderFragment Menu => @<BbDropdownMenu @bind-Open=@_open>
                                       <BbDropdownMenuTrigger>
                                           <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" title=@(Title ?? Strings.Caption_More) AriaLabel=@(Title ?? Strings.Caption_More)
                                                   aria-haspopup="menu" aria-expanded=@(_open ? "true" : "false") data-page-menu>
                                               <FloxIcon Icon=@Icon/>
                                           </Button>
                                       </BbDropdownMenuTrigger>
                                       <BbDropdownMenuContent Align="BlazorBlueprint.Primitives.PopoverAlign.End" Class="max-h-[min(70vh,36rem)] min-w-56 overflow-y-auto print:hidden">
                                           @ChildContent
                                       </BbDropdownMenuContent>
                                   </BbDropdownMenu>;

}
