@using BlazorBlueprint.Components
@using System.Security.Claims
@inject IFloxShell Shell
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject Flox.Shared.Errors.IUiExceptionHandler Errors
@inject IFloxRuntime Runtime
@implements IDisposable

@foreach ((var menu, var nodes) in _menus)
{
    @* A plain, non-collapsible heading - menus are always expanded, no toggle; a menu without a title is set apart from the one above by a line *@
    @if (string.IsNullOrEmpty(menu.Text) && menu != _menus[0].Menu)
    {
        <BbSidebarSeparator/>
    }
    <BbSidebarGroup>
        @if (!string.IsNullOrEmpty(menu.Text))
        {
            <BbSidebarGroupLabel>@menu.Text</BbSidebarGroupLabel>
        }
        <BbSidebarGroupContent>
            <BbSidebarMenu>
                @foreach (var node in nodes)
                {
                    <NavMenuItem Node="node"/>
                }
            </BbSidebarMenu>
        </BbSidebarGroupContent>
    </BbSidebarGroup>
}

@if (_hasMore)
{
    <BbSidebarGroup>
        <BbSidebarGroupContent>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton Href=@AppUrl.ToHref(SharedRoutes.MORE) Match="NavLinkMatch.All">
                        <FloxIcon Icon="more_horiz"/>
                        <span>@Strings.Caption_More</span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
            </BbSidebarMenu>
        </BbSidebarGroupContent>
    </BbSidebarGroup>
}

@code {
    private List<(IFloxMenu Menu, List<NavMenuNode> Nodes)> _menus = [];
    private bool _hasMore;

    protected override async Task OnInitializedAsync()
    {
        await BuildAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    // Signed in or out: the items depend on the user and on what the server lets the user do
    private void OnAuthenticationStateChanged(Task<AuthenticationState> state)
    {
        Errors.Fire(async () =>
                    {
                        var user = (await state).User;
                        await InvokeAsync(async () =>
                        {
                            await BuildAsync(user);
                            StateHasChanged();
                        });
                    },
                    nameof(OnAuthenticationStateChanged));
    }

    private async Task BuildAsync(ClaimsPrincipal user)
    {
        _menus = await MenuFilter.BuildAsync(Shell, AuthorizationService, user, FloxMenuPlacement.Main);

        // One entry for everything that is placed on the More page: in a debug build under development only, and when there is something on it
        _hasMore = Flox.Shared.Host.SharedMenuSource.ShowsMore(Runtime) && (await MenuFilter.BuildAsync(Shell, AuthorizationService, user, FloxMenuPlacement.More)).Count > 0;
    }

}
