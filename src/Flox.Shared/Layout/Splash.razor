@inject IFloxBrandingProvider Branding

@* Two instances: Early is rendered by the server (static SSR) and is on the screen before Blazor starts; MainLayout renders the live one
   while the app initializes, which hides the early one; the early one stays hidden once the layout has set data-app-ready.
   The styles are _content/Flox.Shared/flox-splash.css, linked in the head of the host page *@

<div class="flox-splash @(Early ? "flox-splash-early" : "flox-splash-live")">
    <img class="flox-splash-logo" src="@Branding.App.Logo" alt=""/>
    <p class="flox-splash-message" role="status">@Message</p>
    <div class="flox-splash-progress" role="progressbar" aria-label=@Strings.Caption_Loading>
        <div class="flox-splash-bar"></div>
    </div>
</div>

@code {

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public bool Early { get; set; }

}
