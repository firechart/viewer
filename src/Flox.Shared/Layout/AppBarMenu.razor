@inject Radzen.ContextMenuService ContextMenuService
@implements IDisposable

<RadzenButton Variant="Radzen.Variant.Text" ButtonStyle="Radzen.ButtonStyle.Base" title=@Title aria-label=@Title
              aria-haspopup="menu" aria-expanded=@(_open ? "true" : "false") Click=@OpenAsync>
    <FloxIcon Icon=@Icon/>
</RadzenButton>

@code {

    [Parameter]
    public string Icon { get; set; } = "more_vert";

    [Parameter]
    public string? Title { get; set; }

    // RadzenMenuItem children; the menu closes when one is picked
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _open;

    protected override void OnInitialized()
    {
        ContextMenuService.OnClose += OnMenuClosed;
    }

    private void OpenAsync(MouseEventArgs args)
    {
        _open = true;
        ContextMenuService.Open(args,
                                _ => @<RadzenMenu Click=@(() => ContextMenuService.Close())>@ChildContent</RadzenMenu>);
    }

    private void OnMenuClosed()
    {
        if (_open)
        {
            _open = false;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        ContextMenuService.OnClose -= OnMenuClosed;
    }

}
