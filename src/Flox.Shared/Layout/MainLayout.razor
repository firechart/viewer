@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives
@using Flox.Shared.Errors
@using Flox.Shared.Extensions
@inherits LayoutComponentBase

<FloxThemeHost Dark=@_isDarkMode/>
@* The overlays of Blazor Blueprint (dialogs, popovers, menus), its programmatic dialogs and its toasts (the snackbar: bottom centre) *@
<BbPortalHost/>
<BbDialogProvider/>
<BbToastProvider Position="ToastPosition.BottomCenter"/>
<FloxDialogHost/>
<ConnectivityMonitor/>
<IdentityProviderMonitor/>

<AppErrorBoundary @ref=@_bodyErrorBoundary>
    <ChildContent>
        @if (_initializationException is not null)
        {
            @if (ConnectionErrors.IsConnectionLost(_initializationException))
            {
                <ConnectionLostDisplay Exception=@_initializationException OnRetry=@RetryInitialization/>
            }
            else
            {
                <ErrorDisplay Exception=@_initializationException OnRetry=@RetryInitialization ErrorBoundary=@_bodyErrorBoundary/>
            }
        }
        else if (_isLoading)
        {
            <Splash Message=@_progressMessage/>
        }
        else
        {
            @* The first stop of the keyboard: past the app bar and the menu to the page *@
            <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:start-2 focus:z-[1100] focus:rounded-md focus:bg-surface focus:px-3 focus:py-2 focus:text-ink focus:shadow-lg"
               @onclick=@SkipToContentAsync @onclick:preventDefault>@Strings.Caption_SkipToContent</a>
            @* The app bar across the whole width; under it the main menu at the side and the page next to it; the document scrolls *@
            <BbSidebarProvider id="main-layout" @key=_cultureVersion CookieKey="@null" class="flex min-h-dvh w-full flex-col">
                <AppBar/>
                <div class="flex flex-1">
                    <AppSidebar/>
                    @* min-w-0: a flex item beside the sidebar, it would otherwise grow to its widest content (a line of code not wrapped) and scroll the page *@
                    <BbSidebarInset Class="min-w-0">
                        <main id="main" tabindex="-1" class="p-[var(--flox-body-padding)] outline-none" @ref=_main>
                            <PullRefreshHost/>
                            <PageWidth>@Body</PageWidth>
                        </main>
                    </BbSidebarInset>
                </div>
            </BbSidebarProvider>

        }
    </ChildContent>

    <ErrorContent>
        <PageWidth>
            <ErrorDisplay Exception=@context OnRetry=@RetryInitialization ErrorBoundary=@_bodyErrorBoundary/>
        </PageWidth>
    </ErrorContent>
</AppErrorBoundary>

@if (_initializationException is not null || !_isLoading)
{
    <div hidden data-app-ready></div>
}


@code {

    private ElementReference _main;

    private async Task SkipToContentAsync()
    {
        try
        {
            await _main.FocusAsync();
        }
        catch (JSException)
        {
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
}
