@using BlazorBlueprint.Components

@if (Node.Children.Count == 0 && Node.Item.Href?.StartsWith(AppUrl.ServerRootPrefix, StringComparison.Ordinal) == true)
{
    @* A page of the server: the router must not take it, so it is a plain link that opens in its own window *@
    <BbSidebarMenuItem>
        <BbSidebarMenuButton Href=@AppUrl.ToHref(Node.Item.Href) target="_blank" rel="noopener" IsActive="false">
            <FloxIcon Icon=@Node.Item.Icon/>
            <span>@Node.Item.Text</span>
            <FloxIcon Icon="open_in_new" Size="1rem" Class="ms-auto text-muted"/>
        </BbSidebarMenuButton>
    </BbSidebarMenuItem>
}
else if (Node.Children.Count == 0)
{
    <BbSidebarMenuItem>
        <BbSidebarMenuButton Href=@AppUrl.ToHref(Node.Item.Href) Match="NavLinkMatch.All">
            <FloxIcon Icon=@Node.Item.Icon/>
            <span>@Node.Item.Text</span>
        </BbSidebarMenuButton>
    </BbSidebarMenuItem>
}
else
{
    @* A group: a button that opens and closes the items under it *@
    <BbCollapsible @bind-Open=@_open>
        <BbSidebarMenuItem>
            <BbCollapsibleTrigger>
                <BbSidebarMenuButton aria-expanded=@(_open ? "true" : "false")>
                    <FloxIcon Icon=@Node.Item.Icon/>
                    <span>@Node.Item.Text</span>
                    <FloxIcon Icon="chevron_right" Size="1rem" Class=@(_open ? "ms-auto rotate-90 transition-transform" : "ms-auto transition-transform rtl:-scale-x-100")/>
                </BbSidebarMenuButton>
            </BbCollapsibleTrigger>
            <BbCollapsibleContent>
                <BbSidebarMenuSub>
                    @foreach (var child in Node.Children)
                    {
                        <BbSidebarMenuSubItem>
                            <BbSidebarMenuSubButton Href=@AppUrl.ToHref(child.Item.Href) Match="NavLinkMatch.All">
                                <FloxIcon Icon=@child.Item.Icon/>
                                <span>@child.Item.Text</span>
                            </BbSidebarMenuSubButton>
                        </BbSidebarMenuSubItem>
                    }
                </BbSidebarMenuSub>
            </BbCollapsibleContent>
        </BbSidebarMenuItem>
    </BbCollapsible>
}

@code {

    private bool _open;

    [Parameter][EditorRequired]
    public NavMenuNode Node { get; set; } = null!;

}
