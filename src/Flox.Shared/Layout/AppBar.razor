@using BlazorBlueprint.Components
@using Microsoft.AspNetCore.Components.Sections
@inject INavigationHistoryService NavigationHistory
@inject IServiceProvider Services
@implements IDisposable

@* The bar on top of the page, across its whole width: back (or the main menu), the title, the commands and the menu of the page. As the navigation
   bar of iOS the title stands in the middle of the bar whatever is on its sides: the two sides are columns of one width; a title too long for the
   room between them is cut with an ellipsis *@
@* Above the overlay of the menu sheet (z-50): the button that opened it closes it *@
<header class="flox-app-bar sticky top-0 z-[60] grid h-[var(--flox-header-height)] shrink-0 grid-cols-[1fr_auto_1fr] items-center gap-1 border-b border-line bg-background px-2 text-foreground" role="banner">
    <div class="flex items-center justify-start">
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" OnClick=@OnLeadingButtonClick
                AriaLabel=@(_showBackButton ? Strings.Caption_Back : Strings.Caption_Menu)
                aria-expanded=@(_showBackButton ? null : MenuOpen ? "true" : "false") aria-controls=@(_showBackButton ? null : AppSidebar.Id)>
            <FloxIcon Icon=@(_showBackButton ? "arrow_back" : "menu") Class="rtl:-scale-x-100"/>
        </Button>
    </div>

    <div class="min-w-0 truncate text-center">
        <SectionOutlet SectionName="appbar-title"/>
    </div>

    <div class="flex items-center justify-end gap-1">
        <SectionOutlet SectionName="appbar-commands"/>

        @* The menu of the page (PageMenu); the account is the first item of the main menu *@
        <SectionOutlet SectionName="appbar-menu"/>
    </div>
    @* On the way to a page (NavigationProgress): a segment runs along the bottom edge, at once on Back and until the page has loaded. The track is
       always there and over the edge (absolute): nothing below moves when the progress starts or ends *@
    <div class="pointer-events-none absolute inset-x-0 -bottom-px h-0.5 overflow-hidden rtl:-scale-x-100" data-navigation-progress
         role=@(Progress?.Active == true ? "progressbar" : null) aria-label=@(Progress?.Active == true ? Strings.Caption_Loading : null)>
        @if (Progress?.Active == true)
        {
            <div class="h-full w-2/5 animate-navigation-progress bg-primary motion-reduce:w-full motion-reduce:animate-pulse"></div>
        }
    </div>
</header>

@code {

    [Parameter]
    public bool BackButton { get; set; } = false;

    [Parameter]
    public EventCallback BackRequested { get; set; }

    bool _showBackButton;

    [CascadingParameter]
    private SidebarContext? Sidebar { get; set; }

    private bool MenuOpen => Sidebar is not null && (Sidebar.IsMobile ? Sidebar.OpenMobile : Sidebar.Open);

    protected override void OnInitialized()
    {
        NavigationHistory.HistoryChanged += OnHistoryChanged;
        if (Progress is { } progress)
        {
            progress.Changed += OnProgressChanged;
        }

        UpdateBackButtonVisibility();
        base.OnInitialized();
    }

    private void OnHistoryChanged(object? sender, EventArgs e)
    {
        UpdateBackButtonVisibility();
        InvokeAsync(StateHasChanged);
    }

    private NavigationProgress? Progress => _progress ??= Services.GetService<NavigationProgress>();

    private NavigationProgress? _progress;

    private void OnProgressChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void UpdateBackButtonVisibility()
    {
        _showBackButton = NavigationHistory.CanGoBack;
    }

    private void OnLeadingButtonClick()
    {
        if (_showBackButton)
        {
            Progress?.Start();
            NavigationHistory.GoBack();
        }
        else
        {
            DrawerToggle();
        }
    }

    void DrawerToggle()
    {
        Sidebar?.ToggleSidebar();
    }

    public void Dispose()
    {
        NavigationHistory.HistoryChanged -= OnHistoryChanged;
        if (_progress is not null)
        {
            _progress.Changed -= OnProgressChanged;
        }
    }

}
