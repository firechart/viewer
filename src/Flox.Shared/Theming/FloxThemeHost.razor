@using Flox.Shared.Settings
@inject IJSRuntime JS
@inject Radzen.ThemeService RadzenThemes
@implements IAsyncDisposable

@* The Radzen base theme is switched through its service; data-theme drives the FloxWind overlay and the dark: variant *@
<RadzenTheme Theme=@_initialTheme/>

@code {
    private string? _initialTheme;
    private string? _currentTheme;
    private bool? _appliedDark;
    private IJSObjectReference? _colorScheme;

    private const string ColorSchemeModule = "./_content/Flox.Shared/flox-color-scheme.js";

    [Parameter]
    public bool Dark { get; set; } = ThemeSettings.DEFAULT_DARK;

    protected override void OnParametersSet()
    {
        var name = ThemeService.ThemeName(Dark);
        _initialTheme ??= name;

        if (_currentTheme is not null && _currentTheme != name)
        {
            RadzenThemes.SetTheme(name);
        }

        _currentTheme = name;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_appliedDark != Dark)
        {
            _appliedDark = Dark;
            await JS.InvokeVoidAsync("document.documentElement.setAttribute", "data-theme", Dark ? "dark" : "light");
            // The bar of the browser and of the installed window takes the colour of the bar of the application in the new theme
            _colorScheme ??= await JS.ImportModuleAsync(ColorSchemeModule);
            await _colorScheme.InvokeVoidAsync("syncThemeColor");
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_colorScheme is not null)
        {
            try
            {
                await _colorScheme.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // the page is gone
            }
        }
    }

}
