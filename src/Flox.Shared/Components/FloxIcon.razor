@if (!string.IsNullOrWhiteSpace(Icon))
{
    <RadzenIcon Icon=@Icon IconColor=@Color Style=@GetFontStyle() class=@($"shrink-0 {Class}") title=@Title/>
}

@code {

    /// <summary>
    /// Name of a Material Symbols icon, drawn by the icon font (Flox Symbols, app.css).
    /// </summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>
    /// Color of the icon (any CSS color); the color of the text when not set.
    /// </summary>
    [Parameter]
    public string? Color { get; set; }

    /// <summary>
    /// Size of the icon (any CSS length); the size of the theme when not set.
    /// </summary>
    [Parameter]
    public string? Size { get; set; }

    /// <summary>
    /// Whether the icon is drawn filled (the axis FILL of the font).
    /// </summary>
    [Parameter]
    public bool Filled { get; set; }

    /// <summary>
    /// Extra CSS classes of the icon.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Tooltip of the icon.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    private string? GetFontStyle()
    {
        var style = string.Empty;
        if (!string.IsNullOrEmpty(Size))
        {
            style += $"font-size: {Size};";
        }

        if (Filled)
        {
            style += "font-variation-settings: 'FILL' 1;";
        }

        return style.Length == 0 ? null : style;
    }

}
