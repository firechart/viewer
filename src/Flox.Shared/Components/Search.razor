@using BlazorBlueprint.Components
@implements IDisposable
@inject BlazorBlueprint.Primitives.Services.IKeyboardShortcutService Shortcuts

@* The search box of a list. With SlashFocuses, the key / puts the focus into it from anywhere on the page but a field, and the empty box shows that
   key at its end (not on a touch screen, which has no keyboard), as on GitHub *@

<BbInputGroup Class="w-full" role="search">
    <BbInputGroupAddon>
        <FloxIcon Icon="search" Size="1.25rem" Class="text-muted"/>
    </BbInputGroupAddon>
    <BbInputGroupInput @ref=_input Type="InputType.Search"
                       Value=@_value
                       UpdateTiming="UpdateTiming.Immediate"
                       Placeholder=@Placeholder
                       ValueChanged=@OnInput
                       AriaLabel=@Placeholder
                       enterkeyhint="search"
                       autofocus=@AutoFocus
                       @onkeydown=@KeyDownAsync/>
    @if (SlashFocuses && string.IsNullOrEmpty(_value))
    {
        <BbInputGroupAddon Align="InputGroupAlign.InlineEnd" Class="pointer-coarse:hidden" aria-hidden="true">
            <BbKbd>/</BbKbd>
        </BbInputGroupAddon>
    }
    @if (!string.IsNullOrEmpty(_value))
    {
        <BbInputGroupAddon Align="InputGroupAlign.InlineEnd">
            <BbInputGroupButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" OnClick=@ClearAsync AriaLabel=@Strings.Caption_Clear title=@Strings.Caption_Clear>
                <FloxIcon Icon="close" Size="1rem"/>
            </BbInputGroupButton>
        </BbInputGroupAddon>
    }
</BbInputGroup>

@code {
    private CancellationTokenSource? _debounce;
    private string? _value;
    private BbInputGroupInput? _input;
    private IDisposable? _slash;
    private bool _disposed;

    // The key / focuses the box; one box of a page asks for it
    [Parameter]
    public bool SlashFocuses { get; set; }

    [Parameter]
    public bool AutoFocus { get; set; } = false;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = Strings.Caption_Filter;

    [Parameter]
    public int DebounceInterval { get; set; } = 500;

    // The Enter that confirms a candidate of an input method (Chinese, Japanese, Korean) is not the Enter of the box: it never reaches OnKeyDown
    private Task KeyDownAsync(KeyboardEventArgs args)
    {
        return args.Key == "Enter" && args.IsComposing ? Task.CompletedTask : OnKeyDown.InvokeAsync(args);
    }

    protected override void OnParametersSet()
    {
        _value = Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && SlashFocuses)
        {
            _slash = await Shortcuts.RegisterAsync("/", FocusAsync);
            if (_disposed)
            {
                _slash.Dispose();
            }
        }
    }

    private async Task FocusAsync()
    {
        if (_input is not null)
        {
            await _input.FocusAsync();
        }
    }

    private async Task OnInput(string? text)
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;

        try
        {
            await Task.Delay(DebounceInterval, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        _value = text;
        await ValueChanged.InvokeAsync(text);
    }

    private async Task ClearAsync()
    {
        _debounce?.Cancel();
        _value = null;
        await ValueChanged.InvokeAsync(null);
    }

    public void Dispose()
    {
        _disposed = true;
        _slash?.Dispose();
        _debounce?.Cancel();
        _debounce?.Dispose();
    }

}
