@* A heading of the given level, h1 to h6 *@
@switch (Math.Clamp(Level, 1, 6))
{
    case 1:
        <h1 class=@Class>@ChildContent</h1>
        break;
    case 2:
        <h2 class=@Class>@ChildContent</h2>
        break;
    case 3:
        <h3 class=@Class>@ChildContent</h3>
        break;
    case 4:
        <h4 class=@Class>@ChildContent</h4>
        break;
    case 5:
        <h5 class=@Class>@ChildContent</h5>
        break;
    default:
        <h6 class=@Class>@ChildContent</h6>
        break;
}

@code {

    [Parameter]
    public int Level { get; set; } = 2;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

}
