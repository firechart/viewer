@using BlazorBlueprint.Components
@* An indeterminate circular indicator in the color of the text, for a load of unknown length *@
<BbSpinner Size=@(Compact ? SpinnerSize.Small : SpinnerSize.Default) Class="text-muted"/>

@code {

    // Smaller, for a line of text or a button
    [Parameter]
    public bool Compact { get; set; }

}
