@* Its content only while the browser offers to install the application: not on a platform that cannot (Safari, Firefox), not when it is installed.
   The host page loads _content/Flox.Shared/flox-install.js in its head, else the offer comes before the component and nothing is shown *@
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (_available)
{
    @ChildContent(InstallAsync)
}

@code {

    private bool _available;
    private bool _disposed;
    private IJSObjectReference? _module;
    private IJSObjectReference? _watch;
    private DotNetObjectReference<AppInstall>? _self;

    // Given the action that starts the installation
    [Parameter]
    [EditorRequired]
    public RenderFragment<Func<Task>> ChildContent { get; set; } = _ => _ => { };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.ImportModuleAsync("./_content/Flox.Shared/Components/AppInstall.razor.js");
            if (_disposed || _module is null)
            {
                return;
            }

            _self = DotNetObjectReference.Create(this);
            var watch = await _module.InvokeAsync<IJSObjectReference?>("watch", _self);
            if (_disposed && watch is not null)
            {
                await watch.InvokeVoidAsync("dispose");
                await watch.DisposeAsync();
                return;
            }

            _watch = watch;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
            // no offer: the content stays hidden
        }
    }

    /// <summary>Called by the script when the browser starts or stops offering the installation.</summary>
    [JSInvokable]
    public void SetAvailable(bool available)
    {
        _available = available;
        StateHasChanged();
    }

    private async Task InstallAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("install");
        }
        catch (JSException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_watch is not null)
            {
                await _watch.InvokeVoidAsync("dispose");
                await _watch.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }

}
