@inject NavigationManager Navigation

@if (Loading)
{
    @* The crumbs are made when the page has loaded: a bar of the same height meanwhile, not the crumbs of the previous page *@
    <RadzenSkeleton class="rz-my-1 rz-mx-2" Style="width: 16rem; max-width: 80%; height: 1.25rem"/>
}
else if (Visible.Count > 0)
{
    <RadzenBreadCrumb class="rz-my-1 max-w-full overflow-x-auto rz-px-2 text-xs [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [&>.rz-breadcrumb-list]:flex-nowrap [&_.rz-breadcrumb-item]:shrink-0 [&_.rz-breadcrumb-item]:whitespace-nowrap" @attributes="UserAttributes">
        @foreach (var item in Visible.Select((value, index) => (value, last: index == Visible.Count - 1)))
        {
            <RadzenBreadCrumbItem>
                @if (item.last || string.IsNullOrEmpty(item.value.Href))
                {
                    <span class="inline-flex items-center gap-1">
                        @if (item.value.Icon != FloxMenuItem.NullIcon)
                        {
                            <FloxIcon Icon=@item.value.Icon Size="1rem"/>
                        }
                        @item.value.Text
                    </span>
                }
                else
                {
                    <a href=@AppUrl.ToHref(item.value.Href) class="inline-flex items-center gap-1 text-inherit no-underline">
                        @if (item.value.Icon != FloxMenuItem.NullIcon)
                        {
                            <FloxIcon Icon=@item.value.Icon Size="1rem"/>
                        }
                        @item.value.Text
                    </a>
                }
            </RadzenBreadCrumbItem>
        }
    </RadzenBreadCrumb>
}

@code {

    // Inside a frame a crumb is shown when it leads to a page of the frame or is plain text (the name of the server, which the page must not hide)
    private IReadOnlyList<IFloxMenuItem> Visible
    {
        get
        {
            var items = Items.ToList();
            return Navigation.IsEmbedded() ? items.Where((item, index) => index == items.Count - 1 || string.IsNullOrEmpty(item.Href) || EmbeddedMode.IsEmbeddedRoute(item.Href)).ToList() : items;
        }
    }

    [Parameter]
    [EditorRequired]
    public IReadOnlyCollection<IFloxMenuItem> Items { get; set; } = [];

    // The page is loading: a skeleton instead of the crumbs
    [Parameter]
    public bool Loading { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> UserAttributes { get; set; } = [];

}
