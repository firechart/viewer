@using BlazorBlueprint.Components
@if (Loading)
{
    @* The crumbs are made when the page has loaded: a bar of the same height meanwhile, not the crumbs of the previous page *@
    <BbSkeleton Class="mx-3 my-px h-5 w-64 max-w-[80%]"/>
}
else if (Items.Count > 0)
{
    @* The crumbs of the pages above (Breadcrumb of Blueprint): the page itself is its title, not a crumb. A path wider than the page is swiped
       sideways; a crumb is 28 px high for a finger *@
    <BbBreadcrumb Class="-mt-1.5 overflow-x-auto overscroll-x-contain px-3 [scrollbar-width:none] [&>ol]:flex-nowrap" aria-label=@Strings.Caption_Path @attributes="UserAttributes">
        @* The separators are placed here: AutoSeparator of Blueprint 4.2 draws an empty one (its default chevron is lost) *@
        <BbBreadcrumbList>
            @foreach (var (item, index) in Items.Select((item, index) => (item, index)))
            {
                @if (index > 0)
                {
                    <BbBreadcrumbSeparator/>
                }
                <BbBreadcrumbItem Class="shrink-0 whitespace-nowrap" data-crumb>
                    <BbBreadcrumbLink Href=@(string.IsNullOrEmpty(item.Href) ? null : AppUrl.ToHref(item.Href)) Class="inline-flex items-center gap-1 py-1.5">@Content(item)</BbBreadcrumbLink>
                </BbBreadcrumbItem>
            }
        </BbBreadcrumbList>
    </BbBreadcrumb>
}

@code {

    // The pages above this one, the first is home; the page itself is its title, not a crumb
    [Parameter]
    [EditorRequired]
    public IReadOnlyCollection<IFloxMenuItem> Items { get; set; } = [];

    // The page is loading: a skeleton instead of the crumbs
    [Parameter]
    public bool Loading { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?> UserAttributes { get; set; } = [];

    private static RenderFragment Content(IFloxMenuItem item)
    {
        return @<text>
                   @if (item.Icon != FloxMenuItem.NullIcon)
                   {
                       <FloxIcon Icon=@item.Icon Size="1rem"/>
                   }
                   @if (!string.IsNullOrEmpty(item.Text))
                   {
                       <span>@item.Text</span>
                   }
               </text>;
    }

}
