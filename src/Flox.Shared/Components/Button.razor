@using BlazorBlueprint.Components
@* The button of the application: a BbButton of the small sizes (Default is Small, Icon is IconSmall), so every button is as compact as the rest.
   With IconName and Text it is an icon and a text, and only the icon where its container is narrow (a Heading is one, under 28rem): the text then
   stays for a reader and in the tooltip *@
<BbButton Variant=@Variant Size=@SmallSize Type=@Type Disabled=@Disabled Class=@CssClass OnClick=@OnClick AriaLabel=@AriaLabel Icon=@Icon
          IconPosition=@IconPosition Loading=@Loading LoadingText=@LoadingText Href=@Href Target=@Target title=@Title @attributes=@Attributes>
    @if (Text is not null)
    {
        @if (IconName is not null)
        {
            <FloxIcon Icon=@IconName/>
        }
        <span class=@(IconName is null ? null : "@max-md:sr-only")>@Text</span>
    }
    @ChildContent
</BbButton>

@code {

    // An icon with a text that may hide: square when only the icon shows
    private string? CssClass => IconName is not null && Text is not null ? $"@max-md:w-9 @max-md:px-0 {Class}".Trim() : Class;

    // The tooltip of a button whose text may hide is its text, unless the page gave one
    private string? Title => IconName is not null && Text is not null && Attributes?.ContainsKey("title") != true ? Text : null;

    private ButtonSize SmallSize => Size switch
    {
        ButtonSize.Default => ButtonSize.Small,
        ButtonSize.Icon => ButtonSize.IconSmall,
        _ => Size
    };

    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Default;

    // Default and Icon are drawn small; Large stays large where a page asks for it
    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Default;

    [Parameter]
    public ButtonType Type { get; set; } = ButtonType.Button;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public RenderFragment? Icon { get; set; }

    [Parameter]
    public IconPosition IconPosition { get; set; } = IconPosition.Start;

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public string? LoadingText { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? Target { get; set; }

    // The text of the button, after IconName; hidden where the container is narrow when there is an icon
    [Parameter]
    public string? Text { get; set; }

    // The name of the FloxIcon before Text
    [Parameter]
    public string? IconName { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? Attributes { get; set; }

}
