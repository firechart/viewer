@using BlazorBlueprint.Components
@using System.Numerics
@typeparam T where T : struct, INumber<T>

<div class="flex items-center gap-4" style=@Style>
    <span class="min-w-8 text-sm tabular-nums">@_value</span>
    <BbSlider Value=@double.CreateChecked(_value) ValueChanged=@OnValueChanged Min=@double.CreateChecked(Min) Max=@double.CreateChecked(Max) Step=@double.CreateChecked(Step)
              Disabled=@Disabled aria-label=@Label Class="min-w-32 flex-1"/>
</div>

@code {

    [Parameter][EditorRequired]
    public T Value { get; set; }

    [Parameter]
    public EventCallback<T> ValueChanged { get; set; }

    [Parameter]
    public T Min { get; set; }

    [Parameter]
    public T Max { get; set; }

    [Parameter]
    public T Step { get; set; } = T.One;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Style { get; set; }

    // The accessible name of the handle: the caption the slider stands under
    [Parameter]
    public string? Label { get; set; }

    private T _value;

    protected override void OnParametersSet()
    {
        _value = Value;
    }

    private async Task OnValueChanged(double newValue)
    {
        _value = T.CreateChecked(Math.Round(newValue));
        await ValueChanged.InvokeAsync(_value);
    }

}
