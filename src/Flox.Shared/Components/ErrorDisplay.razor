@using System.Globalization
@using System.Text
@using BlazorBlueprint.Components
@using Flox.Shared.Layout
@using Flox.Shared.Services
@inject IFloxRuntime Runtime
@inject NavigationManager Navigation
@inject ShareService Share
@inject FloxSnackbar Notifications

@* Rendered in place of what failed: an alert (role alert), so a screen reader tells it at once; Home loads the page again, which leaves the broken state.
   The details (the message and the stack) fold: open at once for those who debug (Administrator, Developer, development), behind Show details for the
   others; Copy and Share hand the diagnostic text to the support *@
<div class="mx-auto w-full max-w-2xl">
    <Alert Kind="AlertKind.Danger" Title=@Strings.Caption_Error>
        <p class="m-0">@Strings.Caption_ErrorNotification</p>
        @if (Reference is { } reference)
        {
            <p class="m-0 text-xs">@string.Format(CultureInfo.CurrentCulture, Strings.Error_Reference, reference)</p>
        }
        @if (Exception is not null)
        {
            <BbCollapsible @bind-Open=_expanded>
                <BbCollapsibleContent>
                    <p class="m-0 mt-2 break-words">@Exception.Message</p>
                    <StackTraceView Trace=@Exception.StackTrace/>
                </BbCollapsibleContent>
            </BbCollapsible>
        }
        <div class="mt-2 flex flex-wrap items-center gap-2">
            @if (Exception is not null)
            {
                <Button Variant="ButtonVariant.Outline" OnClick=@(() => _expanded = !_expanded) aria-expanded=@(_expanded ? "true" : "false")>
                    @(_expanded ? Strings.Caption_HideDetails : Strings.Caption_ShowDetails)
                </Button>
            }
            <Button Variant="ButtonVariant.Outline" OnClick=@CopyAsync>@Strings.Caption_Copy</Button>
            @if (_canShare)
            {
                <Button Variant="ButtonVariant.Outline" OnClick=@ShareAsync>@Strings.Caption_Share</Button>
            }
            <span class="flex-1"></span>
            <Button Variant="ButtonVariant.Outline" OnClick=@GoHome>@Strings.Caption_Home</Button>
            <Button OnClick="@RecoverAsync">@Strings.Caption_Retry</Button>
        </div>
    </Alert>
</div>

@code {

    private bool _expanded;
    private bool _canShare;
    private Exception? _shown;

    [Parameter]
    public Exception? Exception { get; set; }

    // Passed so we can reset the framework's own boundary state (ErrorBoundary.Recover())
    // in addition to - or instead of - a caller-supplied retry action.
    [Parameter]
    public ErrorBoundary? ErrorBoundary { get; set; }

    // Optional: when set, Retry runs this (e.g. MainLayout re-running its own
    // initialization) instead of just clearing the boundary.
    [Parameter]
    public EventCallback OnRetry { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string? Reference => ErrorBoundary is AppErrorBoundary { CorrelationId: { } reference } ? reference : null;

    protected override async Task OnParametersSetAsync()
    {
        // Folded or not once per failure; the user's choice stays while it is shown
        if (ReferenceEquals(_shown, Exception))
        {
            return;
        }

        _shown = Exception;
        _expanded = Runtime.IsDevelopment;
        if (!_expanded && AuthenticationState is not null)
        {
            try
            {
                _expanded = (await AuthenticationState).User.CanSeeErrorDetails();
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                // the state of the sign-in failed too: folded
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _canShare = await Share.PrepareAsync();
            }
            catch (JSException)
            {
                _canShare = false;
            }

            if (_canShare)
            {
                StateHasChanged();
            }
        }
    }

    // What the support needs: the reference, when and where, the exception with its inner ones and their stacks
    private string DiagnosticText()
    {
        var text = new StringBuilder();
        text.AppendLine(Strings.Caption_Error);
        if (Reference is { } reference)
        {
            text.AppendLine(CultureInfo.InvariantCulture, $"Reference: {reference}");
        }

        text.AppendLine(CultureInfo.InvariantCulture, $"Time: {DateTimeOffset.UtcNow:yyyy-MM-dd HH:mm:ss} UTC");
        text.AppendLine(CultureInfo.InvariantCulture, $"Page: {Navigation.Uri}");
        if (Exception is not null)
        {
            text.AppendLine();
            text.AppendLine(Exception.ToString());
        }

        return text.ToString();
    }

    private async Task CopyAsync()
    {
        var copied = await Share.CopyAsync(DiagnosticText());
        Notifications.Show(copied ? Strings.Message_Copied : Strings.Message_NotCopied, copied ? SnackSeverity.Info : SnackSeverity.Warning, 2000);
    }

    // Where the dialog of the system could not open, the text goes to the clipboard
    private async Task ShareAsync()
    {
        if (await Share.ShareAsync(Strings.Caption_Error, DiagnosticText()) is ShareResult.Failed or ShareResult.Unsupported)
        {
            await CopyAsync();
        }
    }

    private void GoHome()
    {
        Navigation.NavigateToRoute("/", true);
    }

    private async Task RecoverAsync()
    {
        if (OnRetry.HasDelegate)
        {
            await OnRetry.InvokeAsync();
        }
        else
        {
            ErrorBoundary?.Recover();
        }
    }

}
