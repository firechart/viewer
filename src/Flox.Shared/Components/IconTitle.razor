<div class="mb-3 flex items-center gap-2">
    <FloxIcon Icon=@Icon Color=@IconColor/>
    <span class="text-base font-semibold">@Text</span>
</div>

@code {

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? IconColor { get; set; }

    [Parameter]
    public string? Text { get; set; }

}
