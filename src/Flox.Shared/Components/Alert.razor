@* An alert of Flox over the BbAlert of Blazor Blueprint. OneTime: shown once on this device, then never again (the mark is kept by ILocalDocumentStore, SQLite; with no store, or
   when it fails, the alert is shown every time). It is marked when it is shown, and has the close button. Plain: a grey plate without the colour of its
   kind, for a note the user reads once *@
@using BlazorBlueprint.Components
@inject IServiceProvider Services

@if (_visible)
{
    <BbAlert Variant=@BbVariant Dismissible=@(AllowClose || OneTime) OnDismiss=@CloseAsync Class=@CssClass style=@Style @attributes=@Attributes>
        <Icon>
            @if (ShowIcon && !Plain)
            {
                @* Blueprint places an svg in the corner; the icon of the font is placed the same way *@
                <FloxIcon Icon=@(Icon ?? DefaultIcon) Size="1rem" Class="absolute start-4 top-4"/>
            }
        </Icon>
        <ChildContent>
            @if (!string.IsNullOrEmpty(Title))
            {
                <BbAlertTitle>@Title</BbAlertTitle>
            }
            <BbAlertDescription>@ChildContent</BbAlertDescription>
        </ChildContent>
    </BbAlert>
}

@code {

    // The collection of the marks of the one-time alerts on the device
    public const string Collection = "FloxShownAlert";

    private bool _visible;
    private string? _checkedKey;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public AlertKind Kind { get; set; } = AlertKind.Info;

    [Parameter]
    public bool AllowClose { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public bool ShowIcon { get; set; } = true;

    [Parameter]
    public string? Class { get; set; }

    // The grey plate of a note, without the colour of its style
    [Parameter]
    public bool Plain { get; set; }

    private string? CssClass => Plain ? $"border-transparent bg-hover {Class}".Trim() : ShowIcon ? $"ps-11 {Class}".Trim() : Class;

    private AlertVariant BbVariant => Plain ? AlertVariant.Default : Kind switch
    {
        AlertKind.Success => AlertVariant.Success,
        AlertKind.Warning => AlertVariant.Warning,
        AlertKind.Danger => AlertVariant.Danger,
        _ => AlertVariant.Info
    };

    private string DefaultIcon => Kind switch
    {
        AlertKind.Success => "check_circle",
        AlertKind.Warning => "warning",
        AlertKind.Danger => "error",
        _ => "info"
    };

    [Parameter]
    public string? Style { get; set; }

    // Shown once on this device; needs Key
    [Parameter]
    public bool OneTime { get; set; }

    // The name of the alert among the one-time ones; the same key on two pages is one alert
    [Parameter]
    public string? Key { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private ILocalDocumentStore? Store => Services.GetService<ILocalDocumentStore>();

    protected override async Task OnParametersSetAsync()
    {
        if (!OneTime)
        {
            _visible = true;
            return;
        }

        ArgumentException.ThrowIfNullOrWhiteSpace(Key, nameof(Key));
        if (_checkedKey == Key)
        {
            return;
        }

        // Hidden until the mark is read: a shown alert must not flash
        _checkedKey = Key;
        _visible = false;
        if (Store is not { } store)
        {
            _visible = true;
            return;
        }

        try
        {
            var shown = (await store.LoadAsync(Collection)).Any(row => row.Key == Key);
            _visible = !shown;
            if (!shown)
            {
                await store.PutAsync(Collection, [new LocalDocument(Key, "true")]);
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // no store here (prerendering, a closed page): shown, and not marked
            _visible = true;
        }
    }

    private Task CloseAsync()
    {
        _visible = false;
        return Task.CompletedTask;
    }

}
