@using BlazorBlueprint.Components
@using System.Globalization
@implements IDisposable
@inject IFloxRuntime Runtime

<Center>
    <BbEmpty Title=@Strings.Connection_Title Description=@Strings.Connection_Description Size="EmptySize.Large">
        <Icon><FloxIcon Icon="cloud_off" Size="3rem"/></Icon>
        <ChildContent>
            <div class="flex flex-col items-center gap-3">
                @if (_isRetrying)
                {
                    <CircularProgress/>
                }
                else
                {
                    <span class="text-xs text-muted">@string.Format(CultureInfo.CurrentCulture, Strings.Connection_RetryIn, _secondsLeft)</span>
                }
                <Button Disabled=@_isRetrying OnClick="@RetryAsync">@Strings.Caption_Retry</Button>
            </div>
        </ChildContent>
    </BbEmpty>

    @if (Exception is not null)
    {
        <details class="w-full max-w-2xl rounded-lg border border-line p-3 text-start">
            <summary class="cursor-pointer text-sm font-medium">@Strings.Connection_Details</summary>
            <p class="m-0 mt-2 text-sm">@Exception.Message</p>
            @if (Runtime.IsDevelopment)
            {
                <StackTraceView Trace=@Exception.StackTrace/>
            }
        </details>
    }
</Center>

@code {

    private const int RetryIntervalSeconds = 10;

    private Timer? _timer;
    private int _secondsLeft = RetryIntervalSeconds;
    private bool _isRetrying;

    [Parameter]
    public Exception? Exception { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }

    protected override void OnInitialized()
    {
        _timer = new Timer(OnTick, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void OnTick(object? state)
    {
        _ = InvokeAsync(TickAsync);
    }

    private async Task TickAsync()
    {
        if (_isRetrying)
        {
            return;
        }

        _secondsLeft--;
        if (_secondsLeft <= 0)
        {
            // Outside an event the component draws only when told: the button shows the retry while it runs
            var retry = RetryAsync();
            StateHasChanged();
            await retry;
        }
        else
        {
            StateHasChanged();
        }
    }

    private async Task RetryAsync()
    {
        if (_isRetrying)
        {
            return;
        }

        _isRetrying = true;
        await OnRetry.InvokeAsync();
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

}
