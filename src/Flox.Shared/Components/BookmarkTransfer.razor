@* Export and import of the bookmarks of this device: the way to move them to another one *@
@implements IAsyncDisposable
@inherits StatelessWidget
@using Flox.Shared.Services
@using Radzen
@inject UserBookmarkTransfer Transfer


<RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Icon="download" Text=@Strings.Caption_ExportBookmarks Click=@ExportAsync data-bookmarks="export"/>
<RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Icon="upload" Text=@Strings.Caption_ImportBookmarks Click=@PickAsync data-bookmarks="import"/>
<InputFile @ref=@_input accept=".json,application/json" class="hidden" OnChange=@ImportAsync/>

@code {

    private const string ModulePath = "./_content/Flox.Shared/flox-download.js";

    private InputFile? _input;
    private IJSObjectReference? _module;

    // After an import: the list shows the new rows
    [Parameter]
    public EventCallback OnImported { get; set; }

    private async Task<IJSObjectReference> ModuleAsync()
    {
        return _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
    }

    private async Task ExportAsync()
    {
        await TryAsync(async () =>
        {
            var bytes = await Transfer.ExportAsync();
            await (await ModuleAsync()).InvokeVoidAsync("download", UserBookmarkTransfer.FileName(DateTimeOffset.UtcNow), "application/json", bytes);
        });
    }

    private async Task PickAsync()
    {
        if (_input?.Element is { } element)
        {
            await TryAsync(async () => await (await ModuleAsync()).InvokeVoidAsync("pick", element));
        }
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        await TryAsync(async () =>
        {
            BookmarkImportResult result;
            try
            {
                await using var stream = args.File.OpenReadStream(UserBookmarkTransfer.MaxFileSize);
                result = await Transfer.ImportAsync(stream);
            }
            catch (Exception ex) when (ex is InvalidDataException or IOException)
            {
                this.ShowSnack(Strings.Message_BookmarksFileInvalid, NotificationSeverity.Error);
                return;
            }

            this.ShowSnack(string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.Message_BookmarksImported, result.Added, result.Existing), NotificationSeverity.Success);
            await OnImported.InvokeAsync();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // the page is gone, and the module with it
            }
        }
    }

}
