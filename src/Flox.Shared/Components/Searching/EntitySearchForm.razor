@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives
@typeparam TEntity

<div class=@($"flex flex-col gap-4 pe-2 {Class}")>
    @foreach (var field in Fields)
    {
        var id = $"search-{field.Field}";
        switch (field.ControlType)
        {
            case SearchControlType.Text:
                <FormField Text="@field.Label" For="@id">
                    <BbInput Id="@id" Value="@GetString(field)" ValueChanged="@(v => SetValue(field, v))" UpdateTiming="UpdateTiming.Immediate"/>
                </FormField>
                break;

            case SearchControlType.Select:
                <FormField Text="@field.Label">
                    <BbSelect TValue="string" Value="@GetString(field)" ValueChanged="@(v => SetValue(field, v))" AriaLabel="@field.Label"
                              Options="@((field.Options ?? []).Select(SelectOption.FromValue))"/>
                </FormField>
                break;

            case SearchControlType.MultiSelect:
                <FormField Text="@field.Label">
                    <BbMultiSelect TValue="string" Values="@GetStrings(field)" ValuesChanged="@(v => SetValues(field, v ?? []))" AriaLabel="@field.Label"
                                   Options="@((field.Options ?? []).Select(SelectOption.FromValue))"/>
                </FormField>
                break;

            case SearchControlType.Bool:
                @* Three states: any, yes, no *@
                <FormField Text="@field.Label" For="@id" Horizontal="true">
                    <BbCheckbox Id="@id" Checked="@(GetBool(field) == true)" Indeterminate="@(GetBool(field) is null)"
                                CheckedChanged="@(v => SetValue(field, NextBool(GetBool(field))))"/>
                </FormField>
                break;

            case SearchControlType.DateRange:
                <div class="grid grid-cols-2 gap-4">
                    <FormField Text="@($"{field.Label} ≥")">
                        <BbDatePicker Value="@GetDate(field, RangeBound.From)" ValueChanged="@(v => SetRangeValue(field, RangeBound.From, v))" AriaLabel="@($"{field.Label} ≥")"/>
                    </FormField>
                    <FormField Text="@($"{field.Label} ≤")">
                        <BbDatePicker Value="@GetDate(field, RangeBound.To)" ValueChanged="@(v => SetRangeValue(field, RangeBound.To, v))" AriaLabel="@($"{field.Label} ≤")"/>
                    </FormField>
                </div>
                break;

            case SearchControlType.NumberRange:
                <div class="grid grid-cols-2 gap-4">
                    <FormField Text="@($"{field.Label} ≥")" For="@($"{id}-from")">
                        <BbInput Id="@($"{id}-from")" Type="InputType.Number" Value="@NumberText(GetNumber(field, RangeBound.From))"
                                 ValueChanged="@(v => SetRangeValue(field, RangeBound.From, ParseNumber(v)))"/>
                    </FormField>
                    <FormField Text="@($"{field.Label} ≤")" For="@($"{id}-to")">
                        <BbInput Id="@($"{id}-to")" Type="InputType.Number" Value="@NumberText(GetNumber(field, RangeBound.To))"
                                 ValueChanged="@(v => SetRangeValue(field, RangeBound.To, ParseNumber(v)))"/>
                    </FormField>
                </div>
                break;
        }
    }

    @if (ShowActions)
    {
        <div class="flex gap-4 mt-2">
            <Button OnClick="@SearchAsync" IconName="search" Text=@Strings.Caption_Search/>
            <Button Variant="ButtonVariant.Outline" OnClick="@ResetAsync">@Strings.Caption_Reset</Button>
        </div>
    }
</div>
