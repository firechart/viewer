@typeparam TItem where TItem : class

@using BlazorBlueprint.Components
@inherits StatelessWidget
@implements IAsyncDisposable

@if (_state is not null)
{
    var selectionActive = _state.SelectedItems.Count > 0;
    var rowCount = RowCount;

    <div @ref=@_root class=@(EffectiveLayout == ListLayout.Fill ? "data-list flex min-h-0 flex-1 flex-col" : "data-list flex flex-col")>
        @if (selectionActive)
        {
            @* The toolbar of the selection: how many rows, the commands for them, the way out *@
            <div class="flex min-h-12 items-center justify-between gap-1 rounded-lg bg-hover px-2 py-1">
                <div class="flex items-center gap-1">
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" OnClick=@ClearSelection title=@Strings.Caption_Cancel AriaLabel=@Strings.Caption_Cancel>
                        <FloxIcon Icon="close" Size="1.25rem"/>
                    </Button>
                    <span class="text-sm font-medium">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Strings.List_SelectedCount, _state.SelectedItems.Count)</span>
                </div>
                <div class="flex items-center gap-1">
                    @SelectionActions?.Invoke(_state.SelectedItems)
                </div>
            </div>
        }
        else if (!HasSearch && HasToolbar && ListCommandsSection is not null)
        {
            @* No search: the commands go to the heading of the page, beside its own *@
            <SectionContent SectionName=@ListCommandsSection>@ToolbarCommands</SectionContent>
        }
        else if (HasToolbar)
        {
            @* The toolbar: the search field, then the commands (the filter, the visible ones of the page, refresh) and the menu of the rarer ones *@
            <div class="flex items-center gap-2 pb-2">
                @if (HasSearch)
                {
                    <div class="min-w-0 flex-1">
                        @if (SearchTextChanged.HasDelegate)
                        {
                            <Search Value=@SearchText ValueChanged=@SearchTextChanged Placeholder=@Strings.Caption_Search SlashFocuses/>
                        }
                        else
                        {
                            <Search Value=@_state.SearchText ValueChanged=@SearchAsync Placeholder=@Strings.Caption_Search SlashFocuses/>
                        }
                    </div>
                }
                else
                {
                    <div class="flex-1"></div>
                }
                @ToolbarCommands
            </div>
        }

        @if (_state.LoadError is not null && rowCount > 0)
        {
            <BbAlert Variant="AlertVariant.Warning" Class="mb-2">
                <div class="flex items-center justify-between gap-2">
                    @Strings.List_Stale
                    <Button Variant="ButtonVariant.Outline" OnClick=@RefreshAsync>@Strings.Caption_Retry</Button>
                </div>
            </BbAlert>
        }

        @* The rows in the frame of a ListSection; a filling list shrinks to its rows and scrolls inside the frame when they do not fit *@
        <div class=@(EffectiveLayout == ListLayout.Fill ? $"{Frame} flex min-h-0 flex-col" : Frame)>
        <div class=@(EffectiveLayout == ListLayout.Fill ? "min-h-0 overflow-y-auto overscroll-y-contain" : "relative")>

            @if (Mode == ListMode.Virtual)
            {
                <Virtualize @ref=@_virtualize TItem="TItem" ItemsProvider=@LoadRowsAsync ItemComparer=@_state!.ItemComparer ItemSize=@RowHeight OverscanCount="4" Context="item">
                    <ItemContent>
                        <div data-row-id=@RowIndex(item) class="border-b border-line" role="listitem"
                             @onclick=@(() => HandleRowClickAsync(item))
                             @oncontextmenu=@(e => OpenRowMenu(e, item))
                             @oncontextmenu:preventDefault=@(RowMenu is not null)>
                            @ItemTemplate?.Invoke(CreateRow(item, selectionActive))
                        </div>
                    </ItemContent>
                    <Placeholder>
                        <div style=@($"height:{RowHeight.ToString(System.Globalization.CultureInfo.InvariantCulture)}px")></div>
                    </Placeholder>
                    <EmptyContent>
                        @EmptyState
                    </EmptyContent>
                </Virtualize>
            }
            else if (rowCount == 0)
            {
                @EmptyState
            }
            else
            {
                <div role="list" class="divide-y divide-line">
                    @foreach (var item in _state.Items)
                    {
                        <div @key=@item data-row-id=@RowIndex(item) role="listitem"
                             @onclick=@(() => HandleRowClickAsync(item))
                             @oncontextmenu=@(e => OpenRowMenu(e, item))
                             @oncontextmenu:preventDefault=@(RowMenu is not null)>
                            @ItemTemplate?.Invoke(CreateRow(item, selectionActive))
                        </div>
                    }
                </div>
            }
        </div>
            @* The rows stay usable under it: a virtual list loads while it is scrolled *@
            <BusyIndicator Visible=@(Mode == ListMode.Virtual ? _virtualLoading : _state.IsBusy && rowCount > 0) Dim=@(Mode != ListMode.Virtual) BlockInput="false" Delayed="false"/>
        </div>

        @if (ShowPager)
        {
            var pageSize = _state.PageSize;
            var current = _state.CurrentPage;
            var pages = (int)((_state.Total + pageSize - 1) / pageSize);
            var from = (long)current * pageSize + 1;
            var to = Math.Min(from + pageSize - 1, _state.Total);
            <div class="flex items-center justify-between gap-2 px-2 pt-2">
                <span class="text-sm whitespace-nowrap text-muted">@from–@to / @_state.Total</span>
                <BbPagination Class="mx-0 w-auto justify-end">
                    <BbPaginationContent>
                        <BbPaginationItem>
                            <BbPaginationPrevious ShowText="false" Disabled=@(current == 0) OnClick=@(() => GoToPageAsync(current - 1))/>
                        </BbPaginationItem>
                        @foreach (var page in PageWindow(current, pages))
                        {
                            var target = page;
                            <BbPaginationItem>
                                <BbPaginationLink IsActive=@(target == current) OnClick=@(() => GoToPageAsync(target))>@(target + 1)</BbPaginationLink>
                            </BbPaginationItem>
                        }
                        <BbPaginationItem>
                            <BbPaginationNext ShowText="false" Disabled=@(current >= pages - 1) OnClick=@(() => GoToPageAsync(current + 1))/>
                        </BbPaginationItem>
                    </BbPaginationContent>
                </BbPagination>
            </div>
        }

        @if (Footer is not null)
        {
            @* A note under the rows, as the footer of a ListSection; hidden when it renders nothing *@
            <div class="px-[calc(1px+var(--spacing)*3)] pt-2 text-xs text-muted empty:hidden">@Footer</div>
        }
    </div>

    @* The menu of a row: one for the list, opened where the right click or the long tap was *@
    @if (RowMenu is not null)
    {
        @* The primitive root: the styled one keeps OpenAt to itself *@
        <BlazorBlueprint.Primitives.ContextMenu.BbContextMenu @ref=@_menu OpenChanged=@OnMenuOpenChanged>
            <BbContextMenuContent>
                @if (_menuContext is not null)
                {
                    @RowMenu(_menuContext)
                }
            </BbContextMenuContent>
        </BlazorBlueprint.Primitives.ContextMenu.BbContextMenu>
    }
}

@code {
    private IListState<TItem>? _state;
    private IListState<TItem>? _subscribed;
    private ArrayListState<TItem>? _array;
    private IEnumerable<TItem>? _arraySource;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _gestures;
    private DotNetObjectReference<DataList<TItem>>? _self;
    private bool _attaching;
    private bool _attachFailed;
    private bool _disposed;
    private Virtualize<TItem>? _virtualize;
    private BlazorBlueprint.Primitives.ContextMenu.BbContextMenu? _menu;
    private RowMenuContext<TItem>? _menuContext;

    // The rows a virtual list has loaded, by their index in the whole list: a gesture finds its row by it
    private readonly Dictionary<int, TItem> _virtualRows = [];
    private readonly Dictionary<TItem, int> _virtualIndex = new Dictionary<TItem, int>(ReferenceEqualityComparer.Instance);
    private int _virtualTotal;
    private int _virtualLoads;
    private bool _virtualLoading;

    // The state behind the list: a data source state, or any other. Without it the list shows Items
    [Parameter]
    public IListState<TItem>? State { get; set; }

    // The rows as an array; not paged, not searched
    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    [Parameter]
    public ListMode Mode { get; set; } = ListMode.Paged;

    [Parameter]
    public ListLayout Layout { get; set; } = ListLayout.Fill;

    [Parameter]
    public bool ShowSearch { get; set; } = true;

    /// <summary>The text of the search field of rows the page filters itself (<see cref="Items"/>); shown when <see cref="SearchTextChanged"/> is set.</summary>
    [Parameter]
    public string? SearchText { get; set; }

    /// <summary>A change of the search field: the page filters the rows, the list does not search.</summary>
    [Parameter]
    public EventCallback<string?> SearchTextChanged { get; set; }

    /// <summary>Shows the refresh command in the toolbar; a pull down of the page does the same on a touch screen.</summary>
    [Parameter]
    public bool ShowRefresh { get; set; }

    // Rows get a mark in place of the leading content to be selected
    [Parameter]
    public bool Selectable { get; set; }

    [Parameter]
    public int FilterCount { get; set; }

    // The filter button is shown when the page handles it (usually it opens a dialog)
    [Parameter]
    public EventCallback OnFilter { get; set; }

    [Parameter]
    public EventCallback<TItem> OnRowClick { get; set; }

    // The height of a row in pixels, for the scroll bar of a virtual list
    [Parameter]
    public float RowHeight { get; set; } = 64;

    // The tile of a row; ListRow gives the item and the selection to hand to ListTile
    [Parameter]
    public RenderFragment<ListRow<TItem>>? ItemTemplate { get; set; }

    // The commands of the context menu of a row (a right click, a long tap); built when it opens
    [Parameter]
    public RenderFragment<RowMenuContext<TItem>>? RowMenu { get; set; }

    // The commands while rows are selected; they get the selected rows
    [Parameter]
    public RenderFragment<IReadOnlyCollection<TItem>>? SelectionActions { get; set; }

    // The commands of the list always shown in its toolbar
    [Parameter]
    public RenderFragment? Commands { get; set; }

    // The rarer commands of the list (PageMenuItem), in a menu at the end of its toolbar
    [Parameter]
    public RenderFragment? MenuItems { get; set; }

    [Parameter]
    public RenderFragment? EmptyTemplate { get; set; }

    // The outlet in the heading of the ListPage around the list: its commands go there when it has no search
    [CascadingParameter(Name = ListPage.ListCommandsCascade)]
    public string? ListCommandsSection { get; set; }

    // A note under the rows: a summary of the list, a text, a link
    [Parameter]
    public RenderFragment? Footer { get; set; }

    private const string Frame = "relative overflow-hidden rounded-xl border border-line bg-surface text-card-foreground shadow-xs";

    // A virtual list has no height of its own: it always scrolls inside its parent
    private ListLayout EffectiveLayout
    {
        get
        {
            return Mode == ListMode.Virtual ? ListLayout.Fill : Layout;
        }
    }

    private int RowCount
    {
        get
        {
            return Mode == ListMode.Virtual ? _virtualTotal : _state?.Items.Count ?? 0;
        }
    }

    private bool HasToolbar
    {
        get
        {
            return Commands is not null || MenuItems is not null || OnFilter.HasDelegate || ShowRefresh || HasSearch;
        }
    }

    private bool HasSearch
    {
        get
        {
            return ShowSearch && (SearchTextChanged.HasDelegate || _state is { CanSearch: true });
        }
    }


    private bool ShowPager
    {
        get
        {
            return Mode == ListMode.Paged && _state is { PageSize: > 0 } state && state.Total > state.PageSize;
        }
    }

    private RenderFragment ToolbarCommands =>
        @<text>
            @if (OnFilter.HasDelegate)
            {
                <FilterButton Count=@FilterCount OnClick=@OnFilter/>
            }
            @Commands
            @if (ShowRefresh)
            {
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" title=@Strings.Caption_Refresh AriaLabel=@Strings.Caption_Refresh
                        OnClick=@RefreshAsync data-list="refresh">
                    <FloxIcon Icon="refresh"/>
                </Button>
            }
            @if (MenuItems is not null)
            {
                <PageMenu>@MenuItems</PageMenu>
            }
        </text>;

    private RenderFragment EmptyState =>
        @<text>
            @if (_state!.IsBusy)
            {
                <div class="flex items-center justify-center px-4 py-12">
                    <CircularProgress/>
                </div>
            }
            else if (_state.LoadError is not null)
            {
                <BbEmpty Title=@Strings.List_LoadFailed>
                    <Icon><FloxIcon Icon="error" Size="2rem" Class="text-danger"/></Icon>
                    <ChildContent><Button Variant="ButtonVariant.Outline" OnClick=@RefreshAsync>@Strings.Caption_Retry</Button></ChildContent>
                </BbEmpty>
            }
            else if (EmptyTemplate is not null)
            {
                @EmptyTemplate
            }
            else
            {
                <BbEmpty Description=@Strings.List_NoData Size="EmptySize.Small"/>
            }
        </text>;

    protected override void OnParametersSet()
    {
        if (State is null && Items is not null && !ReferenceEquals(_arraySource, Items))
        {
            _array ??= new ArrayListState<TItem>();
            _array.SetItems(Items);
            _arraySource = Items;
        }

        _state = State ?? (Items is not null ? _array : null);
        if (!ReferenceEquals(_subscribed, _state))
        {
            if (_subscribed is not null)
            {
                _subscribed.Changed -= OnStateChanged;
            }

            _subscribed = _state;
            if (_subscribed is not null)
            {
                _subscribed.Changed += OnStateChanged;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (_gestures is null && _state is not null && !_attaching && !_attachFailed && !_disposed)
        {
            _attaching = true;
            try
            {
                await AttachGesturesAsync();
            }
            catch
            {
                _attachFailed = true;
                throw;
            }
            finally
            {
                _attaching = false;
            }
        }
    }

    // Once, whatever renders come meanwhile; the list may be gone (disposed) after any await
    private async Task AttachGesturesAsync()
    {
        _module ??= await JS.ImportModuleAsync("./_content/Flox.Shared/Components/DataList.razor.js");
        if (_disposed)
        {
            return;
        }

        _self ??= DotNetObjectReference.Create(this);
        var gestures = await _module.InvokeAsync<IJSObjectReference>("attach", _root, _self);
        if (_disposed)
        {
            await gestures.InvokeVoidAsync("dispose");
            await gestures.DisposeAsync();
            return;
        }

        _gestures = gestures;
    }

    [JSInvokable]
    public void OnLongPress(int index, double clientX, double clientY)
    {
        var row = ResolveRow(index);
        if (row is not null)
        {
            OpenRowMenu(new Microsoft.AspNetCore.Components.Web.MouseEventArgs { ClientX = clientX, ClientY = clientY }, row);
        }
    }

    private void OnStateChanged(object? sender, EventArgs e)
    {
        UiErrors.Fire(() => InvokeAsync(StateHasChanged), nameof(OnStateChanged));
    }

    // A row is told to a gesture by its index: in the page, or in the whole virtual list
    private int RowIndex(TItem item)
    {
        if (Mode == ListMode.Virtual)
        {
            return _virtualIndex.GetValueOrDefault(item, -1);
        }

        for (var i = 0; i < _state!.Items.Count; i++)
        {
            if (ReferenceEquals(_state.Items[i], item))
            {
                return i;
            }
        }

        return -1;
    }

    private TItem? ResolveRow(int index)
    {
        if (Mode == ListMode.Virtual)
        {
            return _virtualRows.GetValueOrDefault(index);
        }

        return _state is not null && index >= 0 && index < _state.Items.Count ? _state.Items[index] : null;
    }

    private async ValueTask<ItemsProviderResult<TItem>> LoadRowsAsync(ItemsProviderRequest request)
    {
        SetVirtualLoading(++_virtualLoads > 0);
        try
        {
            var range = await _state!.LoadRangeAsync(request.StartIndex, request.Count, request.CancellationToken);
            for (var i = 0; i < range.Items.Count; i++)
            {
                _virtualRows[request.StartIndex + i] = range.Items[i];
                _virtualIndex[range.Items[i]] = request.StartIndex + i;
            }

            _virtualTotal = (int)range.Total;
            return new ItemsProviderResult<TItem>(range.Items, _virtualTotal);
        }
        catch (OperationCanceledException)
        {
            // Virtualize cancels a request when the user scrolls on; the answer is dropped
            return new ItemsProviderResult<TItem>([], _virtualTotal);
        }
        finally
        {
            SetVirtualLoading(--_virtualLoads > 0);
        }
    }

    private void SetVirtualLoading(bool loading)
    {
        if (_virtualLoading != loading)
        {
            _virtualLoading = loading;
            UiErrors.Fire(() => InvokeAsync(StateHasChanged), nameof(SetVirtualLoading));
        }
    }

    private async Task ReloadVirtualAsync()
    {
        _virtualRows.Clear();
        _virtualIndex.Clear();
        if (_virtualize is not null)
        {
            await _virtualize.RefreshDataAsync();
        }
    }

    private ListRow<TItem> CreateRow(TItem item, bool selectionActive)
    {
        return new ListRow<TItem>(item, Selectable, Selectable && _state!.IsSelected(item), selectionActive, OnRowClick.HasDelegate, selected => SetSelectedAsync(item, selected));
    }

    private Task SetSelectedAsync(TItem item, bool selected)
    {
        if (_state!.IsSelected(item) != selected)
        {
            _state.ToggleSelected(item);
        }

        return Task.CompletedTask;
    }

    private void ClearSelection()
    {
        _state?.ClearSelection();
    }

    // Loads the rows again; a virtual list is asked to load what it shows
    public async Task RefreshAsync()
    {
        if (_state is null)
        {
            return;
        }

        if (Mode == ListMode.Virtual)
        {
            await ReloadVirtualAsync();
        }
        else
        {
            await _state.RefreshAsync();
        }
    }

    private async Task SearchAsync(string? text)
    {
        if (_state is null)
        {
            return;
        }

        if (Mode == ListMode.Virtual)
        {
            _state.SetSearchText(text);
            await ReloadVirtualAsync();
        }
        else
        {
            await _state.SearchAsync(text);
        }
    }

    private async Task GoToPageAsync(int page)
    {
        if (_state is null || page < 0 || page == _state.CurrentPage)
        {
            return;
        }

        Logger.LogDebug("Pager of {Item}: page {Page}", typeof(TItem).Name, page);
        await _state.GoToPageAsync(page);
    }

    // Up to three page numbers around the current one
    private static List<int> PageWindow(int current, int pages)
    {
        const int Count = 3;
        var first = Math.Max(0, Math.Min(current - (Count / 2), pages - Count));
        var last = Math.Min(pages - 1, first + Count - 1);
        var result = new List<int>();
        for (var page = first; page <= last; page++)
        {
            result.Add(page);
        }

        return result;
    }

    private async Task HandleRowClickAsync(TItem row)
    {
        if (_state is null)
        {
            return;
        }

        _state.Current = row;

        // While rows are being selected a tap selects, it does not open
        if (_state.SelectedItems.Count == 0 && OnRowClick.HasDelegate)
        {
            await OnRowClick.InvokeAsync(row);
        }
    }

    private void OpenRowMenu(Microsoft.AspNetCore.Components.Web.MouseEventArgs position, TItem row)
    {
        if (_state is null || RowMenu is null || _menu is null)
        {
            return;
        }

        _state.Current = row;
        _menuContext = new RowMenuContext<TItem>(row, _state.Targets(row), CloseRowMenu);
        UiErrors.Fire(() => _menu.OpenAt(position.ClientX, position.ClientY), nameof(OpenRowMenu));
    }

    private void CloseRowMenu()
    {
        if (_menu is not null)
        {
            UiErrors.Fire(() => _menu.Close(), nameof(CloseRowMenu));
        }
    }

    private void OnMenuOpenChanged(bool open)
    {
        if (!open)
        {
            _menuContext = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnStateChanged;
        }

        try
        {
            if (_gestures is not null)
            {
                await _gestures.InvokeVoidAsync("dispose");
                await _gestures.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }

}
