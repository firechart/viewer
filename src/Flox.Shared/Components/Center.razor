@* The content in the middle of the page, both ways *@
<div class=@($"flex min-h-[70vh] flex-col items-center justify-center px-4 {Class}")>
    @ChildContent
</div>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

}
