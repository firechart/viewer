@using BlazorBlueprint.Components
@* The toggle of a bookmark: a quiet icon button like the other commands (FilterButton); its name and state for a screen reader. Inside the link of
   a row a click neither follows the link nor reaches the row: the span around it stops it *@
<span class="contents" @onclick:stopPropagation @onclick:preventDefault>
    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" title=@Caption AriaLabel=@Caption aria-pressed=@(Bookmarked ? "true" : "false")
              OnClick=@(() => OnToggle.InvokeAsync())>
        <Bookmark Bookmarked=@Bookmarked/>
    </Button>
</span>

@code {

    [Parameter]
    public bool Bookmarked { get; set; }

    [Parameter]
    public EventCallback OnToggle { get; set; }

    private string Caption
    {
        get
        {
            return Bookmarked ? Strings.Caption_RemoveBookmark : Strings.Caption_AddBookmark;
        }
    }

}
