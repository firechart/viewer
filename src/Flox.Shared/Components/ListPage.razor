@* The page of a list: AppBarTitle, Breadcrumbs and the Heading with the commands of the page (Commands) and its rarer ones in a menu (MenuItems);
   the content is usually one DataList, whose own commands are in its toolbar beside its search, or in the heading before the commands of the page
   when it has no search (the outlet the page cascades to it) *@

@inherits StatelessWidget

<AppBarTitle>@Title</AppBarTitle>

<div class=@(Layout == ListLayout.Fill ? "flex h-[calc(100dvh-var(--flox-header-height)-2*var(--flox-body-padding)-env(safe-area-inset-top))] flex-col gap-1" : "flex flex-col gap-1")>
    <Breadcrumbs Items=@Breadcrumbs/>
    <Heading Commands=@Commands Menu=@MenuItems ListCommandsSection=@_listCommands>@Title</Heading>
    <CascadingValue Name=@ListCommandsCascade Value=@_listCommands IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {

    public const string ListCommandsCascade = "FloxListPageCommands";

    private readonly string _listCommands = $"list-commands-{Guid.NewGuid():N}";

    [Parameter]
    public string? Title { get; set; }

    // Fill: the page is as high as the screen and the list in it scrolls; Content: the page scrolls
    [Parameter]
    public ListLayout Layout { get; set; } = ListLayout.Fill;

    // The commands of the page, on the right of its title
    [Parameter]
    public RenderFragment? Commands { get; set; }

    // The rarer commands of the page (PageMenuItem), in the menu More after its commands
    [Parameter]
    public RenderFragment? MenuItems { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

}
