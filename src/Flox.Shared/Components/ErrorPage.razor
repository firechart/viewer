@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives
@* Rendered outside MainLayout, so it brings its own theme *@
<FloxThemeHost Dark="true"/>
@* The overlays of Blazor Blueprint (dialogs, popovers, menus), its programmatic dialogs and its toasts (the snackbar: bottom centre) *@
<BbPortalHost/>
<BbDialogProvider/>
<BbToastProvider Position="ToastPosition.BottomCenter"/>
<FloxDialogHost/>

<div class="flex flex-col items-center justify-center gap-4 min-h-dvh bg-canvas p-4 text-ink">
    <h1 class="m-0 text-3xl font-semibold tracking-tight">500</h1>
    <ErrorDisplay Exception=@Exception ErrorBoundary=@ErrorBoundary/>
</div>

@code {

    [Parameter]
    public Exception? Exception { get; set; }

    [Parameter]
    public ErrorBoundary? ErrorBoundary { get; set; }

}
