@using BlazorBlueprint.Components
@using System.ComponentModel
@inherits StatelessWidget

@{
    RenderFragment leadingContent = @<text>
                                        @if (Leading != null)
                                        {
                                            @Leading
                                        }
                                        else if (Icon != null)
                                        {
                                            <FloxIcon Icon=@Icon Color=@IconColor/>
                                        }
                                    </text>;

    // An Item of Blazor Blueprint: the leading box, the text (title, subtitle, trailing text) and the controls at the end. A row with a link is the
    // link itself (AsChild a); the hover of Blueprint comes with a click
    RenderFragment tileContent = @<BbItem AsChild=@(IsLink ? "a" : null) Href=@(IsLink ? AppUrl.ToHref(Href!) : null) Size="ItemSize.Sm" Class=@GetOuterClass()
                                         style=@Style @attributes=@ClickAttributes>
                                     @if (IsSelectable)
                                     {
                                         <BbItemMedia>
                                             <button type="button" class="group/lead relative flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent p-0 text-inherit"
                                                     role="checkbox" aria-checked=@(IsSelected ? "true" : "false") aria-label=@SelectLabel
                                                     @onclick=@ToggleSelectedAsync @onclick:stopPropagation @onclick:preventDefault>
                                                 @leadingContent
                                                 <span aria-hidden="true" class=@GetSelectionMarkClass()>
                                                     <FloxIcon Icon="done" Size="1.25rem"/>
                                                 </span>
                                             </button>
                                         </BbItemMedia>
                                     }
                                     else if (Leading != null || Icon != null)
                                     {
                                         @* A box of a fixed size, the same as of a selectable row: the icons of the rows of a list are in one column; an icon in a square *@
                                         <BbItemMedia Variant="ItemMediaVariant.Icon" Class="size-8 text-muted">
                                             @leadingContent
                                         </BbItemMedia>
                                     }

                                     @* The text of the row: the trailing text stays on the line of the title while both fit, then goes under the subtitle;
                                        then takes up to three lines (an address breaks anywhere). The leading box and the controls keep their places *@
                                     <BbItemContent Class="min-w-0 flex-row flex-wrap items-center gap-x-3 gap-y-0">
                                         <div class="flex min-w-0 flex-auto flex-col gap-1">
                                             @if (Title != null)
                                             {
                                                 @Title
                                             }
                                             else if (!string.IsNullOrEmpty(TitleText))
                                             {
                                                 @* Regular, not the medium of Blueprint: a list of medium titles reads heavy, the headings of the page carry the weight *@
                                                 <BbItemTitle Class="min-w-0 font-normal leading-snug"><span class="truncate">@TitleText</span></BbItemTitle>
                                             }
                                             @if (Subtitle != null)
                                             {
                                                 @Subtitle
                                             }
                                             else if (!string.IsNullOrEmpty(SubtitleText))
                                             {
                                                 <BbItemDescription Class="line-clamp-1 wrap-anywhere">@SubtitleText</BbItemDescription>
                                             }
                                         </div>

                                         @if (Trailing == null && !string.IsNullOrEmpty(TrailingText))
                                         {
                                             <div class="min-w-0 max-w-full flex-initial text-sm text-muted line-clamp-3 wrap-anywhere" title=@TrailingText>@TrailingText</div>
                                         }
                                     </BbItemContent>

                                     @* A control (a switch, a button, a counter) is not text: it stays at the end of the row *@
                                     @if (Trailing != null || !string.IsNullOrEmpty(Warning) || Bookmarked is not null || Chevron || HasHref)
                                     {
                                         <BbItemActions>
                                             @Trailing

                                             @if (!string.IsNullOrEmpty(Warning))
                                             {
                                                 <span class="flex shrink-0 text-danger" role="img" title=@Warning aria-label=@Warning>
                                                     <FloxIcon Icon="sync_problem"/>
                                                 </span>
                                             }

                                             @if (Bookmarked is { } bookmarked)
                                             {
                                                 <BookmarkToggle Bookmarked=@bookmarked OnToggle=@OnBookmark/>
                                             }

                                             @if (Chevron || HasHref)
                                             {
                                                 <Chevron/>
                                             }
                                         </BbItemActions>
                                     }
                                 </BbItem>;
}

@if (InList)
{
    <div role="listitem">@tileContent</div>
}
else
{
    @tileContent
}

@code {

    // The name of the cascade of ListSection.List
    public const string ListCascade = "FloxListSectionRows";

    [CascadingParameter(Name = ListCascade)]
    private bool InList { get; set; }

    private bool HasHref => !string.IsNullOrWhiteSpace(Href);

    // Rows are being selected: a tap on the row selects it instead of opening it
    private bool IsSelectable => Row?.Selectable ?? Selectable;

    private bool IsSelected => Row?.Selected ?? Selected;

    private bool IsSelectionActive => Row?.SelectionActive ?? SelectionActive;

    private bool TapSelects => IsSelectable && IsSelectionActive;

    private string SelectLabel => string.IsNullOrEmpty(TitleText) ? Strings.Caption_Select : string.Format(Strings.Caption_SelectItem, TitleText);

    // A link opens its page, unless a tap selects the row
    private bool IsLink => HasHref && !TapSelects;

    private bool IsClickable => HasHref || OnClick.HasDelegate || OnSelected.HasDelegate || TapSelects || Row is { Clickable: true };

    // The click only where the row does something: Blueprint draws the hover of an Item that has one
    private Dictionary<string, object>? ClickAttributes => IsClickable
        ? new() { ["onclick"] = EventCallback.Factory.Create(this, HandleClick) }
        : null;

    private async Task ToggleSelectedAsync()
    {
        var selected = !IsSelected;
        if (Row != null)
        {
            await Row.SetSelectedAsync(selected);
        }
        else
        {
            Selected = selected;
        }

        await SelectedChanged.InvokeAsync(selected);
    }

    private async Task HandleClick()
    {
        if (TapSelects)
        {
            await ToggleSelectedAsync();
            return;
        }

        if (OnSelected.HasDelegate)
        {
            await OnSelected.InvokeAsync();
        }

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }

    [Parameter]
    public EventCallback OnSelected { get; set; }

    [Parameter]
    public bool Chevron { get; set; } = false;

    // The bookmark mark at the end of the row: filled when bookmarked, outlined when not; null shows none. A tap on it calls OnBookmark and does not open the row
    [Parameter]
    public bool? Bookmarked { get; set; }

    // A problem with the row that the user should see (the server did not accept the row): an icon with the text as its title
    [Parameter]
    public string? Warning { get; set; }

    [Parameter]
    public EventCallback OnBookmark { get; set; }

    [Parameter]
    public string? Class { get; set; }

    // Tighter rows for tiles that carry a control (dropdown, switch, slider)
    [Parameter]
    public bool Dense { get; set; } = false;

    // The leading slot becomes a checkbox: the mark is drawn over the leading content, so the row keeps its shape
    // The row of a DataList: it says whether the tile is selectable and selected, and takes the changes
    [Parameter]
    public IListRow? Row { get; set; }

    [Parameter]
    public bool Selectable { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public EventCallback<bool> SelectedChanged { get; set; }

    // Some rows of the list are selected: the marks stay visible and a tap on a row toggles it
    [Parameter]
    public bool SelectionActive { get; set; }

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public RenderFragment? Leading { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? IconColor { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public RenderFragment? Subtitle { get; set; }

    [Parameter]
    public string? SubtitleText { get; set; }

    [Parameter]
    public RenderFragment? Title { get; set; }

    [Parameter]
    public string? TitleText { get; set; }

    [Parameter]
    public RenderFragment? Trailing { get; set; }

    [Parameter]
    public string? TrailingText { get; set; }

    private string GetSelectionMarkClass()
    {
        const string Base = "absolute inset-0 flex items-center justify-center rounded-md transition-opacity";
        if (IsSelected)
        {
            return $"{Base} bg-accent text-primary-foreground";
        }

        return IsSelectionActive ? $"{Base} border-2 border-line bg-surface" : $"{Base} border-2 border-line bg-surface opacity-0 group-hover/lead:opacity-100";
    }

    protected string GetOuterClass()
    {
        // A row of a list has no corners of its own: the frame of the list (ListSection) has them
        var result = new List<string> { "rounded-none text-inherit no-underline hover:bg-row-hover", Dense ? "min-h-10" : "min-h-12" };

        if (!string.IsNullOrEmpty(Class))
        {
            result.Add(Class);
        }

        if (IsClickable)
        {
            result.Add("cursor-pointer");
        }

        if (IsSelectable && IsSelected)
        {
            result.Add("bg-accent-soft");
        }

        if (Disabled)
        {
            result.Add("pointer-events-none opacity-50");
        }

        return string.Join(" ", result);
    }

}
