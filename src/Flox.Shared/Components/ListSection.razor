@using BlazorBlueprint.Components
@* A group of rows: the caption and the commands above, the rows in a framed card divided by lines, a note below in small gray text without a frame
   (the footer of a group of iOS); the caption and the note start where the text of the rows does. A section right after another stands apart from it:
   more room above its caption than between the caption and its rows *@
<section class="flex flex-col gap-2 [section+&]:mt-6" aria-labelledby=@(string.IsNullOrEmpty(Title) ? null : _titleId)>
    @if (!string.IsNullOrEmpty(Title) || Commands is not null)
    {
        <Heading Size="HeadingSize.Section" Id=@_titleId Tooltip=@Title Commands=@Commands>@Title</Heading>
    }
    @if (Definitions)
    {
        <dl class=@($"{GetClass()} m-0")>
            @ChildContent
        </dl>
    }
    else
    {
        <BbItemGroup Class=@($"{GetClass()} gap-0") role=@(List ? "list" : null)>
            <CascadingValue Name=@ListTile.ListCascade Value=@List>
                @ChildContent
            </CascadingValue>
        </BbItemGroup>
    }
    @if (Footer is not null)
    {
        @* Hidden when the note renders nothing (a component that has nothing to say) *@
        <div class="px-[calc(1px+var(--spacing)*3)] text-xs text-muted empty:hidden">@Footer</div>
    }
</section>

@code {

    private readonly string _titleId = $"section-{Guid.NewGuid():N}";

    [Parameter]
    public string? Title { get; set; }

    // A note under the rows: a text, a link, a command
    [Parameter]
    public RenderFragment? Footer { get; set; }

    [Parameter]
    public RenderFragment? Commands { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Renders a divider between consecutive children (e.g. ListTile rows) - the container, not
    /// each child, owns this so callers don't have to compute "am I the last item" themselves.
    /// </summary>
    [Parameter]
    public bool Dividers { get; set; } = true;

    // The rows are ListTiles and nothing else: the container is a list and every tile an item of it, so a screen reader tells how many rows there are
    [Parameter]
    public bool List { get; set; }

    // The rows are PropertyTiles: the list is a definition list (<dl>), read by a screen reader as pairs of a term and its value
    [Parameter]
    public bool Definitions { get; set; }

    private string GetClass()
    {
        var list = new List<string> { "overflow-hidden rounded-xl border border-line bg-surface text-card-foreground shadow-xs" };
        if (Dividers)
        {
            list.Add("divide-y divide-line");
        }

        if (!string.IsNullOrEmpty(Class))
        {
            list.Add(Class);
        }

        return string.Join(" ", list);
    }

}
