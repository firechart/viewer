@using BlazorBlueprint.Components
<Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" OnClick=NotifyStarredChangingAsync aria-pressed=@(Starred ? "true" : "false")>
    <FloxIcon Icon="star" Filled=@Starred Class="text-warning"/>
</Button>

@code {

    [Parameter]
    public bool Starred { get; set; }

    [Parameter]
    public EventCallback<bool> StarredChanging { get; set; }

    async Task NotifyStarredChangingAsync()
    {
        await StarredChanging.InvokeAsync(!Starred);
    }

}
