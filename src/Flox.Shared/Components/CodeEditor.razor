@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@_id" class="@RootClass" style="@GetStyle()" @attributes=UserAttributes></div>

@code {
    private readonly string _id = $"code-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private string? _currentValue;
    private CodeLanguage _currentLanguage;
    private bool _currentReadOnly;
    private bool _currentWordWrap;
    private bool _currentAutoHeight;

    public enum CodeLanguage
    {
        Json,
        Xml,
        Html
    }

    [Parameter]
    public CodeLanguage Language { get; set; } = CodeLanguage.Json;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; } = true;

    [Parameter]
    public bool WordWrap { get; set; }

    // Fixed layout (default): the editor takes the height of its parent (a flex item, or Height) and scrolls inside.
    // AutoHeight: the editor grows with its text and never scrolls vertically; for pages of unlimited height.
    [Parameter]
    public bool AutoHeight { get; set; }

    // Explicit height (e.g. "300px") for the fixed layout. Without it the editor fills a flex parent.
    [Parameter]
    public string? Height { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }

    private string RootClass => AutoHeight ? $"overflow-hidden rounded-lg border border-line {Class}" : $"h-full min-h-0 flex-1 overflow-hidden rounded-lg border border-line {Class}";

    private string GetStyle()
    {
        return $"{(!AutoHeight && !string.IsNullOrEmpty(Height) ? $"height: {Height};" : string.Empty)}{Style}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Flox.Shared/Components/CodeEditor.razor.js");
            await _module.InvokeVoidAsync("init", _id, LanguageName(Language), Value ?? string.Empty, ReadOnly, WordWrap, AutoHeight);
            Remember();
            return;
        }

        if (_module is null)
        {
            return;
        }

        if (Language != _currentLanguage)
        {
            await _module.InvokeVoidAsync("setLanguage", _id, LanguageName(Language));
        }

        if (ReadOnly != _currentReadOnly)
        {
            await _module.InvokeVoidAsync("setReadOnly", _id, ReadOnly);
        }

        if (WordWrap != _currentWordWrap)
        {
            await _module.InvokeVoidAsync("setWrap", _id, WordWrap);
        }

        if (AutoHeight != _currentAutoHeight)
        {
            await _module.InvokeVoidAsync("setAutoHeight", _id, AutoHeight);
        }

        if (Value != _currentValue)
        {
            await _module.InvokeVoidAsync("setValue", _id, Value ?? string.Empty);
        }

        Remember();
    }

    public async Task<string> GetValueAsync()
    {
        return _module is null ? string.Empty : await _module.InvokeAsync<string>("getValue", _id);
    }

    public async Task SetValueAsync(string value)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setValue", _id, value);
            _currentValue = value;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroy", _id);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private void Remember()
    {
        _currentValue = Value;
        _currentLanguage = Language;
        _currentReadOnly = ReadOnly;
        _currentWordWrap = WordWrap;
        _currentAutoHeight = AutoHeight;
    }

    private static string LanguageName(CodeLanguage language)
    {
        return language switch
        {
            CodeLanguage.Xml  => "xml",
            CodeLanguage.Html => "html",
            _                 => "json"
        };
    }

}
