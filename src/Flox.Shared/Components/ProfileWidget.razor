@using BlazorBlueprint.Components
@inject IAuthenticationService AuthenticationService
@inject FloxOidcOptions OidcOptions

@if (OidcOptions.Enabled)
{
    <AuthorizeView>
        <Authorized>
            <ListSection Title=@Strings.Caption_User Definitions>
                <PropertyTile Label=@Strings.Caption_Profile Value=@context.User.GetUserName()/>
            </ListSection>

            <ListSection Title=@Strings.Caption_Roles>
                @{
                    var roles = context.User.GetRoles();
                }
                @foreach (var role in roles)
                {
                    <ListTile TitleText="@role"/>
                }
            </ListSection>

            @if (context.User.IsAuthenticated())
            {
                <Button Variant="ButtonVariant.Outline" OnClick="LogoutAsync" Class="my-2">@Strings.Caption_Logout</Button>
            }
            else
            {
                <Button OnClick="LoginAsync" Class="my-2">@Strings.Caption_Login</Button>
            }
        </Authorized>
    </AuthorizeView>
}

@code {

    async Task LogoutAsync()
    {
        await AuthenticationService.LogoutAsync();
    }

    async Task LoginAsync()
    {
        await AuthenticationService.LoginAsync();
    }

}
