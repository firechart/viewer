@using System.Linq.Expressions
@using BlazorBlueprint.Components
@* The switch of the application: a BbSwitch of the small size by default, as compact as the buttons (Button) *@
<BbSwitch Checked=@Checked CheckedChanged=@CheckedChanged CheckedExpression=@CheckedExpression Size=@Size Disabled=@Disabled Id=@Id AriaLabel=@AriaLabel
          AriaDescribedBy=@AriaDescribedBy Class=@Class @attributes=@Attributes/>

@code {

    /// <summary>Whether the switch is on.</summary>
    [Parameter]
    public bool Checked { get; set; }

    /// <summary>Raised when the user turns the switch.</summary>
    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>The bound value, for the validation of a form (set by <c>@bind-Checked</c>).</summary>
    [Parameter]
    public Expression<Func<bool>>? CheckedExpression { get; set; }

    /// <summary>The size; small unless a page asks for another.</summary>
    [Parameter]
    public SwitchSize Size { get; set; } = SwitchSize.Small;

    /// <summary>Whether the switch can not be turned.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>The id of the switch, for the <c>for</c> of its label.</summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>The name of the switch for a screen reader when it has no label.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>The id of the element that describes the switch.</summary>
    [Parameter]
    public string? AriaDescribedBy { get; set; }

    /// <summary>More classes of the switch.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Other attributes of the switch.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? Attributes { get; set; }

}
