@using BlazorBlueprint.Components
@inject FloxDialogService DialogService

<div class="flex flex-col gap-6">
    <p class="m-0 text-sm whitespace-pre-line text-muted">@Message</p>
    <DialogActions>
        @if (!string.IsNullOrEmpty(CancelText))
        {
            <Button Variant="ButtonVariant.Outline" OnClick=@(() => Close(null))>@CancelText</Button>
        }
        @if (!string.IsNullOrEmpty(NoText))
        {
            <Button Variant="ButtonVariant.Outline" OnClick=@(() => Close(false))>@NoText</Button>
        }
        <Button OnClick=@(() => Close(true))>@YesText</Button>
    </DialogActions>
</div>

@code {

    [CascadingParameter]
    private FloxDialog? Dialog { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string YesText { get; set; } = "OK";

    [Parameter]
    public string? NoText { get; set; }

    [Parameter]
    public string? CancelText { get; set; }

    private void Close(bool? answer)
    {
        if (Dialog is not null)
        {
            DialogService.CloseDialog(Dialog, answer);
        }
        else
        {
            DialogService.Close(answer);
        }
    }

}
