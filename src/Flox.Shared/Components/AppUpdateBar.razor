@using BlazorBlueprint.Components
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

@* The update of a Flox application, at the bottom of the screen (flox-update.js, in MainLayout): with a caching worker (an application that works
   offline) a new version downloads in the background with its files counted, then Restart (every tab of the application reloads into it) or Later
   (it takes over when every tab is closed), and the first install is the application saved for offline use (counted, gone when done); with the
   worker of a Flox server a new version of the server is offered as Restart at once. Nothing shows without a worker *@
@if (_progress is { } progress && !_dismissed && Shown(progress))
{
    <div class="pointer-events-none fixed inset-x-0 bottom-0 z-50 flex justify-center p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] print:hidden"
         data-app-update=@(Ready(progress) ? "ready" : "downloading")>
        <div class="pointer-events-auto flex w-full max-w-md flex-col gap-2 rounded-xl border border-line bg-surface p-3 text-sm text-card-foreground shadow-lg"
             role="status">
            @if (Ready(progress))
            {
                <div class="flex items-center gap-2">
                    <span class="min-w-0 flex-1">@Strings.AppUpdate_Ready</span>
                    <Button Variant="ButtonVariant.Outline" OnClick=@(() => _dismissed = true) data-app-update-later>@Strings.AppUpdate_Later</Button>
                    <Button Variant="ButtonVariant.Default" OnClick=@ApplyAsync data-app-update-restart>@Strings.AppUpdate_Restart</Button>
                </div>
            }
            else
            {
                <span>@string.Format(CultureInfo.CurrentCulture, progress.Update ? Strings.AppUpdate_Downloading : Strings.AppUpdate_SavingOffline,
                                     progress.Loaded, progress.Total)</span>
                <div class="h-1 overflow-hidden rounded-full bg-hover" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow=@Percent(progress)>
                    <div class="h-full rounded-full bg-primary transition-[width]" style=@($"width: {Percent(progress).ToString(CultureInfo.InvariantCulture)}%")></div>
                </div>
            }
        </div>
    </div>
}

@code {

    private const string ModulePath = "./_content/Flox.Shared/flox-update.js";

    private AppUpdateProgress? _progress;
    private bool _dismissed;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AppUpdateBar>? _self;

    /// <summary>How far the install of a version is, as the service worker tells it.</summary>
    /// <param name="Loaded">The files loaded.</param>
    /// <param name="Total">The files to load.</param>
    /// <param name="Update">A new version of an installed application, not the first install.</param>
    /// <param name="Done">The version is installed.</param>
    /// <param name="Failed">The install failed (the browser tries again later).</param>
    public sealed record AppUpdateProgress(long Loaded, long Total, bool Update, bool Done, bool Failed);

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("watch", _self);
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            // No worker or no browser, no update to show
        }
    }

    /// <summary>Called by flox-update.js with each message of the worker.</summary>
    /// <param name="progress">How far the install is.</param>
    /// <returns>A task that completes when the bar is drawn again.</returns>
    [JSInvokable]
    public Task Progress(AppUpdateProgress progress)
    {
        _progress = progress;
        return InvokeAsync(StateHasChanged);
    }

    // A download that failed is tried again by the browser at a later start; a first install shows only while it downloads
    private static bool Shown(AppUpdateProgress progress)
    {
        return !progress.Failed && (progress.Update || !progress.Done) && (progress.Done || progress.Total > 0);
    }

    private static bool Ready(AppUpdateProgress progress)
    {
        return progress.Update && progress.Done;
    }

    private static int Percent(AppUpdateProgress progress)
    {
        return progress.Total <= 0 ? 0 : (int)Math.Min(100, progress.Loaded * 100 / progress.Total);
    }

    private async Task ApplyAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("apply");
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

}
