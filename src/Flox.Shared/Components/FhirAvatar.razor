<div class=@($"inline-flex size-8 shrink-0 items-center justify-center rounded-full text-xs font-medium text-white {GetAvatarClass()}")>@GetAvatarText()</div>

@code {

    // Fire palette: red, orange, amber shades (literals so that Tailwind sees the class names)
    private static readonly string[] s_avatarClasses =
    [
        "bg-red-600", "bg-red-700", "bg-red-800",
        "bg-orange-600", "bg-orange-700", "bg-orange-800",
        "bg-amber-600", "bg-amber-700", "bg-amber-800"
    ];

    [Parameter]
    [EditorRequired]
    public string? Source { get; set; }

    private string GetAvatarClass()
    {
        var value = Source ?? string.Empty;
        var hash = Math.Abs(value.GetHashCode());
        return s_avatarClasses[hash % s_avatarClasses.Length];
    }

    private string GetAvatarText()
    {
        var value = Source ?? string.Empty;
        return string.Join("",
                           value.ToCharArray()
                                 .Where(row => row.ToString() == row.ToString()
                                                                     .ToUpper())
                                 .Take(2));
    }

}
