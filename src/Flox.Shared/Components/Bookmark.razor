@* The icon of a bookmark, filled for a bookmarked page. In the color of the text around it, as the other icons: the command of a header, the leading
   icon of a row; a color of its own stood out as the one bright spot of a page *@
<FloxIcon Icon="bookmark" Filled=@Bookmarked Size=@Size/>

@code {

    [Parameter]
    public bool Bookmarked { get; set; }

    [Parameter]
    public string? Size { get; set; }

}
