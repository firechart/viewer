@inject NavigationManager NavigationManager
@inject INavigationHistoryService NavigationHistoryService

<Center>
    <RadzenCard Variant="Radzen.Variant.Outlined">
        <IconTitle Icon=@(Icon ?? "info") IconColor=@IconColor Text=@(Caption ?? Strings.Caption_Information)/>
        @Message
        <DialogActions>
            @if (Actions != null)
            {
                @Actions
            }
            else
            {
                <RadzenButton ButtonStyle="Radzen.ButtonStyle.Warning" Text="OK" Click=@HandleOkAsync/>
            }
        </DialogActions>
    </RadzenCard>
</Center>

@code {

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? IconColor { get; set; }

    [Parameter]
    public string? Caption { get; set; }

    [Parameter]
    public RenderFragment? Message { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public EventCallback OnOK { get; set; }

    private async Task HandleOkAsync()
    {
        if (OnOK.HasDelegate)
        {
            await OnOK.InvokeAsync();
        }
        else
        {
            if (NavigationHistoryService.CanGoBack)
            {
                NavigationHistoryService.GoBack();
            }
            else
            {
                NavigationManager.NavigateToRoute("/");
            }
        }
    }

}
