@using BlazorBlueprint.Components
@implements IDisposable
@inject IServiceProvider Services

@if (_status is { IsUnavailable: true })
{
    <Alert Kind="AlertKind.Warning" Class="fixed inset-x-0 bottom-0 z-[9998] rounded-none">
        <div class="flex items-center justify-center flex-wrap gap-3">
            <span>@Strings.Identity_Unavailable</span>
            <Button Variant="ButtonVariant.Outline" Disabled=@_isRetrying OnClick=@RetryAsync>@Strings.Caption_Retry</Button>
        </div>
    </Alert>
}

@code {
    private IIdentityProviderStatus? _status;
    private bool _isRetrying;

    protected override void OnInitialized()
    {
        _status = Services.GetService<IIdentityProviderStatus>();
        if (_status is not null)
        {
            _status.Changed += OnChanged;
        }
    }

    private async Task RetryAsync()
    {
        _isRetrying = true;
        try
        {
            await _status!.RetryAsync();
        }
        finally
        {
            _isRetrying = false;
        }
    }

    private void OnChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_status is not null)
        {
            _status.Changed -= OnChanged;
        }
    }

}
