@* The commands at the end of a dialog or a form: on the right, the main one last, in one row on a phone too (stacked across the whole width they
   looked like two more fields) *@
<div class="mt-2 flex flex-wrap justify-end gap-2">
    @ChildContent
</div>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

}
