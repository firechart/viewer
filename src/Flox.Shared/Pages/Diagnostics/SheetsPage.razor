@using BlazorBlueprint.Components
@attribute [Route("/diagnostics/sheets")]

@inherits StatelessWidget

<AppBarTitle>Sheets</AppBarTitle>

<Breadcrumbs Items=@Breadcrumbs/>

<ListSection Title="Dialogs declared as components">
    <ListTile TitleText="Modal sheet" SubtitleText="A centered dialog, full screen on phones" OnSelected=@(() => _modal = true)/>
    <ListTile TitleText="Bottom sheet" SubtitleText="A side dialog docked to the bottom edge, resizable" OnSelected=@(() => _bottom = true)/>
</ListSection>

<ModalSheet @bind-IsOpen=@_modal TitleText="Modal sheet">
    <HeaderCommands>
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"><FloxIcon Icon="refresh"/></Button>
    </HeaderCommands>
    <ChildContent>
        <p class="m-0 text-base">The content is declared next to the page and shown by the dialog service.</p>
    </ChildContent>
</ModalSheet>

<BottomSheet @bind-IsOpen=@_bottom TitleText="Bottom sheet" Height="50dvh">
    <ChildContent>
        <p class="m-0 text-base">Drag the upper edge to resize, click the mask or the close button to close.</p>
    </ChildContent>
</BottomSheet>

@code {
    private bool _modal;
    private bool _bottom;
}
