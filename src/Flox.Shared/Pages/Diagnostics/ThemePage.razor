@attribute [Route("/diagnostics/theme")]
@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives

@inherits StatelessWidget

<AppBarTitle>Theme</AppBarTitle>

<Breadcrumbs Items=@Breadcrumbs/>

@* The gallery of the look: the facades of Flox and the components of Blazor Blueprint the clients use, in the current theme *@
<div class="flex flex-col">

    <ListSection Title="Typography">
        <div class="flex flex-col gap-1 p-4">
            <h1 class="m-0 text-3xl font-semibold tracking-tight">Heading 1</h1>
            <h2 class="m-0 text-2xl font-semibold tracking-tight">Heading 2</h2>
            <h3 class="m-0 text-xl font-semibold tracking-tight">Heading 3</h3>
            <h4 class="m-0 text-lg font-semibold">Heading 4</h4>
            <p class="m-0 text-base">Body text: the record of a patient, a list of packages, a form.</p>
            <p class="m-0 text-sm text-muted">Muted text: a hint under a field, a subtitle of a row.</p>
            <BbLink Href="about" Class="text-sm font-medium">A link</BbLink>
            <code class="text-sm">code: hl7.fhir.r4.core#4.0.1</code>
        </div>
    </ListSection>

    <ListSection Title="Buttons">
        <div class="flex flex-wrap items-center gap-2 p-4">
            <Button>Default</Button>
            <Button Variant="ButtonVariant.Secondary">Secondary</Button>
            <Button Variant="ButtonVariant.Outline">Outline</Button>
            <Button Variant="ButtonVariant.Ghost">Ghost</Button>
            <Button Variant="ButtonVariant.Destructive">Destructive</Button>
            <Button Variant="ButtonVariant.Link">Link</Button>
            <Button Disabled="true">Disabled</Button>
            <Button Loading="true">Loading</Button>
            <Button><FloxIcon Icon="add"/>With an icon</Button>
            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Refresh"><FloxIcon Icon="refresh"/></Button>
            <Button>Small</Button>
            <Button Size="ButtonSize.Large">Large</Button>
        </div>
    </ListSection>

    <ListSection Title="Form fields">
        <div class="flex flex-col gap-4 p-4">
            <FormField Text="Text" For="theme-text" Description="A hint under the field">
                <BbInput Id="theme-text" @bind-Value=_text/>
            </FormField>
            <FormField Text="Choice">
                <BbSelect TValue="string" @bind-Value=_choice Options=@s_choices.Select(SelectOption.FromValue) AriaLabel="Choice"/>
            </FormField>
            <FormField Text="Search a choice">
                <BbCombobox TValue="string" @bind-Value=_choice Options=@s_choices.Select(SelectOption.FromValue) AriaLabel="Search a choice" Class="w-full"/>
            </FormField>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <FormField Text="Date">
                    <BbDatePicker @bind-Value=_date AriaLabel="Date"/>
                </FormField>
                <FormField Text="Number" For="theme-number">
                    <BbNumericInput TValue="int" Id="theme-number" @bind-Value=_number Min="0" Max="10"/>
                </FormField>
            </div>
            <FormField Text="Password" For="theme-password">
                <BbInput Id="theme-password" Type="InputType.Password" @bind-Value=_password/>
            </FormField>
            <FormField Text="Notes" For="theme-notes">
                <BbTextarea Id="theme-notes" @bind-Value=_notes Placeholder="Several lines"/>
            </FormField>
            <FormField Text="Check box" For="theme-check" Horizontal="true">
                <BbCheckbox Id="theme-check" @bind-Checked=_check/>
            </FormField>
            <FormField Text="Switch" For="theme-switch" Horizontal="true">
                <Switch Id="theme-switch" @bind-Checked=_switch/>
            </FormField>
            <FormField Text="Radio">
                <BbRadioGroup TValue="int" @bind-Value=_radio AriaLabel="Radio">
                    <BbRadioGroupItem TValue="int" Value="1" Label="One" Id="theme-radio-1"/>
                    <BbRadioGroupItem TValue="int" Value="2" Label="Two" Id="theme-radio-2"/>
                </BbRadioGroup>
            </FormField>
            <FormField Text="Slider">
                <SliderWithDisplay T="int" Min="0" Max="100" Step="10" @bind-Value=_slider Label="Slider"/>
            </FormField>
            <FormField Text="Segments">
                <BbToggleGroup TValue="string" @bind-Value=_segment Variant="ToggleVariant.Outline" Size="ToggleSize.Small" Required="true">
                    <BbToggleGroupItem TValue="string" Value=@("snapshot")>Snapshot</BbToggleGroupItem>
                    <BbToggleGroupItem TValue="string" Value=@("differential")>Differential</BbToggleGroupItem>
                </BbToggleGroup>
            </FormField>
        </div>
    </ListSection>

    <ListSection Title="Badges">
        <div class="flex flex-wrap items-center gap-2 p-4">
            <BbBadge>Default</BbBadge>
            <BbBadge Variant="BadgeVariant.Secondary">Secondary</BbBadge>
            <BbBadge Variant="BadgeVariant.Outline">Outline</BbBadge>
            <BbBadge Variant="BadgeVariant.Destructive">Destructive</BbBadge>
            <BbBadge Variant="BadgeVariant.Success">Success</BbBadge>
            <BbBadge Variant="BadgeVariant.Warning">Warning</BbBadge>
            <BbBadge Variant="BadgeVariant.Info">Info</BbBadge>
        </div>
    </ListSection>

    <ListSection Title="Alerts">
        <div class="flex flex-col gap-2 p-4">
            <Alert Kind="AlertKind.Info" Title="Info">A note the user reads.</Alert>
            <Alert Kind="AlertKind.Success">The package is on the device.</Alert>
            <Alert Kind="AlertKind.Warning">The list may be out of date.</Alert>
            <Alert Kind="AlertKind.Danger" AllowClose="true">The server did not answer.</Alert>
            <Alert Plain="true">A plain note, without the colour of a kind.</Alert>
        </div>
    </ListSection>

    <ListSection Title="List tiles" List="true">
        <ListTile TitleText="Patient: Jane Doe" SubtitleText="Born 1984-02-11, female" Icon="person" TrailingText="12"/>
        <ListTile TitleText="Observation: Blood pressure" SubtitleText="120/80 mmHg, 2026-11-01" Icon="monitor_heart" OnSelected=@(() => { }) Chevron="true"/>
        <ListTile TitleText="A row without subtitle" Icon="description"/>
        <ListTileSkeleton Lines="2"/>
    </ListSection>

    <ListSection Title="Properties" Definitions="true">
        <PropertyTile Label="Name" Value="hl7.fhir.r4.core"/>
        <PropertyTile Label="Version" Value="4.0.1"/>
        <PropertyTile Label="Canonical" Value="http://hl7.org/fhir/StructureDefinition/Patient"/>
    </ListSection>

    <ListSection Title="Tabs">
        <div class="p-4">
            <BbTabs DefaultValue="view">
                <BbTabsList>
                    <BbTabsTrigger Value="view">View</BbTabsTrigger>
                    <BbTabsTrigger Value="source">Source</BbTabsTrigger>
                    <BbTabsTrigger Value="related">Related</BbTabsTrigger>
                </BbTabsList>
                <BbTabsContent Value="view"><p class="m-0 text-sm">The rendered resource.</p></BbTabsContent>
                <BbTabsContent Value="source"><p class="m-0 text-sm">The JSON source.</p></BbTabsContent>
                <BbTabsContent Value="related"><p class="m-0 text-sm">Related resources.</p></BbTabsContent>
            </BbTabs>
        </div>
    </ListSection>

    <ListSection Title="Table">
        <BbDataTable TData="Row" Data=@s_rows ShowPagination="true" InitialPageSize="4">
            <Columns>
                <BbDataTableColumn TData="Row" TValue="string" Property=@(row => row.Code) Header="Code" Sortable="true"/>
                <BbDataTableColumn TData="Row" TValue="string" Property=@(row => row.Display) Header="Display" Sortable="true"/>
                <BbDataTableColumn TData="Row" TValue="string" Property=@(row => row.Value) Header="Value"/>
            </Columns>
        </BbDataTable>
    </ListSection>

    <ListSection Title="Containers">
        <div class="flex flex-col gap-3 p-4">
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Card</BbCardTitle>
                    <BbCardDescription>A card with a header and content.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent><p class="m-0 text-sm">The content of the card.</p></BbCardContent>
            </BbCard>
            <details class="rounded-xl border border-line p-3">
                <summary class="cursor-pointer text-sm font-medium">A collapsible group</summary>
                <p class="m-0 mt-2 text-sm">The content of the group.</p>
            </details>
            <div class="flex flex-wrap items-center gap-3">
                <BbDropdownMenu>
                    <BbDropdownMenuTrigger><Button Variant="ButtonVariant.Outline">Menu</Button></BbDropdownMenuTrigger>
                    <BbDropdownMenuContent>
                        <PageMenuItem Icon="open_in_new" Text="Open"/>
                        <PageMenuItem Icon="delete" Text="Delete"/>
                    </BbDropdownMenuContent>
                </BbDropdownMenu>
                <CircularProgress/>
                <ProgressRing Value="60"/>
                <BbProgress Value="60" Class="w-48"/>
                <BbSkeleton Class="h-4 w-40"/>
            </div>
        </div>
    </ListSection>

    <ListSection Title="Dialogs and messages" List="true">
        <ListTile TitleText="Confirm dialog" SubtitleText="A message box with Delete and Cancel" Icon="help" OnSelected=@ConfirmAsync Chevron="true"/>
        <ListTile TitleText="Snack message" SubtitleText="A toast at the bottom with a command" Icon="chat" OnSelected=@ShowSnack Chevron="true"/>
        <ListTile TitleText="Error message" SubtitleText="An error that stays until it is closed" Icon="error" OnSelected=@(() => Notifications.Show("The server did not answer.", SnackSeverity.Error, 0)) Chevron="true"/>
    </ListSection>

</div>

@code {

    private static readonly string[] s_choices = ["Patient", "Practitioner", "Organization"];

    private static readonly Row[] s_rows =
    [
        new Row("8480-6", "Systolic blood pressure", "120 mmHg"),
        new Row("8462-4", "Diastolic blood pressure", "80 mmHg"),
        new Row("8867-4", "Heart rate", "72 /min"),
        new Row("8310-5", "Body temperature", "36.6 °C"),
        new Row("29463-7", "Body weight", "68 kg"),
        new Row("8302-2", "Body height", "172 cm")
    ];

    private string? _text = "Jane Doe";
    private string? _choice = "Patient";
    private DateTime? _date = new DateTime(1984, 2, 11);
    private int _number = 5;
    private string? _password = "secret";
    private string? _notes;
    private bool _check = true;
    private bool _switch = true;
    private int _radio = 1;
    private int _slider = 40;
    private string? _segment = "snapshot";

    protected override void InitBreadcrumbs()
    {
        Breadcrumbs.Add("Diagnostics", href: "/diagnostics");
    }

    private async Task ConfirmAsync()
    {
        await DialogService.ShowMessageBoxAsync("Delete", "Delete the selected server?", "Delete", cancelText: "Cancel");
    }

    private void ShowSnack()
    {
        Notifications.Show("The bookmark was deleted.", SnackSeverity.Info, actionText: "Undo", action: () => Notifications.Show("Restored.", SnackSeverity.Success));
    }

    private sealed record Row(string Code, string Display, string Value);
}
