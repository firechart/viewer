@attribute [Route("/diagnostics/theme")]

@inherits StatelessWidget

<AppBarTitle>Theme</AppBarTitle>

<Breadcrumbs Items=@Breadcrumbs/>

<RadzenStack Gap="var(--gap-lg)">

    <ListSection Caption="Typography">
        <RadzenStack Gap="var(--gap-xs)" class="p-4">
            <RadzenText TextStyle="TextStyle.H4">Heading 4: Patient summary</RadzenText>
            <RadzenText TextStyle="TextStyle.H5">Heading 5: Observations</RadzenText>
            <RadzenText TextStyle="TextStyle.H6">Heading 6: Vital signs</RadzenText>
            <RadzenText TextStyle="TextStyle.Subtitle1">Subtitle 1: the active medication list</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">Body 2: the usual text of the application, a sentence long enough to see the line height.</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption">Caption: secondary text, dates and counters</RadzenText>
            <RadzenText TextStyle="TextStyle.Overline">Overline: a group label</RadzenText>
            <RadzenLink Text="A link to somewhere" Path="/diagnostics"/>
        </RadzenStack>
    </ListSection>

    <ListSection Caption="Buttons">
        <RadzenStack Gap="var(--gap-md)" class="p-4">
            @foreach (var variant in s_variants)
            {
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)" Wrap="Radzen.FlexWrap.Wrap" AlignItems="Radzen.AlignItems.Center">
                    <RadzenText TextStyle="TextStyle.Caption" class="w-20">@variant</RadzenText>
                    @foreach (var style in s_buttonStyles)
                    {
                        <RadzenButton Variant=@variant ButtonStyle=@style Text=@style.ToString()/>
                    }
                    <RadzenButton Variant=@variant ButtonStyle="Radzen.ButtonStyle.Primary" Text="Disabled" Disabled/>
                </RadzenStack>
            }
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)" Wrap="Radzen.FlexWrap.Wrap" AlignItems="Radzen.AlignItems.Center">
                <RadzenText TextStyle="TextStyle.Caption" class="w-20">Sizes</RadzenText>
                @foreach (var size in s_buttonSizes)
                {
                    <RadzenButton Size=@size Text=@size.ToString()/>
                }
                @foreach (var size in s_buttonSizes)
                {
                    <RadzenButton Size=@size Variant="Radzen.Variant.Text" ButtonStyle="Radzen.ButtonStyle.Base"><FloxIcon Icon="refresh"/></RadzenButton>
                }
                <RadzenButton><FloxIcon Icon="add"/><span>With icon</span></RadzenButton>
                <RadzenButton Text="Busy" IsBusy BusyText="Saving..."/>
            </RadzenStack>
        </RadzenStack>
    </ListSection>

    <ListSection Caption="Form fields">
        <RadzenStack Gap="var(--gap-md)" class="p-4">
            <RadzenRow Gap="var(--gap-md)">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Variant="Radzen.Variant.Text" Text="Name" class="w-full">
                        <RadzenTextBox @bind-Value=@_text Placeholder="Jane Doe"/>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Variant="Radzen.Variant.Text" Text="Empty field" class="w-full">
                        <RadzenTextBox Placeholder="Placeholder"/>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Variant="Radzen.Variant.Text" Text="Kind" class="w-full">
                        <RadzenDropDown @bind-Value=@_choice Data=@s_choices/>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Variant="Radzen.Variant.Text" Text="Birth date" class="w-full">
                        <RadzenDatePicker @bind-Value=@_date DateFormat="d"/>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Variant="Radzen.Variant.Text" Text="Count" class="w-full">
                        <RadzenNumeric @bind-Value=@_number/>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Variant="Radzen.Variant.Text" Text="Password" class="w-full">
                        <RadzenPassword @bind-Value=@_password/>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Variant="Radzen.Variant.Text" Text="Invalid field" class="w-full">
                        <ChildContent>
                            <RadzenTextBox class="invalid" Value="not a url"/>
                        </ChildContent>
                        <Helper>
                            <RadzenText TextStyle="TextStyle.Caption" class="text-danger">The address must start with https://</RadzenText>
                        </Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Variant="Radzen.Variant.Text" Text="Disabled" class="w-full">
                        <RadzenTextBox Value="Read only" Disabled/>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12">
                    <RadzenFormField Variant="Radzen.Variant.Text" Text="Notes" class="w-full">
                        <RadzenTextArea @bind-Value=@_notes Rows="3"/>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)" AlignItems="Radzen.AlignItems.Center" Wrap="Radzen.FlexWrap.Wrap">
                <RadzenTextBox Placeholder="A bare text box" class="w-60"/>
                <RadzenDropDown @bind-Value=@_choice Data=@s_choices class="w-48"/>
                <RadzenButton Text="Search"/>
            </RadzenStack>

            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-lg)" AlignItems="Radzen.AlignItems.Center" Wrap="Radzen.FlexWrap.Wrap">
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)" AlignItems="Radzen.AlignItems.Center">
                    <RadzenCheckBox @bind-Value=@_check Name="check"/>
                    <RadzenLabel Text="Check box" Component="check"/>
                </RadzenStack>
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)" AlignItems="Radzen.AlignItems.Center">
                    <RadzenCheckBox TValue="bool" Value="false" Name="check2"/>
                    <RadzenLabel Text="Unchecked" Component="check2"/>
                </RadzenStack>
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)" AlignItems="Radzen.AlignItems.Center">
                    <RadzenSwitch @bind-Value=@_switch Name="switch"/>
                    <RadzenLabel Text="Switch" Component="switch"/>
                </RadzenStack>
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)" AlignItems="Radzen.AlignItems.Center">
                    <RadzenSwitch Value="false" Name="switch2"/>
                    <RadzenLabel Text="Off" Component="switch2"/>
                </RadzenStack>
                <RadzenRadioButtonList @bind-Value=@_radio TValue="int">
                    <Items>
                        <RadzenRadioButtonListItem TValue="int" Text="One" Value="1"/>
                        <RadzenRadioButtonListItem TValue="int" Text="Two" Value="2"/>
                    </Items>
                </RadzenRadioButtonList>
                <RadzenSlider @bind-Value=@_slider TValue="int" Min="0" Max="100" class="w-48"/>
            </RadzenStack>
        </RadzenStack>
    </ListSection>

    <ListSection Caption="Badges and chips">
        <RadzenStack Gap="var(--gap-md)" class="p-4">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)" Wrap="Radzen.FlexWrap.Wrap" AlignItems="Radzen.AlignItems.Center">
                @foreach (var style in s_badgeStyles)
                {
                    <RadzenBadge BadgeStyle=@style Text=@style.ToString()/>
                }
            </RadzenStack>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)" Wrap="Radzen.FlexWrap.Wrap" AlignItems="Radzen.AlignItems.Center">
                @foreach (var style in s_badgeStyles)
                {
                    <RadzenBadge BadgeStyle=@style Variant="Radzen.Variant.Outlined" Text=@style.ToString()/>
                }
            </RadzenStack>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)" Wrap="Radzen.FlexWrap.Wrap" AlignItems="Radzen.AlignItems.Center">
                @foreach (var style in s_badgeStyles)
                {
                    <RadzenChip ChipStyle=@style Size="Radzen.ChipSize.Small" Text=@style.ToString()/>
                }
                <RadzenChip Text="Medium chip"/>
            </RadzenStack>
        </RadzenStack>
    </ListSection>

    <ListSection Caption="Alerts">
        <RadzenStack Gap="var(--gap-sm)" class="p-4">
            @foreach (var style in s_alertStyles)
            {
                <RadzenAlert AlertStyle=@style Variant="Radzen.Variant.Flat" AllowClose="false">@style: the FHIR server did not answer in time.</RadzenAlert>
            }
            <RadzenAlert AlertStyle="Radzen.AlertStyle.Warning" Variant="Radzen.Variant.Flat" AllowClose="false" Size="Radzen.AlertSize.Small">Small warning alert</RadzenAlert>
            <RadzenAlert AlertStyle="Radzen.AlertStyle.Danger" Variant="Radzen.Variant.Filled" AllowClose="false">Filled danger alert</RadzenAlert>
            <RadzenAlert AlertStyle="Radzen.AlertStyle.Info" Variant="Radzen.Variant.Outlined" AllowClose="false">Outlined info alert</RadzenAlert>
        </RadzenStack>
    </ListSection>

    <ListSection Caption="List tiles">
        <ListTile TitleText="Patient: Jane Doe" SubtitleText="Born 1984-02-11, female" Icon="person" TrailingText="12"/>
        <ListTile TitleText="Observation: Blood pressure" SubtitleText="120/80 mmHg, 2026-11-01" Icon="monitor_heart" OnSelected=@(() => { })/>
        <ListTile TitleText="A row without subtitle" Icon="description"/>
    </ListSection>

    <ListSection Caption="Tabs">
        <RadzenTabs>
            <Tabs>
                <RadzenTabsItem Text="View"><RadzenText>The rendered resource.</RadzenText></RadzenTabsItem>
                <RadzenTabsItem Text="Source"><RadzenText>The JSON source.</RadzenText></RadzenTabsItem>
                <RadzenTabsItem Text="Related"><RadzenText>Related resources.</RadzenText></RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </ListSection>

    <ListSection Caption="Data grid">
        <RadzenDataGrid TItem="Row" Data=@s_rows AllowPaging PageSize="4" AllowSorting PagerHorizontalAlign="Radzen.HorizontalAlign.Left">
            <Columns>
                <RadzenDataGridColumn TItem="Row" Property="Code" Title="Code" Width="120px"/>
                <RadzenDataGridColumn TItem="Row" Property="Display" Title="Display"/>
                <RadzenDataGridColumn TItem="Row" Property="Value" Title="Value" Width="120px" TextAlign="Radzen.TextAlign.Right"/>
            </Columns>
        </RadzenDataGrid>
    </ListSection>

    <ListSection Caption="Containers">
        <RadzenStack Gap="var(--gap-md)" class="p-4">
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6">Card</RadzenText>
                <RadzenText>A card with the default padding.</RadzenText>
            </RadzenCard>
            <RadzenFieldset Text="Fieldset">
                <RadzenText>Content of the fieldset.</RadzenText>
            </RadzenFieldset>
            <RadzenPanel AllowCollapse Text="Collapsible panel">
                <RadzenText>Content of the panel.</RadzenText>
            </RadzenPanel>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="var(--gap-sm)" AlignItems="Radzen.AlignItems.Center">
                <RadzenMenu>
                    <RadzenMenuItem Text="Menu">
                        <RadzenMenuItem Text="Open" Icon="open_in_new"/>
                        <RadzenMenuItem Text="Delete" Icon="delete"/>
                    </RadzenMenuItem>
                </RadzenMenu>
                <CircularProgress/>
                <RadzenProgressBar Value="60" class="w-48"/>
                <RadzenSkeleton class="h-4 w-40"/>
            </RadzenStack>
        </RadzenStack>
    </ListSection>

    <ListSection Caption="Dialogs">
        <ListTile TitleText="Confirm dialog" SubtitleText="Radzen's Confirm with OK and Cancel" OnSelected=@ConfirmAsync/>
    </ListSection>

</RadzenStack>

@code {
    private static readonly Radzen.Variant[] s_variants = [Radzen.Variant.Filled, Radzen.Variant.Flat, Radzen.Variant.Outlined, Radzen.Variant.Text];

    private static readonly Radzen.ButtonStyle[] s_buttonStyles =
    [
        Radzen.ButtonStyle.Primary, Radzen.ButtonStyle.Secondary, Radzen.ButtonStyle.Base, Radzen.ButtonStyle.Light, Radzen.ButtonStyle.Dark,
        Radzen.ButtonStyle.Success, Radzen.ButtonStyle.Danger, Radzen.ButtonStyle.Warning, Radzen.ButtonStyle.Info
    ];

    private static readonly Radzen.ButtonSize[] s_buttonSizes = [Radzen.ButtonSize.ExtraSmall, Radzen.ButtonSize.Small, Radzen.ButtonSize.Medium, Radzen.ButtonSize.Large];

    private static readonly Radzen.BadgeStyle[] s_badgeStyles =
    [
        Radzen.BadgeStyle.Primary, Radzen.BadgeStyle.Secondary, Radzen.BadgeStyle.Base, Radzen.BadgeStyle.Light,
        Radzen.BadgeStyle.Success, Radzen.BadgeStyle.Danger, Radzen.BadgeStyle.Warning, Radzen.BadgeStyle.Info
    ];

    private static readonly Radzen.AlertStyle[] s_alertStyles =
        [Radzen.AlertStyle.Primary, Radzen.AlertStyle.Success, Radzen.AlertStyle.Warning, Radzen.AlertStyle.Danger, Radzen.AlertStyle.Info];

    private static readonly string[] s_choices = ["Patient", "Practitioner", "Organization"];

    private static readonly Row[] s_rows =
    [
        new Row("8480-6", "Systolic blood pressure", "120 mmHg"),
        new Row("8462-4", "Diastolic blood pressure", "80 mmHg"),
        new Row("8867-4", "Heart rate", "72 /min"),
        new Row("8310-5", "Body temperature", "36.6 °C"),
        new Row("29463-7", "Body weight", "68 kg"),
        new Row("8302-2", "Body height", "172 cm")
    ];

    private string? _text = "Jane Doe";
    private string? _choice = "Patient";
    private DateTime? _date = new DateTime(1984, 2, 11);
    private int _number = 5;
    private string? _password = "secret";
    private string? _notes;
    private bool _check = true;
    private bool _switch = true;
    private int _radio = 1;
    private int _slider = 40;

    protected override void InitBreadcrumbs()
    {
        Breadcrumbs.Add("Diagnostics", href: "/diagnostics");
        Breadcrumbs.Add("Theme", href: "/diagnostics/theme");
    }

    private async Task ConfirmAsync()
    {
        await DialogService.Confirm("Delete the selected server?", "Delete");
    }

    private sealed record Row(string Code, string Display, string Value);
}
