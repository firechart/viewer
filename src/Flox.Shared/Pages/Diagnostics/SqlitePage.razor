@attribute [Route("/diagnostics/sqlite")]

@using Flox.Core.Data
@using Flox.Sqlite

@inject IServiceProvider Services

<AppBarTitle>SQLite</AppBarTitle>

@* The scenarios of the engines on the engine of this client, in this browser; data-sqlite-self-test is read by a test of the browser *@
<RadzenStack Gap="var(--gap-sm)" class="rz-p-3" data-sqlite-self-test=@_state>
    @if (_engine is null)
    {
        <RadzenText>This client has no SQLite engine (ISqliteEngine).</RadzenText>
    }
    else
    {
        <RadzenText TextStyle="TextStyle.Caption">@_engine.GetType().Name: @_state</RadzenText>
        @foreach (var check in _checks)
        {
            <RadzenText data-sqlite-check=@(check.Passed ? "passed" : "failed")>
                @(check.Passed ? "✓" : "✗") @check.Name (@check.Milliseconds.ToString("0") ms): @check.Message
            </RadzenText>
        }
    }
</RadzenStack>

@code {
    private ISqliteEngine? _engine;
    private IReadOnlyList<SqliteCheck> _checks = [];
    private string _state = "running";

    protected override async Task OnInitializedAsync()
    {
        _engine = Services.GetService<ISqliteEngine>();
        if (_engine is null)
        {
            _state = "no engine";
            return;
        }

        _checks = await new SqliteSelfTest(_engine, Services.GetService<ILocalDocumentStore>()).RunAsync();
        _state = _checks.All(check => check.Passed) ? "passed" : "failed";
    }
}
