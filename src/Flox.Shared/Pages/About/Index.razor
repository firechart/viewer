@attribute [Route("/about")]

@inherits StatefulWidget<AboutState>

<AppBarTitle>@Strings.About</AppBarTitle>

<BusyOverlay Busy=@State.IsBusy Concealed=@State.Activating>

<RadzenTabs class="rz-mt-2">
    <Tabs>
        @if (State.AppBranding != null)
        {
            <RadzenTabsItem Text=@Strings.Caption_AboutThisApp>
                <ModuleInfoWidget Branding=@State.AppBranding/>
            </RadzenTabsItem>
        }

        @if (State.PlatformBranding != null)
        {
            <RadzenTabsItem Text=@Strings.Caption_AboutPlatform>
                <ModuleInfoWidget Branding=@State.PlatformBranding/>
            </RadzenTabsItem>
        }
    </Tabs>
</RadzenTabs>
</BusyOverlay>


