@inject IJSRuntime JS

@if (Branding == null)
{
    return;
}

<div class="flex flex-col items-center gap-1 mt-4 mb-6">
    <div class="flex items-center gap-3">
        <img class="size-16 shrink-0 rounded-lg object-contain" src=@Branding.Icon alt=@Branding.Title/>
        <h2 class="m-0 text-base font-bold text-accent-ink">@Branding.Title</h2>
    </div>

    <h6 class="m-0 text-sm font-medium mt-2 text-center">@Branding.Subtitle</h6>
</div>

<ListSection Title=@Strings.Caption_AboutThisApp>
    @if (!string.IsNullOrEmpty(Branding.Version))
    {
        <ListTile TitleText=@Strings.Caption_Version SubtitleText=@Branding.Version/>
    }
    <ListTile TitleText=@Strings.Caption_Authors SubtitleText=@Branding.Authors/>
    @if (!string.IsNullOrEmpty(Branding.SourceCodeUrl))
    {
        <ListTile TitleText=@Strings.Caption_SourceCode SubtitleText=@Branding.SourceCodeUrl OnClick="() => OpenPackageUrl(Branding.SourceCodeUrl)">
            <Trailing>
                <FloxIcon Icon="open_in_new" Size="1.25rem" Color="var(--muted-foreground)"/>
            </Trailing>
        </ListTile>
    }
    <ListTile TitleText=@Strings.Caption_License SubtitleText=@(Branding.LicenseType ?? Branding.LicenseUrl) OnClick="() => OpenPackageUrl(Branding.LicenseUrl)">
        <Trailing>
            @if (!string.IsNullOrEmpty(Branding.LicenseUrl))
            {
                <FloxIcon Icon="open_in_new" Size="1.25rem" Color="var(--muted-foreground)"/>
            }
        </Trailing>
    </ListTile>
</ListSection>

@ChildContent

@code {

    [Parameter]
    public FloxBranding? Branding { get; set; }

    // What the page puts under the license: the sections of the modules (IAboutSection), the third-party components
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private Task OpenPackageUrl(string? url)
    {
        if (string.IsNullOrEmpty(url))
        {
            return Task.CompletedTask;
        }

        return JS.InvokeVoidAsync("window.open", url, "_blank")
                  .AsTask();
    }

}
