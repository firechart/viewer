@using BlazorBlueprint.Components
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS

@* The third-party components of the application that runs: its own list beside its page (wwwroot/licenses.json, made by the skill
   package-upgrade), read when the page opens, not shipped in an assembly *@

<ListSection Title=@Strings.Caption_UsedComponents>
    @if (_licenses == null)
    {
        <div class="flex justify-center p-4"><CircularProgress/></div>
    }
    else if (_licenses.Count == 0)
    {
        <p class="m-0 text-sm p-4">No license information available.</p>
    }
    else
    {
        @foreach (var entry in _licenses)
        {
            <ListTile TitleText="@entry.PackageId"
                      OnClick="() => OpenPackageUrl(entry.PackageProjectUrl)"
            >
                <Subtitle>
                    <div class="flex gap-2">
                        <BbBadge Variant="BadgeVariant.Outline">@entry.License</BbBadge>
                        <BbBadge Variant="BadgeVariant.Outline">@entry.PackageVersion</BbBadge>
                    </div>
                </Subtitle>
                <Trailing>
                    @if (!string.IsNullOrEmpty(entry.PackageProjectUrl))
                    {
                        <FloxIcon Icon="open_in_new" Size="1.25rem" Color="var(--muted-foreground)"/>
                    }
                </Trailing>
            </ListTile>
        }
    }
</ListSection>

@code {

    // Relative to the base of the page: the application's own wwwroot (WebAssembly)
    private const string LICENSES_URL = "licenses.json";

    private IJSObjectReference? _module;
    private IReadOnlyList<LicenseEntry>? _licenses;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _licenses = await LoadAsync();
        StateHasChanged();
    }

    private async Task<IReadOnlyList<LicenseEntry>> LoadAsync()
    {
        try
        {
            _module = await JS.ImportModuleAsync("./_content/Flox.Shared/Pages/About/UsedComponentsWidget.razor.js");
            var json = await _module.InvokeAsync<string?>("loadText", LICENSES_URL);
            if (string.IsNullOrEmpty(json))
            {
                return [];
            }

            var rows = JsonSerializer.Deserialize<List<LicenseEntry>>(json) ?? [];
            return [.. rows.OrderBy(row => row.PackageId, StringComparer.OrdinalIgnoreCase)];
        }
        catch (Exception ex) when (ex is JSException or JsonException)
        {
            return [];
        }
    }

    private Task OpenPackageUrl(string? url)
    {
        if (string.IsNullOrEmpty(url))
        {
            return Task.CompletedTask;
        }

        return JS.InvokeVoidAsync("window.open", url, "_blank")
                  .AsTask();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module == null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

}
