@attribute [Route(SharedRoutes.MORE)]

@inherits StatelessWidget

@inject IFloxShell Shell
@inject IAuthorizationService AuthorizationService

<AppBarTitle>@Strings.Caption_More</AppBarTitle>

@foreach (var (menu, nodes) in _sections)
{
    <ListSection Title=@menu.Text>
        @foreach (var node in nodes)
        {
            @* A group without a page of its own shows its children *@
            @foreach (var target in string.IsNullOrEmpty(node.Item.Href) ? node.Children.Select(row => row.Item) : [node.Item])
            {
                <ListTile TitleText=@target.Text Icon=@target.Icon Href=@target.Href Chevron/>
            }
        }
    </ListSection>
}

@if (_loaded && _sections.Count == 0)
{
    <p class="m-0 text-sm text-muted">@Strings.List_NoData</p>
}

@code {
    private List<(IFloxMenu Menu, List<NavMenuNode> Nodes)> _sections = [];
    private bool _loaded;
    private Task<AuthenticationState>? _builtFor;

    // The state cascades again when the user signs in or out: the menu is built for the new user
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(_builtFor, AuthenticationState))
        {
            return;
        }

        _builtFor = AuthenticationState;
        var user = (await AuthenticationState).User;
        _sections = await MenuFilter.BuildAsync(Shell, AuthorizationService, user, FloxMenuPlacement.More);
        _loaded = true;
    }
}
