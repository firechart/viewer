@using BlazorBlueprint.Components
@using System.Globalization
@using Flox.Core.Settings
@implements IDisposable
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<EditForm EditContext=@Section.EditContext>
    <DataAnnotationsValidator/>
    @* A section is a group of fields under a modest legend (FieldSet of Blueprint); a group of the section is a group under a label *@
    <BbFieldSet>
        <BbFieldLegend Class="text-base font-semibold">@Section.Descriptor.Title</BbFieldLegend>
        @if (!string.IsNullOrEmpty(Section.Descriptor.Description))
        {
            <BbFieldDescription>@Section.Descriptor.Description</BbFieldDescription>
        }
        @foreach (var group in Groups)
        {
            <BbFieldGroup>
                @if (group.Key is not null)
                {
                    <BbFieldLegend Variant="FieldLegendVariant.Label" Class="text-muted">@group.Key</BbFieldLegend>
                }
                @foreach (var setting in group)
                {
                    <SettingField Field=@setting Context=@Section.EditContext/>
                }
            </BbFieldGroup>
        }
    </BbFieldSet>
</EditForm>

@code {

    private EditContext? _subscribed;
    private EditContext? _renderedContext;
    private string? _renderedCulture;

    [Parameter][EditorRequired]
    public SettingsSectionState Section { get; set; } = null!;

    [Parameter]
    public EventCallback OnModified { get; set; }

    // Fields without a group come first, groups follow in the order of their first field; a field of a feature the application lacks is not shown
    private IEnumerable<IGrouping<string?, SettingFieldDescriptor>> Groups
    {
        get
        {
            return Section.Descriptor.Fields.Where(setting => setting.IsShownWith(Configuration)).GroupBy(setting => setting.GroupName);
        }
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribed, Section.EditContext))
        {
            _subscribed?.OnFieldChanged -= OnFieldChanged;
            _subscribed = Section.EditContext;
            _subscribed.OnFieldChanged += OnFieldChanged;
        }
    }

    // The page renders on every change of any field; the fields render themselves, this one only for another form or another language
    protected override bool ShouldRender()
    {
        return !ReferenceEquals(_renderedContext, Section.EditContext) || _renderedCulture != CultureInfo.CurrentUICulture.Name;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        _renderedContext = Section.EditContext;
        _renderedCulture = CultureInfo.CurrentUICulture.Name;
    }

    public void Dispose()
    {
        _subscribed?.OnFieldChanged -= OnFieldChanged;
    }

    private void OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        _ = OnModified.InvokeAsync();
    }

}
