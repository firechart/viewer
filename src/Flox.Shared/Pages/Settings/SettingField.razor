@using BlazorBlueprint.Components
@using System.Globalization
@using Flox.Core.Settings
@implements IDisposable

@switch (Field.Control)
{
    case SettingControl.Switch:
        <FormField Text=@Field.Label For=@Field.Name Description=@Field.Description Horizontal="true" MessagesId=@MessagesId Messages=@Messages Invalid=@Invalid>
            <Switch Id=@Field.Name Checked=@((bool)GetValue()!) CheckedChanged="@((bool value) => SetValue(value))" @attributes=@Aria()/>
        </FormField>
        break;

    case SettingControl.Slider:
        <FormField Text=@Field.Label Description=@Field.Description MessagesId=@MessagesId Messages=@Messages Invalid=@Invalid>
            <SliderWithDisplay T="int" Min=@((int)(Field.Minimum ?? 0)) Max=@((int)(Field.Maximum ?? 100)) Step=@(Math.Max(Field.Step, 1)) Value=@((int)GetValue()!) ValueChanged="@((int value) => SetValue(value))" Label=@Field.Label/>
        </FormField>
        break;

    case SettingControl.RadioList:
        <FormField Text=@Field.Label Description=@Field.Description MessagesId=@MessagesId Messages=@Messages Invalid=@Invalid>
            <BbRadioGroup TValue="object" Value=@(GetValue()!) ValueChanged="@((object value) => SetValue(value))" AriaLabel=@Field.Label @attributes=@Aria()>
                @foreach (var option in _options)
                {
                    <BbRadioGroupItem TValue="object" Value=@(option.Value!) Label=@option.Text Id=@($"{Field.Name}-{option.Value}")/>
                }
            </BbRadioGroup>
        </FormField>
        break;

    default:
        <FormField Text=@Field.Label For=@Field.Name Description=@Field.Description MessagesId=@MessagesId Messages=@Messages Invalid=@Invalid>
            @switch (Field.Control)
            {
                case SettingControl.Dropdown:
                    <BbSelect TValue="object" Value=@GetValue() ValueChanged="@((object? value) => SetValue(value))" Options=@_selectOptions AriaLabel=@Field.Label
                              id=@Field.Name @attributes=@Aria()/>
                    break;

                case SettingControl.Number:
                    <BbNumericInput TValue="decimal" Id=@Field.Name Name=@Field.Name Value=@Convert.ToDecimal(GetValue(), CultureInfo.InvariantCulture) ValueChanged="@((decimal value) => SetValue(value))"
                                    Min=@Field.Minimum Max=@Field.Maximum AriaInvalid=@Invalid AriaDescribedBy=@(Invalid ? MessagesId : null)/>
                    break;

                case SettingControl.Password:
                    <BbInput Type="InputType.Password" Id=@Field.Name Name=@Field.Name Value=@((string?)GetValue()) ValueChanged="@((string? value) => SetValue(value))" UpdateTiming="UpdateTiming.Immediate" @attributes=@Aria()/>
                    break;

                case SettingControl.TextArea:
                    <BbTextarea Id=@Field.Name Name=@Field.Name Value=@((string?)GetValue()) ValueChanged="@((string? value) => SetValue(value))" UpdateTiming="UpdateTiming.Immediate" rows="4" @attributes=@Aria()/>
                    break;

                default:
                    <BbInput Id=@Field.Name Name=@Field.Name Value=@((string?)GetValue()) ValueChanged="@((string? value) => SetValue(value))" UpdateTiming="UpdateTiming.Immediate" @attributes=@Aria()/>
                    break;
            }
        </FormField>
        break;
}

@code {

    private FieldIdentifier _identifier;
    private IReadOnlyList<SettingOption> _options = [];
    private IReadOnlyList<BlazorBlueprint.Primitives.SelectOption<object>> _selectOptions = [];
    private SettingFieldDescriptor? _optionsField;
    private string? _optionsCulture;
    private EditContext? _renderedContext;
    private SettingFieldDescriptor? _renderedField;
    private string? _renderedCulture;
    private bool _force;
    private EditContext? _subscribed;

    [Parameter][EditorRequired]
    public EditContext Context { get; set; } = null!;

    [Parameter][EditorRequired]
    public SettingFieldDescriptor Field { get; set; } = null!;

    private string LabelId => $"{Field.Name}-label";

    private string MessagesId => $"{Field.Name}-messages";

    // aria-invalid and, while invalid, the messages in aria-describedby
    private Dictionary<string, object> Aria(bool invalidAttribute = true)
    {
        return FieldAria.For(Context, _identifier, MessagesId, invalidAttribute);
    }

    private bool Invalid => FieldAria.IsInvalid(Context, _identifier);

    private RenderFragment Messages => @<text>@foreach (var message in Context.GetValidationMessages(_identifier))
                                              {
                                                  <div>@message</div>
                                              }</text>;

    protected override void OnParametersSet()
    {
        _identifier = Context.Field(Field.Name);

        // The options are rebuilt only for another field or another language
        var culture = CultureInfo.CurrentUICulture.Name;
        if (!ReferenceEquals(_optionsField, Field) || _optionsCulture != culture)
        {
            _options = Field.GetOptions();
            _selectOptions = [.. _options.Select(option => new BlazorBlueprint.Primitives.SelectOption<object>(option.Value!, option.Text))];
            _optionsField = Field;
            _optionsCulture = culture;
        }

        if (!ReferenceEquals(_subscribed, Context))
        {
            _subscribed?.OnValidationStateChanged -= OnValidationStateChanged;
            _subscribed = Context;
            _subscribed.OnValidationStateChanged += OnValidationStateChanged;
        }
    }

    // The parent renders on every change of any field: this one renders when it is another field, another form or another language, or by its own change
    protected override bool ShouldRender()
    {
        return _force || !ReferenceEquals(_renderedContext, Context) || !ReferenceEquals(_renderedField, Field) || _renderedCulture != CultureInfo.CurrentUICulture.Name;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        _renderedContext = Context;
        _renderedField = Field;
        _renderedCulture = CultureInfo.CurrentUICulture.Name;
        _force = false;
    }

    public void Dispose()
    {
        _subscribed?.OnValidationStateChanged -= OnValidationStateChanged;
    }

    private object? GetValue()
    {
        return Field.Property.GetValue(Context.Model) ?? (Field.UnderlyingType.IsValueType ? Activator.CreateInstance(Field.UnderlyingType) : null);
    }

    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
    {
        _force = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void SetValue(object? value)
    {
        if (value is not null && value.GetType() != Field.UnderlyingType && !Field.UnderlyingType.IsEnum)
        {
            value = Convert.ChangeType(value, Field.UnderlyingType);
        }

        Field.Property.SetValue(Context.Model, value);
        _force = true;
        Context.NotifyFieldChanged(_identifier);
    }

}
