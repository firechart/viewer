@using BlazorBlueprint.Components
@attribute [Route(SharedRoutes.SETTINGS)]
@attribute [Authorize]

@inherits StatefulWidget<SettingsPageState>

<AppBarTitle>@Strings.Caption_Settings</AppBarTitle>

<Breadcrumbs Items=@Breadcrumbs />

<NavigationLock OnBeforeInternalNavigation=@OnBeforeNavigationAsync/>

<BusyOverlay Busy=@State.IsBusy Concealed=@State.Activating>
    @* The buttons end where the fields end, not at the edge of a wide window *@
    <div class="max-w-2xl">
        <div class="my-2 flex flex-col gap-6">
            @foreach (var (section, index) in State.Sections.Select((section, index) => (section, index)))
            {
                @if (index > 0)
                {
                    <BbFieldSeparator/>
                }
                <SettingsSection Section=@section OnModified=@StateHasChanged/>
            }
        </div>

        <DialogActions>
            <Button Variant="ButtonVariant.Outline" OnClick=@State.ResetAsync>@Strings.Caption_Reset</Button>
            <Button Disabled=@(!State.IsModified) OnClick=@State.SaveAsync>@Strings.Caption_Save</Button>
        </DialogActions>
    </div>
</BusyOverlay>

    @code {

    private async Task OnBeforeNavigationAsync(LocationChangingContext context)
    {
        if (!State.IsModified)
        {
            return;
        }

        if (await this.ConfirmAsync(Strings.Message_DiscardUnsavedChanges))
        {
            await State.DiscardAsync();
        }
        else
        {
            context.PreventNavigation();
        }
    }

}
