@page "/login"

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@* Starts the sign-in of the provider; whoever is signed in already (the provider brings the browser back here) goes to the home page *@
<AppBarTitle>@Strings.Caption_Login</AppBarTitle>

@code {
    [Inject]
    public IAuthenticationService AuthenticationService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (user.IsAuthenticated())
        {
            Navigation.NavigateTo(AppUrl.ToHref(SharedRoutes.HOME), replace: true);
            return;
        }

        await AuthenticationService.LoginAsync();
    }
}
