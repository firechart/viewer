@* The static application of the Viewer: the sandbox at /, the frame at /embed, the way back of a SMART sign-in at /smart/callback *@
@* The overlays of Blazor Blueprint (dialogs, popovers, menus), its programmatic dialogs and its toasts *@
<BlazorBlueprint.Primitives.BbPortalHost/>
<BlazorBlueprint.Components.BbDialogProvider/>
<BlazorBlueprint.Components.BbToastProvider Position="BlazorBlueprint.Components.ToastPosition.BottomCenter"/>
<Flox.Shared.Components.FloxDialogHost/>

<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData"/>
    </Found>
    <NotFound>
        <PageTitle>FireChart Viewer</PageTitle>
        <Alert Kind="AlertKind.Warning">Nothing at this address.</Alert>
    </NotFound>
</Router>
