@using BlazorBlueprint.Components
@page "/smart/callback"
@inject ISmartAuthorizer Authorizer
@inject NavigationManager NavigationManager

@* The way back of a SMART sign-in in the frame (redirect): the code is exchanged for a token; the patient of the launch context opens the patient summary,
   else (and always in the frame of the Bundle Visualizer) the frame returns where the sign-in began *@
<div class="p-4">
    @if (_failure is null)
    {
        <CircularProgress Compact="true"/>
    }
    else
    {
        <div class="flex flex-col gap-4 max-w-md">
            <Alert Kind="AlertKind.Warning">@_failure</Alert>
            <Button Variant="ButtonVariant.Secondary" OnClick=@(() => NavigationManager.NavigateTo(EmbedPage.Prefix))>Back to the viewer</Button>
        </div>
    }
</div>

@code {

    public const string Route = "smart/callback";

    // The sign-in of a component of the app: its flow, back to this page
    public static SmartOptions OptionsOf(NavigationManager navigation, SmartFlow flow)
    {
        return new SmartOptions { Flow = flow, RedirectUri = navigation.ToAbsoluteUri(Route).ToString() };
    }

    private string? _failure;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var completion = await Authorizer.CompleteAsync(NavigationManager.Uri);
            // The frame of the Bundle Visualizer returns to itself (the SDK shows its Bundle again), whatever patient the launch chose
            var bundleFrame = completion.ReturnUrl.TrimStart('/').StartsWith(BundleEmbedPage.Route, StringComparison.OrdinalIgnoreCase);
            var target = completion.PatientId is { Length: > 0 } patient && !bundleFrame
                ? EmbedPage.Prefix + new ViewerRoute(ViewerPage.Summary, "Patient", patient).Location
                : completion.ReturnUrl.TrimStart('/');
            NavigationManager.NavigateTo(target, replace: true);
        }
        catch (SmartException ex)
        {
            _failure = ex.Failure.ToMessage();
        }
    }

}
