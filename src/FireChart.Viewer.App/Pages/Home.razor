@using BlazorBlueprint.Components
@page "/"
@using System.Text.Json
@using System.Text.Json.Nodes
@using FireChart.Viewer.App.Sandbox
@implements IAsyncDisposable
@inject DemoPresets Presets
@inject IJSRuntime JS

@* The sandbox: the Viewer of /embed in a frame, driven by the messages a host sends (init, update, restart, navigate), public servers in one click.
   The page opens empty: the frame (a second .NET runtime) is created when a server is chosen *@
<PageTitle>FireChart Viewer: sandbox</PageTitle>

<div class="p-4">
    <div class="grid grid-cols-12 gap-4">
        <div class="col-span-12 xl:col-span-4">
            <div class="flex flex-col gap-3">
                <h5 class="m-0 text-base font-semibold">FireChart Viewer</h5>
                <Alert Kind="AlertKind.Info" data-sandbox="public-servers">
                    Public test servers with synthetic data. Do not upload real patient data to them.
                </Alert>

                <FormField Text="Server">
                    <BbSelect TValue="string" Options=@PresetOptions Value=@_presetId Placeholder="Select a server" AriaLabel="Server"
                              ValueChanged=@((string? id) => SelectPresetAsync(id)) data-sandbox="preset"/>
                </FormField>
                @if (Selected is { } selected)
                {
                    <p class="m-0 text-sm">@selected.Description</p>
                }

                <div class="flex items-end flex-wrap gap-3">
                    <FormField Text="Theme" Class="w-auto">
                        <BbToggleGroup TValue="string" Value=@_theme ValueChanged=@((string? theme) => SetThemeAsync(theme!)) Variant="ToggleVariant.Outline" Size="ToggleSize.Small"
                                       Required="true" data-sandbox="theme">
                            <BbToggleGroupItem TValue="string" Value=@("light")>Light</BbToggleGroupItem>
                            <BbToggleGroupItem TValue="string" Value=@("dark")>Dark</BbToggleGroupItem>
                            <BbToggleGroupItem TValue="string" Value=@("auto")>Auto</BbToggleGroupItem>
                        </BbToggleGroup>
                    </FormField>
                    <FormField Text="Style" Class="w-auto">
                        <BbToggleGroup TValue="string" Value=@_style ValueChanged=@((string? style) => SetStyleAsync(style ?? string.Empty)) Variant="ToggleVariant.Outline"
                                       Size="ToggleSize.Small" Required="true" data-sandbox="style">
                            <BbToggleGroupItem TValue="string" Value=@(string.Empty)>Vendor</BbToggleGroupItem>
                            <BbToggleGroupItem TValue="string" Value=@("fluent")>Fluent</BbToggleGroupItem>
                            <BbToggleGroupItem TValue="string" Value=@("compact")>Compact</BbToggleGroupItem>
                        </BbToggleGroup>
                    </FormField>
                    <FormField Text="Language" Class="w-40">
                        <BbSelect TValue="string" Options=@s_locales.Select(SelectOption.FromValue) Value=@_locale ValueChanged=@((string? locale) => SetLocaleAsync(locale!))
                                  AriaLabel="Language" data-sandbox="locale"/>
                    </FormField>
                    @if (Selected?.Patient is { } patient)
                    {
                        <Button Variant="ButtonVariant.Outline" OnClick=@(() => NavigateAsync(new ViewerRoute(ViewerPage.Summary, "Patient", patient).Location)) data-sandbox="patient" IconName="person" Text="Patient summary"/>
                    }
                </div>

                <FormField Text="Configuration (viewer.json)" For="sandbox-editor">
                    <BbTextarea Id="sandbox-editor" @bind-Value=@_editor rows="18" spellcheck="false" Class="min-h-80 font-mono text-[0.8125rem]" data-sandbox="editor"/>
                </FormField>
                <div class="flex gap-2">
                    <Button OnClick=@ApplyAsync data-sandbox="apply" IconName="restart_alt" Text="Apply (restart)"/>
                    @if (Selected is not null)
                    {
                        <Button Variant="ButtonVariant.Outline" OnClick=@(() => SelectPresetAsync(Selected.Id))>Reset</Button>
                    }
                </div>
                @if (_errors.Count > 0)
                {
                    <Alert Kind="AlertKind.Danger" data-sandbox="errors">
                        <ul class="m-0 ps-4">
                            @foreach (var error in _errors)
                            {
                                <li><code>@error.Param</code> (@error.Code): @error.Message</li>
                            }
                        </ul>
                    </Alert>
                }
            </div>
        </div>

        <div class="col-span-12 xl:col-span-8">
            <div class="flex flex-col gap-3">
                <div @ref=@_frameHost>
                    @if (_applied is not null)
                    {
                        <iframe src="embed?host=parent" title="FireChart Viewer" class="h-[75vh] min-h-[480px] w-full rounded-lg border border-line bg-surface" data-sandbox="frame"></iframe>
                    }
                    else
                    {
                        <div class="flex h-[75vh] min-h-[480px] w-full items-center justify-center rounded-lg border border-line bg-surface p-4 text-center text-muted" data-sandbox="empty">
                            <p class="m-0 text-base">Select a server, or write a configuration and apply it.</p>
                        </div>
                    }
                </div>
                <BbTabs DefaultValue="events">
                    <BbTabsList>
                        <BbTabsTrigger Value="events">@($"Events ({_events.Count})")</BbTabsTrigger>
                        <BbTabsTrigger Value="code">Code</BbTabsTrigger>
                    </BbTabsList>
                        <BbTabsContent Value="events">
                            <div class="max-h-72 overflow-auto text-[0.8125rem]" data-sandbox="events">
                                @if (_events.Count == 0)
                                {
                                    <p class="m-0 text-sm">The messages between the sandbox and the frame appear here.</p>
                                }
                                @foreach (var entry in _events)
                                {
                                    <div class="flex items-baseline gap-2 border-b border-line py-0.5">
                                        <span class="text-subtle">@entry.Time.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</span>
                                        <span>@(entry.Sent ? "→" : "←")</span>
                                        <strong>@entry.Type</strong>
                                        <code class="wrap-anywhere">@entry.Payload</code>
                                    </div>
                                }
                            </div>
                            @if (_events.Count > 0)
                            {
                                <Button Variant="ButtonVariant.Outline" OnClick=@(() => _events.Clear())>Clear</Button>
                            }
                        </BbTabsContent>
                        <BbTabsContent Value="code">
                            <div class="flex flex-col gap-4" data-sandbox="code">
                                @foreach (var snippet in _snippets)
                                {
                                    <div class="flex flex-col gap-1">
                                        <div class="flex items-center justify-between gap-4">
                                            <h6 class="m-0 text-sm font-medium">@snippet.Title</h6>
                                            <Button Variant="ButtonVariant.Outline" OnClick=@(() => CopyAsync(snippet.Code)) IconName="content_copy" Text="Copy"/>
                                        </div>
                                        <pre class="m-0 max-h-96 overflow-auto rounded-md bg-hover p-3 text-[0.8125rem]"><code>@snippet.Code</code></pre>
                                    </div>
                                }
                            </div>
                        </BbTabsContent>
                </BbTabs>
            </div>
        </div>
    </div>
</div>

@code {

    private const int MaxEvents = 200;

    private static readonly JsonSerializerOptions s_indented = new() { WriteIndented = true };
    private static readonly string[] s_locales = ["auto", .. ViewerAppConfigLoader.Locales];

    private readonly Dictionary<string, PresetAvailability> _availability = new(StringComparer.Ordinal);
    private readonly List<SandboxEvent> _events = [];
    private readonly CancellationTokenSource _closing = new();
    private IReadOnlyList<DemoPreset> _presets = [];
    private IReadOnlyList<CodeSnippet> _snippets = [];
    private List<ViewerConfigError> _errors = [];
    private string? _presetId;
    private string _editor = string.Empty;
    private JsonObject? _applied;
    private string _theme = "auto";
    private string _style = string.Empty;
    private string _locale = "auto";
    private ElementReference _frameHost;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Home>? _self;

    private DemoPreset? Selected => _presets.FirstOrDefault(p => p.Id == _presetId);

    // The servers of the list; one that does not answer says so
    private IEnumerable<SelectOption<string>> PresetOptions =>
        _presets.Select(preset => new SelectOption<string>(preset.Id, Availability(preset) == PresetAvailability.Unavailable ? $"{preset.Name} (not reachable)" : preset.Name));

    protected override async Task OnInitializedAsync()
    {
        _presets = await Presets.LoadAsync(_closing.Token);
        foreach (var preset in _presets)
        {
            _availability[preset.Id] = PresetAvailability.Checking;
            _ = CheckAsync(preset);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.ImportModuleAsync("./js/sandbox.js");
            await _module.InvokeVoidAsync("attach", _frameHost, _self);
        }
    }

    // The frame says hello when it has loaded (also after the way back of a SMART redirect): it gets the configuration applied here
    [JSInvokable]
    public Task OnFrameMessage(string type, string payload)
    {
        // The frame of the sandbox fills its box: its height is not news
        if (type == "resize")
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(async () =>
        {
            Log(false, type, payload);
            if (type == "hello" && _applied is not null)
            {
                await SendAsync("init", new JsonObject { ["config"] = _applied.DeepClone() });
            }

            StateHasChanged();
        });
    }

    private async Task CheckAsync(DemoPreset preset)
    {
        var availability = await Presets.CheckAsync(preset, _closing.Token);
        _availability[preset.Id] = availability;
        await InvokeAsync(StateHasChanged);
    }

    private PresetAvailability Availability(DemoPreset preset)
    {
        return _availability.GetValueOrDefault(preset.Id, PresetAvailability.Checking);
    }

    private async Task SelectPresetAsync(string? id)
    {
        _presetId = id;
        if (Selected is { } preset)
        {
            _editor = preset.Config.ToJsonString(s_indented);
            await ApplyAsync();
            return;
        }

        // No server: the frame goes, and its runtime with it
        _applied = null;
        _editor = string.Empty;
        _snippets = [];
        _errors = [];
    }

    private async Task ApplyAsync()
    {
        JsonObject config;
        try
        {
            config = JsonNode.Parse(_editor, documentOptions: new JsonDocumentOptions { CommentHandling = JsonCommentHandling.Skip, AllowTrailingCommas = true }) as JsonObject
                     ?? throw new JsonException();
        }
        catch (JsonException)
        {
            _errors = [new ViewerConfigError("invalid_value", "$", "The configuration is not a well formed JSON object.")];
            return;
        }

        var setup = ViewerAppConfigLoader.Parse(config.ToJsonString());
        _errors = [.. setup.Errors];
        if (setup.Server is null)
        {
            return;
        }

        var frameShown = _applied is not null;
        _applied = config;
        _theme = config["appearance"]?["theme"]?.GetValue<string>() ?? "auto";
        _style = config["appearance"]?["style"]?.GetValue<string>() ?? string.Empty;
        _locale = config["locale"]?.GetValue<string>() ?? "auto";
        _snippets = CodeSnippets.Build(config);
        // A new frame says hello and gets the configuration by init
        if (frameShown)
        {
            await SendAsync("restart", new JsonObject { ["config"] = config.DeepClone() });
        }
    }

    private Task SetThemeAsync(string theme)
    {
        _theme = theme;
        return UpdateAsync(new JsonObject { ["appearance"] = new JsonObject { ["theme"] = theme } });
    }

    // A theme of the library (styles/themes); "" is the vendor look
    private Task SetStyleAsync(string style)
    {
        _style = style;
        return UpdateAsync(new JsonObject { ["appearance"] = new JsonObject { ["style"] = style.Length == 0 ? null : style } });
    }

    private Task SetLocaleAsync(string locale)
    {
        _locale = locale;
        return UpdateAsync(new JsonObject { ["locale"] = locale });
    }

    // An option that changes live: the frame merges it into its configuration, the editor and the code follow
    private async Task UpdateAsync(JsonObject patch)
    {
        if (_applied is null)
        {
            return;
        }

        ViewerConfigPatch.Merge(_applied, patch);
        _editor = _applied.ToJsonString(s_indented);
        _snippets = CodeSnippets.Build(_applied);
        await SendAsync("update", new JsonObject { ["config"] = patch });
    }

    private Task NavigateAsync(string location)
    {
        return SendAsync("navigate", new JsonObject { ["location"] = location });
    }

    private async Task SendAsync(string type, JsonObject payload)
    {
        var text = payload.ToJsonString();
        Log(true, type, text);
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("send", type, text);
        }
    }

    private async Task CopyAsync(string code)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("copy", code);
        }
    }

    private void Log(bool sent, string type, string payload)
    {
        _events.Insert(0, new SandboxEvent(TimeProvider.System.GetLocalNow(), sent, type, payload == "{}" ? string.Empty : payload));
        if (_events.Count > MaxEvents)
        {
            _events.RemoveAt(_events.Count - 1);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _closing.CancelAsync();
        _closing.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // the page is gone
            }
        }

        _self?.Dispose();
    }

    private sealed record SandboxEvent(DateTimeOffset Time, bool Sent, string Type, string Payload);

}
