<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SQLite of the browser (flox-sqlite.js, the worker, sqlite-wasm) in a real browser through Playwright: several tabs of one pool under load.
       Explicit: they need Chrome or Edge on the machine (FLOX_BROWSER_CHANNEL picks one), so ci.sh unit does not run them -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <!-- The page of the tests and the static files of Flox.Sqlite as the browser gets them -->
  <ItemGroup>
    <Content Include="..\..\src\Flox.Sqlite\wwwroot\**" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
