<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The tests of the Viewer: they reference only the public projects (the engine, the vendor library, the component) -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FireChart.Viewer\FireChart.Viewer.csproj" />
    <ProjectReference Include="..\..\src\FireChart.Viewer.Core\FireChart.Viewer.Core.csproj" />
    <ProjectReference Include="..\..\src\FireChart.Viewer.Library\FireChart.Viewer.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="FireChart.Viewer.Core" />
    <Using Include="FireChart.Viewer.Core.Forms" />
    <Using Include="FireChart.Viewer.Core.Fhir" />
    <Using Include="FireChart.Viewer.Core.Search" />
  </ItemGroup>

</Project>
