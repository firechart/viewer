<Project>
  <!-- The versions of the packages of the public part (public/), the one source of them: the root Directory.Packages.props imports this file
       and adds the packages of the closed projects. The entries that no project references directly pin transitive packages -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.10.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Duende.IdentityModel.OidcClient" Version="7.1.1" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Fluid.Core" Version="2.31.0" />
    <PackageVersion Include="Hl7.Fhir.R4" Version="6.8.0" />
    <PackageVersion Include="Hl7.Fhir.R4B" Version="6.8.0" />
    <PackageVersion Include="Hl7.Fhir.R5" Version="6.8.0" />
    <PackageVersion Include="Hl7.Fhir.R6" Version="6.8.0" />
    <PackageVersion Include="Hl7.Fhir.STU3" Version="6.8.0" />
    <PackageVersion Include="IDisposableAnalyzers" Version="4.0.8" />
    <PackageVersion Include="Lombiq.Tailwind.Targets" Version="1.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.14" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="Radzen.Blazor" Version="12.2.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.BrowserConsole" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="SerilogAnalyzer" Version="0.15.0" />
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.4" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeCoverage" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
  </ItemGroup>
</Project>
