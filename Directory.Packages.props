<Project>
  <!-- The versions of the packages, the one source of them; the entries that no project references directly pin transitive packages -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.10.3" />
    <PackageVersion Include="BlazorBlueprint.Components" Version="4.2.0" />
    <PackageVersion Include="BlazorBlueprint.Icons.Lucide" Version="2.0.2" />
    <PackageVersion Include="BlazorBlueprint.Primitives" Version="4.2.0" />
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Duende.IdentityModel" Version="8.1.0" />
    <PackageVersion Include="Duende.IdentityModel.OidcClient" Version="7.1.1" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Hl7.Fhir.R4" Version="6.9.0" />
    <PackageVersion Include="Hl7.Fhir.R4B" Version="6.9.0" />
    <PackageVersion Include="Hl7.Fhir.R5" Version="6.9.0" />
    <PackageVersion Include="Hl7.Fhir.R6" Version="6.9.0" />
    <PackageVersion Include="Hl7.Fhir.STU3" Version="6.9.0" />
    <PackageVersion Include="IDisposableAnalyzers" Version="4.0.8" />
    <PackageVersion Include="Lombiq.Tailwind.Targets" Version="1.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="11.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.JSInterop" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="11.0.0" />
    <PackageVersion Include="Serilog.Sinks.BrowserConsole" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="SerilogAnalyzer" Version="0.15.0" />
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.4" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0" />
  </ItemGroup>
</Project>
