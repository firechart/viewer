<Project>

    <!-- The build settings of the public part and of the whole repository: the root Directory.Build.props imports this file and adds the
         settings of the closed projects. MSBuild takes the nearest Directory.Build.props only, so this file must stand on its own -->
    <Import Project="version.props"/>

    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsNotAsErrors>NU1902;NU1903</WarningsNotAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Dmitry Baranov</Authors>
        <Company>Dmitry Baranov</Company>
        <Copyright>Copyright © $(Company) $([System.DateTime]::Now.Year)</Copyright>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/firechart/viewer</PackageProjectUrl>
        <RepositoryUrl>https://github.com/firechart/viewer.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>false</PublishRepositoryUrl>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <EnableSourceLink>false</EnableSourceLink>
        <IncludeSymbols>false</IncludeSymbols>
    </PropertyGroup>

    <!-- Lombiq.Tailwind.Targets reads these before the project body, so they cannot be set in a csproj.
         Convention: a project with Assets/Styles/site.css gets wwwroot/css/<Project>.Tailwind.css (_content/<Project>/css/<Project>.Tailwind.css);
         the name is unique, since projects that reference each other would publish equal paths. -->
    <PropertyGroup>
        <TailwindOutput>wwwroot/css/$(MSBuildProjectName).Tailwind.css</TailwindOutput>
        <TailwindCliCacheDirectory>$(MSBuildThisFileDirectory).tailwind</TailwindCliCacheDirectory>
        <TailwindMinify>true</TailwindMinify>
    </PropertyGroup>

    <!-- MinVer computes $(Version) from git tags/commit history at build time - see version.props
         for MinVer's own settings and Directory.Build.targets for why $(MinVerVersion), not
         $(Version), gets re-read late for MAUI targets. Applies to every project automatically. -->
    <ItemGroup>
        <PackageReference Include="MinVer" PrivateAssets="All"/>
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="All"/>
        <PackageReference Include="IDisposableAnalyzers" PrivateAssets="All"/>
        <PackageReference Include="SerilogAnalyzer" PrivateAssets="All"/>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt"/>
    </ItemGroup>
</Project>
