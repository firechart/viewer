<Project>

    <!-- The build settings of every project of this repository -->
    <!-- The version of the release is the file VERSION, written with each release; no git history is needed for it -->
    <PropertyGroup>
        <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    </PropertyGroup>

    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- The analyzers of Blazor new in .NET 11: BL0011, BL0012 and BL0013 are errors. BL0016 (JS interop without try/catch) is off: it
             guards Blazor Server (a lost circuit) and prerendering, and the Viewer runs in WebAssembly without prerendering, where a failed
             call reaches its caller. An .editorconfig does not reach them: Razor's generated code lies outside the repository -->
        <WarningsNotAsErrors>NU1902;NU1903</WarningsNotAsErrors>
        <NoWarn>$(NoWarn);BL0016</NoWarn>
    </PropertyGroup>

    <!-- XML docs of the libraries (thorough in FireChart.Viewer*, brief in the others), checked in Release only, where a public member without
         docs is a build error; Debug stays fast. Not the application, the tool or the tests -->
    <PropertyGroup>
        <DocumentedLibraries>;Flox.Core;Flox.Resources;Flox.Shared;Flox.Sqlite;Flox.Sqlite.Files;Flox.Licensing;FireChart.Resources;FireChart.Viewer;FireChart.Viewer.Core;FireChart.Viewer.Library;</DocumentedLibraries>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release' and $(DocumentedLibraries.Contains(';$(MSBuildProjectName);'))">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Dmitry Baranov</Authors>
        <Company>Dmitry Baranov</Company>
        <Copyright>Copyright © $(Company) $([System.DateTime]::Now.Year)</Copyright>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/firechart/viewer</PackageProjectUrl>
        <RepositoryUrl>https://github.com/firechart/viewer.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <IsPackable>false</IsPackable>
        <PublishRepositoryUrl>false</PublishRepositoryUrl>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <EnableSourceLink>false</EnableSourceLink>
        <IncludeSymbols>false</IncludeSymbols>
    </PropertyGroup>

    <!-- Lombiq.Tailwind.Targets reads these before the project body, so they cannot be set in a csproj.
         Convention: a project with Assets/Styles/site.css gets wwwroot/css/<Project>.Tailwind.css (_content/<Project>/css/<Project>.Tailwind.css);
         the name is unique, since projects that reference each other would publish equal paths. -->
    <PropertyGroup>
        <TailwindOutput>wwwroot/css/$(MSBuildProjectName).Tailwind.css</TailwindOutput>
        <TailwindCliCacheDirectory>$(MSBuildThisFileDirectory).tailwind</TailwindCliCacheDirectory>
        <TailwindMinify>true</TailwindMinify>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="All"/>
        <PackageReference Include="IDisposableAnalyzers" PrivateAssets="All"/>
        <PackageReference Include="SerilogAnalyzer" PrivateAssets="All"/>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt"/>
    </ItemGroup>
</Project>
